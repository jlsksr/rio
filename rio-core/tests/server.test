# Integration test for the socket transport (rio::server) — a real client over a
# real socket, proving the SAME dispatch serves server mode (D2): response to the
# requester, buffer.changed broadcast, and a follow-up read reflecting the edit.
package require tcltest
namespace import ::tcltest::*
package require json

source [file join [file dirname [info script]] .. server.tcl]

test server-socket-roundtrip {edit then read over a socket; event is broadcast} -setup {
	set ::port [rio::server::listen 0]
	set ::buf  [rio::doc::new "" socktest]
	set ::lines {}
	set ::c [socket 127.0.0.1 $::port]
	fconfigure $::c -buffering line -blocking 0 -translation lf -encoding utf-8
	proc ::collect {chan} {
		if {[gets $chan line] >= 0 && [string trim $line] ne ""} {
			lappend ::lines $line
			# stop once the final read's reply has arrived
			set d [json::json2dict $line]
			if {[dict exists $d id] && [dict get $d id] eq "final"} { set ::done 1 }
		}
	}
	fileevent $::c readable [list ::collect $::c]
} -body {
	puts $::c "{\"id\":\"1\",\"op\":\"buffer.replace\",\"params\":{\"buffer\":\"$::buf\",\"start\":\"1.0\",\"end\":\"1.0\",\"text\":\"hi\"}}"
	puts $::c "{\"id\":\"final\",\"op\":\"buffer.text\",\"params\":{\"buffer\":\"$::buf\"}}"
	flush $::c
	after 3000 {set ::done timeout}
	vwait ::done
	if {$::done eq "timeout"} { return "TIMEOUT after [llength $::lines] line(s): $::lines" }

	# classify what came back
	set sawEvent 0 ; set replaceOk 0 ; set finalText {}
	foreach l $::lines {
		set d [json::json2dict $l]
		if {[dict exists $d event] && [dict get $d event] eq "buffer.changed"} {
			if {[dict get $d params text] eq "hi"} { set sawEvent 1 }
		} elseif {[dict exists $d id] && [dict get $d id] eq "1"} {
			set replaceOk [dict get $d ok]
		} elseif {[dict exists $d id] && [dict get $d id] eq "final"} {
			set finalText [dict get $d result text]
		}
	}
	list ok=$replaceOk event=$sawEvent text=$finalText
} -cleanup {
	catch {close $::c}
	rename ::collect {}
} -result {ok=true event=1 text=hi}

test server-bad-json {a malformed line gets an error response, no crash} -setup {
	set ::port2 [rio::server::listen 0]
	set ::reply {}
	set ::c2 [socket 127.0.0.1 $::port2]
	fconfigure $::c2 -buffering line -blocking 0 -translation lf
	fileevent $::c2 readable {
		if {[gets $::c2 line] >= 0 && [string trim $line] ne ""} {
			set ::reply $line ; set ::done2 1
		}
	}
} -body {
	puts $::c2 "this is not json"
	flush $::c2
	after 3000 {set ::done2 timeout}
	vwait ::done2
	set d [json::json2dict $::reply]
	list [dict get $d ok] [dict get $d error code] [dict get $d error message]
} -cleanup {
	catch {close $::c2}
} -result {false bad_request {bad json}}

test server-buffer-list {buffer.list's array result crosses the socket intact} -setup {
	set ::port3 [rio::server::listen 0]
	rio::doc::new "one\ntwo" srvlist
	set ::reply3 {}
	set ::c3 [socket 127.0.0.1 $::port3]
	fconfigure $::c3 -buffering line -blocking 0 -translation lf -encoding utf-8
	fileevent $::c3 readable {
		if {[gets $::c3 line] >= 0 && [string trim $line] ne ""} {
			set ::reply3 $line ; set ::done3 1
		}
	}
} -body {
	puts $::c3 "{\"id\":\"L\",\"op\":\"buffer.list\"}"
	flush $::c3
	after 3000 {set ::done3 timeout}
	vwait ::done3
	if {$::done3 eq "timeout"} { return TIMEOUT }
	set d [json::json2dict $::reply3]
	set names {}
	foreach e [dict get $d result buffers] { lappend names [dict get $e name] }
	list [dict get $d ok] [expr {"srvlist" in $names}]
} -cleanup {
	catch {close $::c3}
} -result {true 1}

test server-session-hello {session.hello negotiation crosses the socket} -setup {
	set ::port4 [rio::server::listen 0]
	set ::reply4 {}
	set ::c4 [socket 127.0.0.1 $::port4]
	fconfigure $::c4 -buffering line -blocking 0 -translation lf -encoding utf-8
	fileevent $::c4 readable {
		if {[gets $::c4 line] >= 0 && [string trim $line] ne ""} {
			set ::reply4 $line ; set ::done4 1
		}
	}
} -body {
	puts $::c4 "{\"id\":\"H\",\"op\":\"session.hello\"}"
	flush $::c4
	after 3000 {set ::done4 timeout}
	vwait ::done4
	if {$::done4 eq "timeout"} { return TIMEOUT }
	set d [json::json2dict $::reply4]
	list [dict get $d ok] [dict get $d result name] \
		[expr {"session.hello" in [dict get $d result ops]}]
} -cleanup {
	catch {close $::c4}
} -result {true rio-core 1}

test server-theme-get {theme.get's nested object crosses the socket intact} -setup {
	set ::port5 [rio::server::listen 0]
	set ::reply5 {}
	set ::c5 [socket 127.0.0.1 $::port5]
	fconfigure $::c5 -buffering line -blocking 0 -translation lf -encoding utf-8
	fileevent $::c5 readable {
		if {[gets $::c5 line] >= 0 && [string trim $line] ne ""} {
			set ::reply5 $line ; set ::done5 1
		}
	}
} -body {
	puts $::c5 "{\"id\":\"T\",\"op\":\"theme.get\"}"
	flush $::c5
	after 3000 {set ::done5 timeout}
	vwait ::done5
	if {$::done5 eq "timeout"} { return TIMEOUT }
	set d [json::json2dict $::reply5]
	list [dict get $d ok] [dict get $d result colors editor.bg] \
		[dict get $d result fonts RioEditorFont family]
} -cleanup {
	catch {close $::c5}
} -result {true white monospace}

cleanupTests
