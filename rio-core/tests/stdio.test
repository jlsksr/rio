# Integration test for the stdio transport (rio::server --stdio, AGENTS.md D30): a
# real child core at the far end of a pipe — request on stdin, response + broadcast
# event on stdout — proving the SAME dispatch serves the pipe transport the frontend
# spawns. Closing the pipe (EOF on the child's stdin) makes the child exit.
package require tcltest
namespace import ::tcltest::*
package require json

set ::serverTcl [file normalize [file join [file dirname [info script]] .. server.tcl]]

# Spawn a private core over a pipe; stderr (the banner) discarded so only the
# protocol stream reaches us.
proc spawn_core {} {
	set cmd [list [info nameofexecutable] $::serverTcl --stdio]
	# The bit bucket is spelled NUL on Windows; "/dev/null" there is just a path
	# that cannot be created, and the open fails before the core ever starts.
	set nul [expr {$::tcl_platform(platform) eq "windows" ? "NUL" : "/dev/null"}]
	set c [open "| $cmd 2>$nul" r+]
	fconfigure $c -buffering line -blocking 0 -translation lf -encoding utf-8
	return $c
}

test stdio-roundtrip {edit then read over a spawned-core pipe; event precedes reply} -setup {
	set ::c [spawn_core]
	set ::lines {}
	proc ::collect {chan} {
		if {[gets $chan line] >= 0} {
			if {[string trim $line] eq ""} return
			lappend ::lines $line
			set d [json::json2dict $line]
			if {[dict exists $d id] && [dict get $d id] eq "final"} { set ::done 1 }
		} elseif {[eof $chan]} { set ::done eof }
	}
	fileevent $::c readable [list ::collect $::c]
} -body {
	puts $::c {{"id":"1","op":"buffer.replace","params":{"start":"1.0","end":"1.0","text":"hi"}}}
	puts $::c {{"id":"final","op":"buffer.text"}}
	flush $::c
	after 5000 {set ::done timeout}
	vwait ::done
	if {$::done ne 1} { return "NOT-DONE($::done) after [llength $::lines] line(s): $::lines" }
	set sawEvent 0 ; set replaceOk 0 ; set finalText {}
	foreach l $::lines {
		set d [json::json2dict $l]
		if {[dict exists $d event] && [dict get $d event] eq "buffer.changed"} {
			if {[dict get $d params text] eq "hi"} { set sawEvent 1 }
		} elseif {[dict exists $d id] && [dict get $d id] eq "1"} {
			set replaceOk [dict get $d ok]
		} elseif {[dict exists $d id] && [dict get $d id] eq "final"} {
			set finalText [dict get $d result text]
		}
	}
	list ok=$replaceOk event=$sawEvent text=$finalText
} -cleanup {
	catch {close $::c}
	rename ::collect {}
} -result {ok=true event=1 text=hi}

test stdio-bad-json {a malformed line gets an error response, no crash} -setup {
	set ::c2 [spawn_core]
	set ::reply {}
	fileevent $::c2 readable {
		if {[gets $::c2 line] >= 0 && [string trim $line] ne ""} { set ::reply $line ; set ::done2 1 }
	}
} -body {
	puts $::c2 "this is not json" ; flush $::c2
	after 5000 {set ::done2 timeout}
	vwait ::done2
	if {$::done2 ne 1} { return TIMEOUT }
	set d [json::json2dict $::reply]
	list [dict get $d ok] [dict get $d error code]
} -cleanup {
	catch {close $::c2}
} -result {false bad_request}

test stdio-eof-exits {closing the pipe makes the child core exit cleanly} -setup {
	set ::c3 [spawn_core]
} -body {
	# A round-trip to be sure the child is up, then close our end: the child sees EOF
	# on stdin and exits 0, so close (which reaps it) must not raise.
	puts $::c3 {{"id":"h","op":"session.hello"}} ; flush $::c3
	fileevent $::c3 readable { if {[gets $::c3 l] >= 0 && [string trim $l] ne ""} { set ::done3 1 } }
	after 5000 {set ::done3 timeout}
	vwait ::done3
	set rc [catch {close $::c3} err]
	list up=$::done3 closed_rc=$rc
} -result {up=1 closed_rc=0}

cleanupTests
