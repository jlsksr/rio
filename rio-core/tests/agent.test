test agent-exec-prepare-timeout-clamp {timeout clamps to [1,600]; missing/invalid -> 120} -setup {
	set ::pdir [makeDirectory agxt] ; rio::project::open $::pdir
} -body {
	set hi [dict get [rio::agent::tools::prepare_exec [dict create command [list x] timeout 999]] timeout]
	set lo [dict get [rio::agent::tools::prepare_exec [dict create command [list x] timeout 0]] timeout]
	set df [dict get [rio::agent::tools::prepare_exec [dict create command [list x]]] timeout]
	list $hi $lo $df
} -cleanup { rio::project::close } -result {600 120 120}

test agent-exec-format-timeout {a timed-out result is ok 0 and names the timeout} -body {
	set r [rio::agent::tools::format_exec [list mycmd] \
		[dict create exitcode -1 stdout "" stderr "" timedout 1]]
	list [dict get $r ok] [dict get $r summary] [string match {*timeout*} [dict get $r content]]
} -result {0 {timed out: mycmd} 1}

test agent-exec-format-nonzero {a non-zero exit is a successful run whose code is data} -body {
	set r [rio::agent::tools::format_exec [list mycmd] \
		[dict create exitcode 2 stdout "out\n" stderr "err\n" timedout 0]]
	list [dict get $r ok] [dict get $r summary] [string match {*exit code: 2*} [dict get $r content]]
} -result {1 {ran mycmd -> exit 2} 1}

test agent-exec-run-command-registered {run_command is a registered exec-kind tool} -body {
	list [rio::agent::tools::kind_of run_command] [rio::agent::tools::is_gated run_command] \
		[expr {"run_command" in [dict keys [set ::rio::agent::tools::specs]]}]
} -result {exec 1 1}

# --- provider / key / policy control ops (D30) -------------------------------
# A frontend drives the agent over the channel: provider, key, and policy are ops,
# not in-process swaps. echo is built in; tests register a fake provider (and a
# fake key-holding one) so the registry is exercised without the claude plugin.

proc fake_provider {conversation tools system post} { {*}$post delta "fake reply" ; {*}$post done end_turn }
proc fakekey_set {k} { set ::fakekey $k }
proc fakekey_clear {} { set ::fakekey "" }
proc fakekey_status {} { expr {[info exists ::fakekey] && $::fakekey ne ""} }

test agent-provider-echo-registered {echo is in the registry from the start} -body {
	expr {"echo" in [rio::agent::provider_names]}
} -result 1

test agent-provider-set-by-name {agent.provider.set selects a registered provider and reports the live name} -setup {
	rio::agent::register_provider faked fake_provider
} -body {
	set r [dict get [rio::core::call agent.provider.set {name faked}] response]
	list [dict get $r ok] [dict get $r result name] [rio::agent::provider_name]
} -cleanup {
	rio::agent::use_provider echo
} -result {true faked faked}

test agent-provider-set-runs-it {a turn after agent.provider.set streams through the chosen provider} -setup {
	rio::agent::register_provider faked fake_provider
	rio::core::call agent.provider.set {name faked}
	rio::core::call agent.reset {}
} -body {
	# Drive the turn WITHOUT re-setting the provider, so it proves the op wired the
	# live command (not run_turn, which sets a provider of its own).
	set ::evs {} ; set ::fin {}
	rio::core::call_stream agent.send {text x} collect_ev
	set tm [after 3000 {set ::fin timeout}] ; vwait ::fin ; after cancel $tm
	set msg ""
	foreach ev $::evs {
		if {[dict get $ev event] eq "agent.message"} { set msg [dict get $ev params text] }
	}
	list $::fin $msg
} -cleanup { rio::agent::use_provider echo } -result {done {fake reply}}

test agent-provider-set-unknown {an unknown provider name is a bad_request} -body {
	set r [dict get [rio::core::call agent.provider.set {name nope}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test agent-provider-set-requires-name {agent.provider.set without a name is bad_request} -body {
	set r [dict get [rio::core::call agent.provider.set {}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test agent-autoaccept-op {agent.autoaccept.set toggles the approval gate} -setup {
	rio::agent::set_auto_accept 0
} -body {
	set on  [dict get [rio::core::call agent.autoaccept.set {on 1}] response result on]
	set v1  [rio::agent::auto_accept]
	set off [dict get [rio::core::call agent.autoaccept.set {on 0}] response result on]
	set v0  [rio::agent::auto_accept]
	list $on $v1 $off $v0
} -cleanup { rio::agent::set_auto_accept 0 } -result {1 1 0 0}

test agent-key-ops {agent.key.set/clear route to the named provider's store; status reflects them} -setup {
	unset -nocomplain ::fakekey
	rio::agent::register_provider fkeyed fake_provider \
		-key {set fakekey_set clear fakekey_clear status fakekey_status}
	rio::agent::use_provider fkeyed
} -body {
	# No name given -> targets the active provider (fkeyed), the common case; the
	# active provider's key presence is what agent.status.key_set reports.
	set s0 [dict get [rio::core::call agent.status {}] response result key_set]
	rio::core::call agent.key.set {key sk-test-123}
	set s1 [dict get [rio::core::call agent.status {}] response result key_set]
	set stored $::fakekey
	rio::core::call agent.key.clear {}
	set s2 [dict get [rio::core::call agent.status {}] response result key_set]
	list $s0 $s1 $stored $s2
} -cleanup { rio::agent::use_provider echo } -result {0 1 sk-test-123 0}

test agent-key-set-requires-key {agent.key.set without a key is bad_request} -body {
	set r [dict get [rio::core::call agent.key.set {}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

# The contract-hardening this milestone forced: two keyed providers coexist, each
# with its OWN key store, addressed by name (there is no single key-holder slot).
proc gkey_set {k} { set ::gkey $k }
proc gkey_clear {} { set ::gkey "" }
proc gkey_status {} { expr {[info exists ::gkey] && $::gkey ne ""} }

test agent-key-per-provider {two keyed providers keep independent keys, set by name} -setup {
	unset -nocomplain ::fakekey ::gkey
	rio::agent::register_provider fkeyed fake_provider \
		-key {set fakekey_set clear fakekey_clear status fakekey_status}
	rio::agent::register_provider gkeyed fake_provider \
		-key {set gkey_set clear gkey_clear status gkey_status}
} -body {
	rio::core::call agent.key.set {key aaa name fkeyed}
	rio::core::call agent.key.set {key bbb name gkeyed}
	# each store holds its own key; clearing one leaves the other
	set both [list [rio::agent::key_status fkeyed] [rio::agent::key_status gkeyed]]
	rio::core::call agent.key.clear {name fkeyed}
	set after [list [rio::agent::key_status fkeyed] [rio::agent::key_status gkeyed]]
	list $both [list $::fakekey $::gkey] $after
} -result {{1 1} {{} bbb} {0 1}}

test agent-providers-shape {agent.providers lists every provider with label/keyed/key_set/signup} -setup {
	unset -nocomplain ::fakekey
	rio::agent::register_provider fkeyed fake_provider -label "Fake Keyed" \
		-signup keys.example \
		-key {set fakekey_set clear fakekey_clear status fakekey_status}
	rio::core::call agent.key.set {key kkk name fkeyed}
} -body {
	set ps [dict get [rio::core::call agent.providers {}] response result providers]
	# find the two we care about
	set byname {}
	foreach p $ps { dict set byname [dict get $p name] $p }
	set echo [dict get $byname echo]
	set fk   [dict get $byname fkeyed]
	list [dict get $echo keyed] [dict get $fk label] [dict get $fk keyed] \
		[dict get $fk key_set] [dict get $fk signup]
} -cleanup { rio::core::call agent.key.clear {name fkeyed} } \
  -result {0 {Fake Keyed} 1 1 keys.example}

test agent-providers-wire {agent.providers encodes providers as an array of flat objects} -body {
	set result [dict create providers [list \
		[dict create name echo label Echo keyed 0 key_set 0 signup ""]]]
	set json [rio::wire::response [dict create id 4 ok true op agent.providers result $result]]
	set d [json::json2dict $json]
	set p0 [lindex [dict get $d result providers] 0]
	list [dict get $p0 name] [dict get $p0 label] [dict get $p0 keyed] \
		[dict get $p0 key_set] [dict get $p0 signup]
} -result {echo Echo 0 0 {}}

test agent-status-shape {agent.status reports provider, auto_accept and key_set} -setup {
	rio::agent::use_provider echo
	rio::agent::set_auto_accept 0
} -body {
	set r [dict get [rio::core::call agent.status {}] response result]
	list [dict get $r provider] [dict get $r auto_accept] [dict exists $r key_set]
} -result {echo 0 1}

test agent-control-ops-registered {the new control ops are in the live registry} -body {
	set ops [rio::dispatch::opnames]
	expr {"agent.provider.set" in $ops && "agent.key.set" in $ops \
		&& "agent.key.clear" in $ops && "agent.autoaccept.set" in $ops \
		&& "agent.status" in $ops && "agent.providers" in $ops}
} -result 1

# --- wire encoding (D11/D25) -------------------------------------------------

test agent-delta-wire {an agent.delta event encodes to JSON} -body {
	rio::wire::event [dict create event agent.delta \
		params [dict create turn 1 text "hi"]]
} -result {{"event":"agent.delta","params":{"turn":"1","text":"hi"}}}

test agent-history-wire {agent.history encodes messages as an array of objects} -body {
	set result [dict create messages [list \
		[dict create role user text hi] \
		[dict create role assistant text {echo: hi}]]]
	rio::wire::response [dict create id 3 ok true op agent.history result $result]
} -result {{"id":"3","ok":true,"result":{"messages":[{"role":"user","text":"hi"},{"role":"assistant","text":"echo: hi"}]}}}

cleanupTests
