# Tests for the agent orchestration loop (rio::agent, AGENTS.md D20/D26) and the
# agent.* ops driven through the in-process transport. agent.send is the core's
# first STREAMING op: content arrives as agent.* events over the event loop, not
# in the response — so these tests drive a real event loop (vwait) and collect
# the events live, exactly as a frontend would.
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. core.tcl]
source [file join [file dirname [info script]] .. wire.tcl]

# A live event sink (the streaming `emit`): records every event and trips ::fin
# when the turn ends (agent.message or agent.error).
proc collect_ev {ev} {
	lappend ::evs $ev
	switch -- [dict get $ev event] {
		agent.message - agent.error { set ::fin done }
	}
}

# Drive one agent turn to completion. Returns {resp <ack> evs <events> fin done}.
# A fresh provider is set each call (echo by default) so tests are independent.
proc run_turn {text {provider ::rio::agent::echo_provider}} {
	rio::agent::set_provider $provider
	set ::evs {} ; set ::fin {}
	set resp [rio::core::call_stream agent.send [dict create text $text] collect_ev]
	set timer [after 3000 {set ::fin timeout}]
	vwait ::fin
	after cancel $timer
	return [dict create resp $resp evs $::evs fin $::fin]
}

# A fake tool-using provider: on the first pass it asks to run buffer_list; once
# the loop feeds the tool_result back (the latest user message carries a
# tool_result block) it streams a final line and ends. Posts are synchronous —
# the loop's `post` bridge defers them, so the contract is exercised faithfully.
proc tool_provider {conversation tools system post} {
	set last [lindex $conversation end]
	set sawtool 0
	if {[dict exists $last content]} {
		foreach b [dict get $last content] {
			if {[dict get $b type] eq "tool_result"} { set sawtool 1 }
		}
	}
	if {$sawtool} {
		{*}$post delta "saw tools"
		{*}$post done end_turn
	} else {
		{*}$post tool t1 buffer_list {} {{}}
		{*}$post done tool_use
	}
}

# A fake write-using provider: first pass proposes the tool in ::wt_name/::wt_input/
# ::wt_raw; after the loop feeds a tool_result back, it finishes. Drives the
# approval gate (slice 5).
proc write_provider {conversation tools system post} {
	set last [lindex $conversation end]
	set sawtool 0
	if {[dict exists $last content]} {
		foreach b [dict get $last content] {
			if {[dict get $b type] eq "tool_result"} { set sawtool 1 }
		}
	}
	if {$sawtool} {
		{*}$post delta "done"
		{*}$post done end_turn
	} else {
		{*}$post tool w1 $::wt_name $::wt_input $::wt_raw
		{*}$post done tool_use
	}
}

# A sink that stops the event loop at the approval gate (agent.propose) or when the
# turn ends (agent.message/agent.error).
proc ev_until_stop {ev} {
	lappend ::evs $ev
	switch -- [dict get $ev event] {
		agent.propose               { set ::stop propose }
		agent.message - agent.error { set ::stop done }
	}
}
# Start a write turn; return why the loop stopped ("propose"|"done"|"timeout") and
# bind the turn id. Pumps a real event loop, as a frontend would.
proc start_write {turnVar} {
	upvar 1 $turnVar turn
	set ::evs {} ; set ::stop {}
	set ack [rio::core::call_stream agent.send {text go} ev_until_stop]
	set turn [dict get $ack result turn]
	set tm [after 3000 {set ::stop timeout}] ; vwait ::stop ; after cancel $tm
	return $::stop
}
proc wait_done {} {
	set ::stop {}
	set tm [after 3000 {set ::stop timeout}] ; vwait ::stop ; after cancel $tm
	return $::stop
}
# The latest agent.tool_result summary for tool id $id in ::evs.
proc ev_summary {id} {
	set s ""
	foreach ev $::evs {
		if {[dict get $ev event] eq "agent.tool_result" && [dict get $ev params id] eq $id} {
			set s [dict get $ev params summary]
		}
	}
	return $s
}

test agent-send-ack {agent.send returns an ack {started, turn} and completes} -body {
	set out [run_turn "hi there"]
	set r [dict get $out resp]
	list [dict get $r ok] [dict get $r result started] \
		[expr {[dict get $r result turn] > 0}] [dict get $out fin]
} -result {true true 1 done}

test agent-streams-to-message {deltas stream and accumulate into the final agent.message} -body {
	set out [run_turn "hi there"]
	set deltas "" ; set msg ""
	foreach ev [dict get $out evs] {
		switch -- [dict get $ev event] {
			agent.delta   { append deltas [dict get $ev params text] }
			agent.message { set msg [dict get $ev params text] }
		}
	}
	list $msg [expr {$deltas eq $msg}]
} -result {{echo: hi there} 1}

test agent-event-order {a turn is deltas (>=1) then exactly one agent.message} -body {
	set out [run_turn "alpha beta"]
	set kinds {}
	foreach ev [dict get $out evs] { lappend kinds [dict get $ev event] }
	set last [lindex $kinds end]
	list [expr {[llength $kinds] >= 2}] \
		[expr {"agent.delta" in $kinds}] \
		[expr {[llength [lsearch -all -exact $kinds agent.message]] == 1}] \
		$last
} -result {1 1 1 agent.message}

test agent-events-carry-turn {every event of a turn carries that turn's id} -body {
	set out [run_turn "x"]
	set turn [dict get $out resp result turn]
	set ok 1
	foreach ev [dict get $out evs] {
		if {[dict get $ev params turn] ne $turn} { set ok 0 }
	}
	set ok
} -result 1

test agent-send-is-async {content is streamed via the event loop, not delivered synchronously} -body {
	set ::evs {} ; set ::fin {}
	rio::agent::set_provider ::rio::agent::echo_provider
	rio::core::call_stream agent.send {text hi} collect_ev
	set immediate [llength $::evs]                ;# nothing yet — first chunk is deferred
	set timer [after 3000 {set ::fin timeout}]
	vwait ::fin
	after cancel $timer
	list $immediate [expr {[llength $::evs] > 0}] $::fin
} -result {0 1 done}

test agent-history-records-turn {history holds the user msg then the assistant reply} -setup {
	rio::core::call agent.reset {}
} -body {
	run_turn "hello"
	set msgs [dict get [rio::core::call agent.history {}] response result messages]
	list [llength $msgs] \
		[dict get [lindex $msgs 0] role] [dict get [lindex $msgs 0] text] \
		[dict get [lindex $msgs 1] role] [dict get [lindex $msgs 1] text]
} -result {2 user hello assistant {echo: hello}}

test agent-reset-clears {agent.reset empties the conversation} -setup {
	run_turn "something"
} -body {
	rio::core::call agent.reset {}
	llength [dict get [rio::core::call agent.history {}] response result messages]
} -result 0

test agent-send-requires-text {agent.send without text is bad_request, no turn started} -body {
	set r [rio::core::call_stream agent.send {} collect_ev]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test agent-error-from-provider {a provider failure surfaces as a classified agent.error} -setup {
	proc ::down_provider {conversation tools system post} { {*}$post error provider_down "boom" }
} -body {
	set out [run_turn "x" ::down_provider]
	set ev [lindex [dict get $out evs] end]
	list [dict get $out fin] [dict get $ev event] \
		[dict get $ev params code] [dict get $ev params message]
} -cleanup {
	rename ::down_provider {}
} -result {done agent.error provider_down boom}

test agent-ops-registered {agent.send/reset/history are in the live registry} -body {
	set ops [rio::dispatch::opnames]
	expr {"agent.send" in $ops && "agent.reset" in $ops && "agent.history" in $ops}
} -result 1

# --- tool round-trip (D26 slice 4) -------------------------------------------

test agent-tool-roundtrip {a tool_use turn runs the tool, feeds the result back, and finishes} -setup {
	rio::core::call agent.reset {}
} -body {
	set out [run_turn "list buffers" tool_provider]
	set tool {} ; set result {} ; set msg {}
	foreach ev [dict get $out evs] {
		switch -- [dict get $ev event] {
			agent.tool        { set tool [dict get $ev params name] }
			agent.tool_result { set result [list [dict get $ev params ok] [dict get $ev params name]] }
			agent.message     { set msg [dict get $ev params text] }
		}
	}
	list [dict get $out fin] $tool $result $msg
} -result {done buffer_list {1 buffer_list} {saw tools}}

test agent-tool-history-clean {history keeps the readable text turns, dropping tool machinery} -setup {
	rio::core::call agent.reset {}
} -body {
	run_turn "list buffers" tool_provider
	set msgs [dict get [rio::core::call agent.history {}] response result messages]
	set out {}
	foreach m $msgs { lappend out [dict get $m role] [dict get $m text] }
	set out
} -result {user {list buffers} assistant {saw tools}}

test agent-tool-confined {fs_read inside the project succeeds; an escaping path is refused unread} -setup {
	set ::pdir [makeDirectory agtool]
	makeFile "secret\n" inside.txt $::pdir
	rio::project::open $::pdir
} -body {
	set ok  [rio::agent::tools::run fs_read [dict create path inside.txt]]
	set bad [rio::agent::tools::run fs_read [dict create path /etc/hostname]]
	list [dict get $ok ok] [string trim [dict get $ok content]] \
		[dict get $bad ok] [string match {*outside the open project*} [dict get $bad content]]
} -cleanup {
	rio::project::close
} -result {1 secret 0 1}

test agent-tool-no-project {a path read with no project open names that reason, not "outside"} -setup {
	rio::project::close
} -body {
	set r [rio::agent::tools::run fs_read [dict create path AGENTS.md]]
	list [dict get $r ok] [dict get $r summary] \
		[string match {*No project is open*} [dict get $r content]]
} -result {0 {no project open} 1}

# --- write/propose-edit gate (D26 slice 5) -----------------------------------

test agent-write-approve {a proposed create applies on approval and the turn finishes} -setup {
	set ::pdir [makeDirectory agw]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_create
	set ::wt_input [dict create path new.txt content "hi\n"]
	set ::wt_raw {{"path":"new.txt","content":"hi\n"}}
} -body {
	set s1 [start_write turn]
	rio::core::call agent.approve [dict create turn $turn decision approve]
	set s2 [wait_done]
	set f [file join $::pdir new.txt]
	list $s1 $s2 [file exists $f] [string trim [dict get [rio::fs::read $f] text]] [ev_summary w1]
} -cleanup { rio::project::close } -result {propose done 1 hi {created new.txt}}

test agent-write-reject {a rejected proposal does not touch disk and feeds back "rejected"} -setup {
	set ::pdir [makeDirectory agwr]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_create
	set ::wt_input [dict create path no.txt content "x\n"]
	set ::wt_raw {{"path":"no.txt","content":"x\n"}}
} -body {
	set s1 [start_write turn]
	rio::core::call agent.approve [dict create turn $turn decision reject]
	set s2 [wait_done]
	list $s1 $s2 [file exists [file join $::pdir no.txt]] [ev_summary w1]
} -cleanup { rio::project::close } -result {propose done 0 {rejected by user}}

test agent-write-auto-accept {auto-accept applies without pausing for approval} -setup {
	set ::pdir [makeDirectory agwa]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 1
	set ::wt_name propose_create
	set ::wt_input [dict create path auto.txt content "a\n"]
	set ::wt_raw {{"path":"auto.txt","content":"a\n"}}
} -body {
	set out [run_turn "go" write_provider]
	list [dict get $out fin] [file exists [file join $::pdir auto.txt]]
} -cleanup { rio::agent::set_auto_accept 0 ; rio::project::close } -result {done 1}

test agent-approve-stale {approving a turn with nothing pending is a bad_request} -body {
	set r [dict get [rio::core::call agent.approve [dict create turn 999 decision approve]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test agent-edit-not-found {propose_edit whose old_string is absent is refused, unread} -setup {
	set ::pdir [makeDirectory agnf] ; makeFile "alpha\n" f.txt $::pdir
	rio::project::open $::pdir
} -body {
	set r [rio::agent::tools::prepare_write propose_edit \
		[dict create path f.txt old_string ZZZ new_string Q]]
	list [dict get $r ok] [dict get $r summary]
} -cleanup { rio::project::close } -result {0 {error: not found}}

# --- the approval gate against a moving target --------------------------------
# The editor stays live while a proposal awaits its decision, so the buffer can
# change between propose and approve. apply_write re-locates the match at apply
# time: a vanished match is refused (never applied at a stale position); a match
# that merely MOVED (an edit elsewhere) still applies at its new location.

test agent-write-stale-refused {approving after the matched text was edited away is refused} -setup {
	set ::pdir [makeDirectory agst]
	makeFile "alpha\nfoo\nbeta" f.txt $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path f.txt old_string foo new_string FOO]
	set ::wt_raw {{"path":"f.txt","old_string":"foo","new_string":"FOO"}}
	set ::bid [dict get [rio::core::call file.open \
		[dict create path [rio::project::resolve f.txt]]] response result buffer]
} -body {
	set s1 [start_write turn]
	# The user types while the Approve bar is up: foo becomes bar in the buffer.
	rio::core::call buffer.replace [dict create buffer $::bid start 2.0 end 2.3 text bar]
	rio::core::call agent.approve [dict create turn $turn decision approve]
	set s2 [wait_done]
	set buftext [dict get [rio::core::call buffer.text [dict create buffer $::bid]] response result text]
	list $s1 $s2 [ev_summary w1] [string match "*bar*" $buftext] [string match "*FOO*" $buftext]
} -cleanup {
	rio::core::call buffer.close [dict create buffer $::bid]
	rio::project::close
} -result {propose done {error: changed since proposal} 1 0}

test agent-write-moved-match {an edit elsewhere just moves the match; approval applies at the new spot} -setup {
	set ::pdir [makeDirectory agmv]
	makeFile "alpha\nfoo\nbeta" g.txt $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path g.txt old_string foo new_string FOO]
	set ::wt_raw {{"path":"g.txt","old_string":"foo","new_string":"FOO"}}
	set ::bid [dict get [rio::core::call file.open \
		[dict create path [rio::project::resolve g.txt]]] response result buffer]
} -body {
	set s1 [start_write turn]
	# A line inserted above shifts the match down one line before the approval.
	rio::core::call buffer.replace [dict create buffer $::bid start 1.0 end 1.0 text "top\n"]
	rio::core::call agent.approve [dict create turn $turn decision approve]
	set s2 [wait_done]
	# makeFile appends a newline, so the buffer's last line is empty.
	set buftext [dict get [rio::core::call buffer.text [dict create buffer $::bid]] response result text]
	list $s1 $s2 [ev_summary w1] $buftext
} -cleanup {
	rio::core::call buffer.close [dict create buffer $::bid]
	rio::project::close
} -result {propose done {edited g.txt (buffer+disk)} {top
alpha
FOO
beta
}}

test agent-create-appeared-refused {approving a create after the file appeared on disk is refused} -setup {
	set ::pdir [makeDirectory agca]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_create
	set ::wt_input [dict create path fresh.txt content "agent\n"]
	set ::wt_raw {{"path":"fresh.txt","content":"agent\n"}}
} -body {
	set s1 [start_write turn]
	makeFile "user got there first" fresh.txt $::pdir
	rio::core::call agent.approve [dict create turn $turn decision approve]
	set s2 [wait_done]
	list $s1 $s2 [string match "error: exists" [ev_summary w1]] \
		[string trim [dict get [rio::fs::read [file join $::pdir fresh.txt]] text]]
} -cleanup { rio::project::close } -result {propose done 1 {user got there first}}

test agent-create-emits-fs-changed {applying a create forwards fs.write's fs.changed event (D47)} -setup {
	set ::pdir [makeDirectory agce]
	rio::project::open $::pdir
} -body {
	set prep [rio::agent::tools::prepare_write propose_create \
		[dict create path birth.txt content "hi\n"]]
	set r [rio::agent::tools::apply_write [dict get $prep plan]]
	set ev [lindex [dict get $r events] 0]
	list [dict get $r ok] [dict get $ev event] \
		[expr {[dict get $ev params path] eq [file normalize [file join $::pdir birth.txt]]}]
} -cleanup { rio::project::close } -result {1 fs.changed 1}

test agent-edit-not-unique {propose_edit with a non-unique old_string is refused} -setup {
	set ::pdir [makeDirectory agnu] ; makeFile "x\nx\n" f.txt $::pdir
	rio::project::open $::pdir
} -body {
	set r [rio::agent::tools::prepare_write propose_edit \
		[dict create path f.txt old_string x new_string y]]
	list [dict get $r ok] [string match {*2 matches*} [dict get $r summary]]
} -cleanup { rio::project::close } -result {0 1}

# --- agent.proposal: the compare view's pull op (D28) ------------------------

test agent-proposal-pull {agent.proposal returns a pending proposal's original/proposed texts} -setup {
	set ::pdir [makeDirectory agpp]
	makeFile "alpha\nfoo\nbeta\n" f.txt $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path f.txt old_string foo new_string FOO]
	set ::wt_raw {{"path":"f.txt","old_string":"foo","new_string":"FOO"}}
} -body {
	set s1 [start_write turn]
	set res [dict get [rio::core::call agent.proposal [dict create turn $turn]] response result]
	rio::core::call agent.approve [dict create turn $turn decision reject]
	wait_done
	list $s1 [dict get $res name] [dict get $res path] \
		[expr {[dict get $res original] eq "alpha\nfoo\nbeta\n"}] \
		[expr {[dict get $res proposed] eq "alpha\nFOO\nbeta\n"}]
} -cleanup { rio::project::close } -result {propose propose_edit f.txt 1 1}

test agent-proposal-cleared {a resolved proposal is no longer pullable} -setup {
	set ::pdir [makeDirectory agpc]
	makeFile "x\n" g.txt $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path g.txt old_string x new_string y]
	set ::wt_raw {{"path":"g.txt","old_string":"x","new_string":"y"}}
} -body {
	set s1 [start_write turn]
	rio::core::call agent.approve [dict create turn $turn decision reject]
	wait_done
	set r [dict get [rio::core::call agent.proposal [dict create turn $turn]] response]
	list $s1 [dict get $r ok] [dict get $r error code]
} -cleanup { rio::project::close } -result {propose false bad_request}

# Every tool_use id in the conversation that has no following tool_result — the
# shape Claude rejects (HTTP 400). Must be empty before any provider request.
proc unanswered_tooluse {} {
	set open {}
	foreach m [set ::rio::agent::conversation] {
		foreach b [dict get $m content] {
			switch -- [dict get $b type] {
				tool_use    { dict set open [dict get $b id] 1 }
				tool_result { dict unset open [dict get $b tool_use_id] }
			}
		}
	}
	return [lsort [dict keys $open]]
}

test agent-send-seals-dangling-tooluse {a new turn after an undecided proposal seals the dangling tool_use} -setup {
	set ::pdir [makeDirectory agsd]
	makeFile "a\n" s.txt $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path s.txt old_string a new_string b]
	set ::wt_raw {{"path":"s.txt","old_string":"a","new_string":"b"}}
} -body {
	set s1 [start_write turn]                  ;# suspends at the gate — no decision
	set dangling_before [unanswered_tooluse]   ;# the proposed edit's tool_use is open
	set out [run_turn "never mind, hello"]     ;# send a new message instead of deciding
	# The dangling tool_use is now answered (folded into the new user turn), the new
	# turn completes, and the interrupted proposal is no longer pullable.
	set stale [dict get [rio::core::call agent.proposal [dict create turn $turn]] response]
	list $s1 [llength $dangling_before] [unanswered_tooluse] [dict get $out fin] \
		[dict get $stale ok] [dict get $stale error code]
} -cleanup { rio::project::close } -result {propose 1 {} done false bad_request}

test agent-seal-keeps-roles-alternating {the sealed tool_result rides in the new user turn, not a separate one} -setup {
	set ::pdir [makeDirectory agsr]
	makeFile "a\n" s.txt $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path s.txt old_string a new_string b]
	set ::wt_raw {{"path":"s.txt","old_string":"a","new_string":"b"}}
} -body {
	start_write turn
	run_turn "hello again"
	# Walk the conversation: no two consecutive same-role messages (Claude requires
	# strict alternation), and the user turn that follows the proposal carries both a
	# tool_result and the new text.
	set roles {} ; set sealed_turn_ok 0
	set prevtu 0
	foreach m [set ::rio::agent::conversation] {
		lappend roles [dict get $m role]
		set types {}
		foreach b [dict get $m content] { lappend types [dict get $b type] }
		if {$prevtu && [dict get $m role] eq "user" \
				&& "tool_result" in $types && "text" in $types} { set sealed_turn_ok 1 }
		set prevtu [expr {"tool_use" in $types}]
	}
	set alt 1
	for {set i 1} {$i < [llength $roles]} {incr i} {
		if {[lindex $roles $i] eq [lindex $roles [expr {$i-1}]]} { set alt 0 }
	}
	list $alt $sealed_turn_ok
} -cleanup { rio::project::close } -result {1 1}

test agent-proposal-stale {agent.proposal with nothing pending is a bad_request} -body {
	set r [dict get [rio::core::call agent.proposal [dict create turn 999]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

# --- provider / key / policy control ops (D30) -------------------------------
# A frontend drives the agent over the channel: provider, key, and policy are ops,
# not in-process swaps. echo is built in; tests register a fake provider (and a
# fake key-holding one) so the registry is exercised without the claude plugin.

proc fake_provider {conversation tools system post} { {*}$post delta "fake reply" ; {*}$post done end_turn }
proc fakekey_set {k} { set ::fakekey $k }
proc fakekey_clear {} { set ::fakekey "" }
proc fakekey_status {} { expr {[info exists ::fakekey] && $::fakekey ne ""} }

test agent-provider-echo-registered {echo is in the registry from the start} -body {
	expr {"echo" in [rio::agent::provider_names]}
} -result 1

test agent-provider-set-by-name {agent.provider.set selects a registered provider and reports the live name} -setup {
	rio::agent::register_provider faked fake_provider
} -body {
	set r [dict get [rio::core::call agent.provider.set {name faked}] response]
	list [dict get $r ok] [dict get $r result name] [rio::agent::provider_name]
} -cleanup {
	rio::agent::use_provider echo
} -result {true faked faked}

test agent-provider-set-runs-it {a turn after agent.provider.set streams through the chosen provider} -setup {
	rio::agent::register_provider faked fake_provider
	rio::core::call agent.provider.set {name faked}
	rio::core::call agent.reset {}
} -body {
	# Drive the turn WITHOUT re-setting the provider, so it proves the op wired the
	# live command (not run_turn, which sets a provider of its own).
	set ::evs {} ; set ::fin {}
	rio::core::call_stream agent.send {text x} collect_ev
	set tm [after 3000 {set ::fin timeout}] ; vwait ::fin ; after cancel $tm
	set msg ""
	foreach ev $::evs {
		if {[dict get $ev event] eq "agent.message"} { set msg [dict get $ev params text] }
	}
	list $::fin $msg
} -cleanup { rio::agent::use_provider echo } -result {done {fake reply}}

test agent-provider-set-unknown {an unknown provider name is a bad_request} -body {
	set r [dict get [rio::core::call agent.provider.set {name nope}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test agent-provider-set-requires-name {agent.provider.set without a name is bad_request} -body {
	set r [dict get [rio::core::call agent.provider.set {}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test agent-autoaccept-op {agent.autoaccept.set toggles the approval gate} -setup {
	rio::agent::set_auto_accept 0
} -body {
	set on  [dict get [rio::core::call agent.autoaccept.set {on 1}] response result on]
	set v1  [rio::agent::auto_accept]
	set off [dict get [rio::core::call agent.autoaccept.set {on 0}] response result on]
	set v0  [rio::agent::auto_accept]
	list $on $v1 $off $v0
} -cleanup { rio::agent::set_auto_accept 0 } -result {1 1 0 0}

test agent-key-ops {agent.key.set/clear route to the named provider's store; status reflects them} -setup {
	unset -nocomplain ::fakekey
	rio::agent::register_provider fkeyed fake_provider \
		-key {set fakekey_set clear fakekey_clear status fakekey_status}
	rio::agent::use_provider fkeyed
} -body {
	# No name given -> targets the active provider (fkeyed), the common case; the
	# active provider's key presence is what agent.status.key_set reports.
	set s0 [dict get [rio::core::call agent.status {}] response result key_set]
	rio::core::call agent.key.set {key sk-test-123}
	set s1 [dict get [rio::core::call agent.status {}] response result key_set]
	set stored $::fakekey
	rio::core::call agent.key.clear {}
	set s2 [dict get [rio::core::call agent.status {}] response result key_set]
	list $s0 $s1 $stored $s2
} -cleanup { rio::agent::use_provider echo } -result {0 1 sk-test-123 0}

test agent-key-set-requires-key {agent.key.set without a key is bad_request} -body {
	set r [dict get [rio::core::call agent.key.set {}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

# The contract-hardening this milestone forced: two keyed providers coexist, each
# with its OWN key store, addressed by name (there is no single key-holder slot).
proc gkey_set {k} { set ::gkey $k }
proc gkey_clear {} { set ::gkey "" }
proc gkey_status {} { expr {[info exists ::gkey] && $::gkey ne ""} }

test agent-key-per-provider {two keyed providers keep independent keys, set by name} -setup {
	unset -nocomplain ::fakekey ::gkey
	rio::agent::register_provider fkeyed fake_provider \
		-key {set fakekey_set clear fakekey_clear status fakekey_status}
	rio::agent::register_provider gkeyed fake_provider \
		-key {set gkey_set clear gkey_clear status gkey_status}
} -body {
	rio::core::call agent.key.set {key aaa name fkeyed}
	rio::core::call agent.key.set {key bbb name gkeyed}
	# each store holds its own key; clearing one leaves the other
	set both [list [rio::agent::key_status fkeyed] [rio::agent::key_status gkeyed]]
	rio::core::call agent.key.clear {name fkeyed}
	set after [list [rio::agent::key_status fkeyed] [rio::agent::key_status gkeyed]]
	list $both [list $::fakekey $::gkey] $after
} -result {{1 1} {{} bbb} {0 1}}

test agent-providers-shape {agent.providers lists every provider with label/keyed/key_set/signup} -setup {
	unset -nocomplain ::fakekey
	rio::agent::register_provider fkeyed fake_provider -label "Fake Keyed" \
		-signup keys.example \
		-key {set fakekey_set clear fakekey_clear status fakekey_status}
	rio::core::call agent.key.set {key kkk name fkeyed}
} -body {
	set ps [dict get [rio::core::call agent.providers {}] response result providers]
	# find the two we care about
	set byname {}
	foreach p $ps { dict set byname [dict get $p name] $p }
	set echo [dict get $byname echo]
	set fk   [dict get $byname fkeyed]
	list [dict get $echo keyed] [dict get $fk label] [dict get $fk keyed] \
		[dict get $fk key_set] [dict get $fk signup]
} -cleanup { rio::core::call agent.key.clear {name fkeyed} } \
  -result {0 {Fake Keyed} 1 1 keys.example}

test agent-providers-wire {agent.providers encodes providers as an array of flat objects} -body {
	set result [dict create providers [list \
		[dict create name echo label Echo keyed 0 key_set 0 signup ""]]]
	set json [rio::wire::response [dict create id 4 ok true op agent.providers result $result]]
	set d [json::json2dict $json]
	set p0 [lindex [dict get $d result providers] 0]
	list [dict get $p0 name] [dict get $p0 label] [dict get $p0 keyed] \
		[dict get $p0 key_set] [dict get $p0 signup]
} -result {echo Echo 0 0 {}}

test agent-status-shape {agent.status reports provider, auto_accept and key_set} -setup {
	rio::agent::use_provider echo
	rio::agent::set_auto_accept 0
} -body {
	set r [dict get [rio::core::call agent.status {}] response result]
	list [dict get $r provider] [dict get $r auto_accept] [dict exists $r key_set]
} -result {echo 0 1}

test agent-control-ops-registered {the new control ops are in the live registry} -body {
	set ops [rio::dispatch::opnames]
	expr {"agent.provider.set" in $ops && "agent.key.set" in $ops \
		&& "agent.key.clear" in $ops && "agent.autoaccept.set" in $ops \
		&& "agent.status" in $ops && "agent.providers" in $ops}
} -result 1

# --- wire encoding (D11/D25) -------------------------------------------------

test agent-delta-wire {an agent.delta event encodes to JSON} -body {
	rio::wire::event [dict create event agent.delta \
		params [dict create turn 1 text "hi"]]
} -result {{"event":"agent.delta","params":{"turn":"1","text":"hi"}}}

test agent-history-wire {agent.history encodes messages as an array of objects} -body {
	set result [dict create messages [list \
		[dict create role user text hi] \
		[dict create role assistant text {echo: hi}]]]
	rio::wire::response [dict create id 3 ok true op agent.history result $result]
} -result {{"id":"3","ok":true,"result":{"messages":[{"role":"user","text":"hi"},{"role":"assistant","text":"echo: hi"}]}}}

cleanupTests
