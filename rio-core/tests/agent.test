# Tests for the agent orchestration loop (rio::agent, AGENTS.md D20/D26) and the
# agent.* ops driven through the in-process transport. agent.send is the core's
# first STREAMING op: content arrives as agent.* events over the event loop, not
# in the response — so these tests drive a real event loop (vwait) and collect
# the events live, exactly as a frontend would.
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. core.tcl]
source [file join [file dirname [info script]] .. wire.tcl]

# A live event sink (the streaming `emit`): records every event and trips ::fin
# when the turn ends (agent.message or agent.error).
proc collect_ev {ev} {
	lappend ::evs $ev
	switch -- [dict get $ev event] {
		agent.message - agent.error { set ::fin done }
	}
}

# Drive one agent turn to completion. Returns {resp <ack> evs <events> fin done}.
# A fresh provider is set each call (echo by default) so tests are independent.
proc run_turn {text {provider ::rio::agent::echo_provider}} {
	rio::agent::set_provider $provider
	set ::evs {} ; set ::fin {}
	set resp [rio::core::call_stream agent.send [dict create text $text] collect_ev]
	set timer [after 3000 {set ::fin timeout}]
	vwait ::fin
	after cancel $timer
	return [dict create resp $resp evs $::evs fin $::fin]
}

# A fake tool-using provider: on the first pass it asks to run buffer_list; once
# the loop feeds the tool_result back (the latest user message carries a
# tool_result block) it streams a final line and ends. Posts are synchronous —
# the loop's `post` bridge defers them, so the contract is exercised faithfully.
proc tool_provider {conversation tools post} {
	set last [lindex $conversation end]
	set sawtool 0
	if {[dict exists $last content]} {
		foreach b [dict get $last content] {
			if {[dict get $b type] eq "tool_result"} { set sawtool 1 }
		}
	}
	if {$sawtool} {
		{*}$post delta "saw tools"
		{*}$post done end_turn
	} else {
		{*}$post tool t1 buffer_list {} {{}}
		{*}$post done tool_use
	}
}

# A fake write-using provider: first pass proposes the tool in ::wt_name/::wt_input/
# ::wt_raw; after the loop feeds a tool_result back, it finishes. Drives the
# approval gate (slice 5).
proc write_provider {conversation tools post} {
	set last [lindex $conversation end]
	set sawtool 0
	if {[dict exists $last content]} {
		foreach b [dict get $last content] {
			if {[dict get $b type] eq "tool_result"} { set sawtool 1 }
		}
	}
	if {$sawtool} {
		{*}$post delta "done"
		{*}$post done end_turn
	} else {
		{*}$post tool w1 $::wt_name $::wt_input $::wt_raw
		{*}$post done tool_use
	}
}

# A sink that stops the event loop at the approval gate (agent.propose) or when the
# turn ends (agent.message/agent.error).
proc ev_until_stop {ev} {
	lappend ::evs $ev
	switch -- [dict get $ev event] {
		agent.propose               { set ::stop propose }
		agent.message - agent.error { set ::stop done }
	}
}
# Start a write turn; return why the loop stopped ("propose"|"done"|"timeout") and
# bind the turn id. Pumps a real event loop, as a frontend would.
proc start_write {turnVar} {
	upvar 1 $turnVar turn
	set ::evs {} ; set ::stop {}
	set ack [rio::core::call_stream agent.send {text go} ev_until_stop]
	set turn [dict get $ack result turn]
	set tm [after 3000 {set ::stop timeout}] ; vwait ::stop ; after cancel $tm
	return $::stop
}
proc wait_done {} {
	set ::stop {}
	set tm [after 3000 {set ::stop timeout}] ; vwait ::stop ; after cancel $tm
	return $::stop
}
# The latest agent.tool_result summary for tool id $id in ::evs.
proc ev_summary {id} {
	set s ""
	foreach ev $::evs {
		if {[dict get $ev event] eq "agent.tool_result" && [dict get $ev params id] eq $id} {
			set s [dict get $ev params summary]
		}
	}
	return $s
}

test agent-send-ack {agent.send returns an ack {started, turn} and completes} -body {
	set out [run_turn "hi there"]
	set r [dict get $out resp]
	list [dict get $r ok] [dict get $r result started] \
		[expr {[dict get $r result turn] > 0}] [dict get $out fin]
} -result {true true 1 done}

test agent-streams-to-message {deltas stream and accumulate into the final agent.message} -body {
	set out [run_turn "hi there"]
	set deltas "" ; set msg ""
	foreach ev [dict get $out evs] {
		switch -- [dict get $ev event] {
			agent.delta   { append deltas [dict get $ev params text] }
			agent.message { set msg [dict get $ev params text] }
		}
	}
	list $msg [expr {$deltas eq $msg}]
} -result {{echo: hi there} 1}

test agent-event-order {a turn is deltas (>=1) then exactly one agent.message} -body {
	set out [run_turn "alpha beta"]
	set kinds {}
	foreach ev [dict get $out evs] { lappend kinds [dict get $ev event] }
	set last [lindex $kinds end]
	list [expr {[llength $kinds] >= 2}] \
		[expr {"agent.delta" in $kinds}] \
		[expr {[llength [lsearch -all -exact $kinds agent.message]] == 1}] \
		$last
} -result {1 1 1 agent.message}

test agent-events-carry-turn {every event of a turn carries that turn's id} -body {
	set out [run_turn "x"]
	set turn [dict get $out resp result turn]
	set ok 1
	foreach ev [dict get $out evs] {
		if {[dict get $ev params turn] ne $turn} { set ok 0 }
	}
	set ok
} -result 1

test agent-send-is-async {content is streamed via the event loop, not delivered synchronously} -body {
	set ::evs {} ; set ::fin {}
	rio::agent::set_provider ::rio::agent::echo_provider
	rio::core::call_stream agent.send {text hi} collect_ev
	set immediate [llength $::evs]                ;# nothing yet — first chunk is deferred
	set timer [after 3000 {set ::fin timeout}]
	vwait ::fin
	after cancel $timer
	list $immediate [expr {[llength $::evs] > 0}] $::fin
} -result {0 1 done}

test agent-history-records-turn {history holds the user msg then the assistant reply} -setup {
	rio::core::call agent.reset {}
} -body {
	run_turn "hello"
	set msgs [dict get [rio::core::call agent.history {}] response result messages]
	list [llength $msgs] \
		[dict get [lindex $msgs 0] role] [dict get [lindex $msgs 0] text] \
		[dict get [lindex $msgs 1] role] [dict get [lindex $msgs 1] text]
} -result {2 user hello assistant {echo: hello}}

test agent-reset-clears {agent.reset empties the conversation} -setup {
	run_turn "something"
} -body {
	rio::core::call agent.reset {}
	llength [dict get [rio::core::call agent.history {}] response result messages]
} -result 0

test agent-send-requires-text {agent.send without text is bad_request, no turn started} -body {
	set r [rio::core::call_stream agent.send {} collect_ev]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test agent-error-from-provider {a provider failure surfaces as a classified agent.error} -setup {
	proc ::down_provider {conversation tools post} { {*}$post error provider_down "boom" }
} -body {
	set out [run_turn "x" ::down_provider]
	set ev [lindex [dict get $out evs] end]
	list [dict get $out fin] [dict get $ev event] \
		[dict get $ev params code] [dict get $ev params message]
} -cleanup {
	rename ::down_provider {}
} -result {done agent.error provider_down boom}

test agent-ops-registered {agent.send/reset/history are in the live registry} -body {
	set ops [rio::dispatch::opnames]
	expr {"agent.send" in $ops && "agent.reset" in $ops && "agent.history" in $ops}
} -result 1

# --- tool round-trip (D26 slice 4) -------------------------------------------

test agent-tool-roundtrip {a tool_use turn runs the tool, feeds the result back, and finishes} -setup {
	rio::core::call agent.reset {}
} -body {
	set out [run_turn "list buffers" tool_provider]
	set tool {} ; set result {} ; set msg {}
	foreach ev [dict get $out evs] {
		switch -- [dict get $ev event] {
			agent.tool        { set tool [dict get $ev params name] }
			agent.tool_result { set result [list [dict get $ev params ok] [dict get $ev params name]] }
			agent.message     { set msg [dict get $ev params text] }
		}
	}
	list [dict get $out fin] $tool $result $msg
} -result {done buffer_list {1 buffer_list} {saw tools}}

test agent-tool-history-clean {history keeps the readable text turns, dropping tool machinery} -setup {
	rio::core::call agent.reset {}
} -body {
	run_turn "list buffers" tool_provider
	set msgs [dict get [rio::core::call agent.history {}] response result messages]
	set out {}
	foreach m $msgs { lappend out [dict get $m role] [dict get $m text] }
	set out
} -result {user {list buffers} assistant {saw tools}}

test agent-tool-confined {fs_read inside the project succeeds; an escaping path is refused unread} -setup {
	set ::pdir [makeDirectory agtool]
	makeFile "secret\n" inside.txt $::pdir
	rio::project::open $::pdir
} -body {
	set ok  [rio::agent::tools::run fs_read [dict create path inside.txt]]
	set bad [rio::agent::tools::run fs_read [dict create path /etc/hostname]]
	list [dict get $ok ok] [string trim [dict get $ok content]] \
		[dict get $bad ok] [string match {*outside the open project*} [dict get $bad content]]
} -cleanup {
	rio::project::close
} -result {1 secret 0 1}

test agent-tool-no-project {a path read with no project open names that reason, not "outside"} -setup {
	rio::project::close
} -body {
	set r [rio::agent::tools::run fs_read [dict create path AGENTS.md]]
	list [dict get $r ok] [dict get $r summary] \
		[string match {*No project is open*} [dict get $r content]]
} -result {0 {no project open} 1}

# --- write/propose-edit gate (D26 slice 5) -----------------------------------

test agent-write-approve {a proposed create applies on approval and the turn finishes} -setup {
	set ::pdir [makeDirectory agw]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_create
	set ::wt_input [dict create path new.txt content "hi\n"]
	set ::wt_raw {{"path":"new.txt","content":"hi\n"}}
} -body {
	set s1 [start_write turn]
	rio::core::call agent.approve [dict create turn $turn decision approve]
	set s2 [wait_done]
	set f [file join $::pdir new.txt]
	list $s1 $s2 [file exists $f] [string trim [dict get [rio::fs::read $f] text]] [ev_summary w1]
} -cleanup { rio::project::close } -result {propose done 1 hi {created new.txt}}

test agent-write-reject {a rejected proposal does not touch disk and feeds back "rejected"} -setup {
	set ::pdir [makeDirectory agwr]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_create
	set ::wt_input [dict create path no.txt content "x\n"]
	set ::wt_raw {{"path":"no.txt","content":"x\n"}}
} -body {
	set s1 [start_write turn]
	rio::core::call agent.approve [dict create turn $turn decision reject]
	set s2 [wait_done]
	list $s1 $s2 [file exists [file join $::pdir no.txt]] [ev_summary w1]
} -cleanup { rio::project::close } -result {propose done 0 {rejected by user}}

test agent-write-auto-accept {auto-accept applies without pausing for approval} -setup {
	set ::pdir [makeDirectory agwa]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 1
	set ::wt_name propose_create
	set ::wt_input [dict create path auto.txt content "a\n"]
	set ::wt_raw {{"path":"auto.txt","content":"a\n"}}
} -body {
	set out [run_turn "go" write_provider]
	list [dict get $out fin] [file exists [file join $::pdir auto.txt]]
} -cleanup { rio::agent::set_auto_accept 0 ; rio::project::close } -result {done 1}

test agent-approve-stale {approving a turn with nothing pending is a bad_request} -body {
	set r [dict get [rio::core::call agent.approve [dict create turn 999 decision approve]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test agent-edit-not-found {propose_edit whose old_string is absent is refused, unread} -setup {
	set ::pdir [makeDirectory agnf] ; makeFile "alpha\n" f.txt $::pdir
	rio::project::open $::pdir
} -body {
	set r [rio::agent::tools::prepare_write propose_edit \
		[dict create path f.txt old_string ZZZ new_string Q]]
	list [dict get $r ok] [dict get $r summary]
} -cleanup { rio::project::close } -result {0 {error: not found}}

test agent-edit-not-unique {propose_edit with a non-unique old_string is refused} -setup {
	set ::pdir [makeDirectory agnu] ; makeFile "x\nx\n" f.txt $::pdir
	rio::project::open $::pdir
} -body {
	set r [rio::agent::tools::prepare_write propose_edit \
		[dict create path f.txt old_string x new_string y]]
	list [dict get $r ok] [string match {*2 matches*} [dict get $r summary]]
} -cleanup { rio::project::close } -result {0 1}

# --- agent.proposal: the compare view's pull op (D28) ------------------------

test agent-proposal-pull {agent.proposal returns a pending proposal's original/proposed texts} -setup {
	set ::pdir [makeDirectory agpp]
	makeFile "alpha\nfoo\nbeta\n" f.txt $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path f.txt old_string foo new_string FOO]
	set ::wt_raw {{"path":"f.txt","old_string":"foo","new_string":"FOO"}}
} -body {
	set s1 [start_write turn]
	set res [dict get [rio::core::call agent.proposal [dict create turn $turn]] response result]
	rio::core::call agent.approve [dict create turn $turn decision reject]
	wait_done
	list $s1 [dict get $res name] [dict get $res path] \
		[expr {[dict get $res original] eq "alpha\nfoo\nbeta\n"}] \
		[expr {[dict get $res proposed] eq "alpha\nFOO\nbeta\n"}]
} -cleanup { rio::project::close } -result {propose propose_edit f.txt 1 1}

test agent-proposal-cleared {a resolved proposal is no longer pullable} -setup {
	set ::pdir [makeDirectory agpc]
	makeFile "x\n" g.txt $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path g.txt old_string x new_string y]
	set ::wt_raw {{"path":"g.txt","old_string":"x","new_string":"y"}}
} -body {
	set s1 [start_write turn]
	rio::core::call agent.approve [dict create turn $turn decision reject]
	wait_done
	set r [dict get [rio::core::call agent.proposal [dict create turn $turn]] response]
	list $s1 [dict get $r ok] [dict get $r error code]
} -cleanup { rio::project::close } -result {propose false bad_request}

test agent-proposal-stale {agent.proposal with nothing pending is a bad_request} -body {
	set r [dict get [rio::core::call agent.proposal [dict create turn 999]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

# --- wire encoding (D11/D25) -------------------------------------------------

test agent-delta-wire {an agent.delta event encodes to JSON} -body {
	rio::wire::event [dict create event agent.delta \
		params [dict create turn 1 text "hi"]]
} -result {{"event":"agent.delta","params":{"turn":"1","text":"hi"}}}

test agent-history-wire {agent.history encodes messages as an array of objects} -body {
	set result [dict create messages [list \
		[dict create role user text hi] \
		[dict create role assistant text {echo: hi}]]]
	rio::wire::response [dict create id 3 ok true op agent.history result $result]
} -result {{"id":"3","ok":true,"result":{"messages":[{"role":"user","text":"hi"},{"role":"assistant","text":"echo: hi"}]}}}

cleanupTests
