test agent-plan-approve {an approved plan files itself, flips the mode, and tells the model to build} -setup {
	set ::pdir [makeDirectory agpa]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_mode plan
	rio::agent::set_provider write_provider
	set ::wt_name present_plan
	set ::wt_input [dict create title "Add a cache" plan "## Changes\n\n- memoize it\n"]
	set ::wt_raw {{"title":"Add a cache","plan":"## Changes"}}
} -body {
	set s1 [start_write turn]
	set p [ev_propose w1]
	rio::core::call agent.approve [dict create turn $turn decision approve]
	set s2 [wait_done]
	set files [glob -nocomplain -directory [file join $::pdir .rio plans] *.md]
	list $s1 $s2 [dict get $p kind] [dict get $p title] \
		[string match "*- memoize it*" [dict get $p plan]] \
		[llength $files] [string match {*-add-a-cache.md} [lindex $files 0]] \
		[string match ".rio/plans/*" [dict get $p path]] \
		[rio::agent::mode] [ev_summary w1]
} -cleanup { rio::agent::set_mode build ; rio::project::close } \
	-result {propose done plan {Add a cache} 1 1 1 1 build {plan approved}}

