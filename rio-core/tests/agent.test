	set s2 [wait_done]
	list $s1 $s2 [rio::agent::mode] [ev_summary w1] \
		[llength [glob -nocomplain -directory [file join $::pdir .rio plans] *.md]]
} -cleanup { rio::agent::set_mode build ; rio::project::close } \
	-result {propose done plan {rejected by user} 1}

test agent-plan-always-gated {auto-accept never approves a plan for the user} -setup {
	set ::pdir [makeDirectory agpg]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 1
	rio::agent::set_mode plan
	rio::agent::set_provider write_provider
	set ::wt_name present_plan
	set ::wt_input [dict create title "Quietly" plan "do it"]
	set ::wt_raw {{"title":"Quietly","plan":"do it"}}
} -body {
	set s1 [start_write turn]
	rio::core::call agent.approve [dict create turn $turn decision approve]
	list $s1 [wait_done]
} -cleanup {
	rio::agent::set_auto_accept 0 ; rio::agent::set_mode build ; rio::project::close
} -result {propose done}

test agent-plan-tools-return-on-approval {after approval the SAME turn is handed the editing tools again} -setup {
	set ::pdir [makeDirectory agpt]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_mode plan
	rio::agent::set_provider plan_provider
	set ::seen {}
} -body {
	set s1 [start_write turn]
	rio::core::call agent.approve [dict create turn $turn decision approve]
	set s2 [wait_done]
	# Pass 1 was composed in plan mode, pass 2 after the approval flipped it. The editing
	# tools arrive on that second pass — the point of the per-step recompute. present_plan
	# is in BOTH lists now (D103): it is not the thing plan mode gates.
	list $s1 $s2 [llength $::seen] \
		[expr {"propose_edit" in [lindex $::seen 0]}] \
		[expr {"present_plan" in [lindex $::seen 0]}] \
		[expr {"propose_edit" in [lindex $::seen 1]}] \
		[expr {"present_plan" in [lindex $::seen 1]}]
} -cleanup { rio::agent::set_mode build ; rio::project::close } -result {propose done 2 0 1 1 1}

# --- the plan is re-read at approval (D102) ----------------------------------
# The filed plan IS the plan, so the user may open it and change it before saying yes. What
# comes back to the model is what they approved, not what it wrote. These tests read the
# tool_result CONTENT (the model's side of the gate), which the summary does not carry.
proc capture_provider {conversation tools system post} {
	set last [lindex $conversation end]
	set sawtool 0
	if {[dict exists $last content]} {
		foreach b [dict get $last content] {
			if {[dict get $b type] eq "tool_result"} {
				set sawtool 1
				set ::wt_result [dict get $b content]
			}
		}
	}
	if {$sawtool} {
		{*}$post delta "done" ; {*}$post done end_turn
	} else {
		{*}$post tool w1 $::wt_name $::wt_input $::wt_raw ; {*}$post done tool_use
	}
}
# Present a plan, run `body` while the turn is parked at the gate, then approve it.
# Returns the tool_result the model was handed.
proc plan_then {body {mode plan}} {
	set ::wt_name present_plan
	set ::wt_input [dict create title "Add a cache" plan "## Changes\n\n- memoize it\n"]
	set ::wt_raw {{"title":"Add a cache","plan":"## Changes"}}
	set ::wt_result ""
	rio::core::call agent.reset {}
	rio::agent::set_mode $mode
	rio::agent::set_provider capture_provider
	set stop [start_write turn]
	if {$stop ne "propose"} { return "did not reach the gate: $stop" }
	set ::plan_file [file join [rio::project::root] [dict get [ev_propose w1] path]]
	uplevel 1 $body
	rio::core::call agent.approve [dict create turn $turn decision approve]
	wait_done
	return $::wt_result
}
proc plan_test_setup {name} {
	set ::pdir [makeDirectory $name]
	rio::project::open $::pdir
}

test agent-plan-reread-unchanged {an untouched plan gets the short result, not its own words back} -setup {
	plan_test_setup agprr1
} -body {
	set c [plan_then {}]
	list [string match "*carry the plan out now*" $c] [string match "*EDITED*" $c] \
		[ev_summary w1]
} -cleanup { rio::agent::set_mode build ; rio::project::close } -result {1 0 {plan approved}}

test agent-plan-reread-edited {a plan edited on disk before approval is what comes back} -setup {
	plan_test_setup agprr2
} -body {
	set c [plan_then {
		set fh [open $::plan_file w] ; fconfigure $fh -encoding utf-8
		puts $fh "# Add a cache\n\n- memoize it\n- AND invalidate on fs.changed"
		close $fh
	}]
	list [string match "*EDITED*" $c] [string match "*AND invalidate on fs.changed*" $c] \
		[ev_summary w1]
} -cleanup { rio::agent::set_mode build ; rio::project::close } \
	-result {1 1 {plan approved (edited)}}

test agent-plan-reread-live-buffer {an OPEN, unsaved plan beats the disk copy} -setup {
	plan_test_setup agprr3
} -body {
	set c [plan_then {
		set b [dict get [dict get [rio::core::call file.open \
			[dict create path $::plan_file]] response] result buffer]
		set lines [rio::doc::lines $b]
		rio::doc::edit $b 1.0 "[llength $lines].[string length [lindex $lines end]]" \
			"# Add a cache\n\nnever saved, still approved\n"
	}]
	# The disk copy is untouched — so a disk read would have missed the edit entirely.
	list [string match "*never saved, still approved*" $c] \
		[string match "*never saved*" [dict get [rio::fs::read $::plan_file] text]] \
		[ev_summary w1]
} -cleanup { rio::agent::set_mode build ; rio::project::close } \
	-result {1 0 {plan approved (edited)}}

test agent-plan-reread-file-gone {a deleted plan file falls back to the plan as presented} -setup {
	plan_test_setup agprr4
} -body {
	set c [plan_then { file delete -force $::plan_file }]
	list [string match "*carry the plan out now*" $c] [string match "*EDITED*" $c] \
		[ev_summary w1]
} -cleanup { rio::agent::set_mode build ; rio::project::close } -result {1 0 {plan approved}}

test agent-plan-from-build-mode {a plan asked for in build mode is presented, gated, and approved without a mode flip} -setup {
	plan_test_setup agprb
	rio::agent::set_auto_accept 1   ;# and still gated: auto-accept is edits-only (D83)
} -body {
	set c [plan_then {} build]
	set modes {}
	foreach ev $::evs {
		if {[dict get $ev event] eq "agent.mode"} { lappend modes [dict get $ev params mode] }
	}
	# Presented (so it reached the gate), the mode never announced a flip it did not make,
	# and the result does not tell the model that plan mode "is off" — it never was on.
	list [dict get [ev_propose w1] kind] [rio::agent::mode] $modes \
		[string match "*Plan mode is off*" $c] [string match "*Carry it out now*" $c]
} -cleanup {
	rio::agent::set_auto_accept 0 ; rio::agent::set_mode build ; rio::project::close
} -result {plan build {} 0 1}

test agent-plan-read-plan-nowhere {read_plan is empty for an unfiled plan, and never raises} -setup {
	plan_test_setup agprr5
} -body {
	list [rio::agent::tools::read_plan ""] \
		[rio::agent::tools::read_plan .rio/plans/never-written.md]
} -cleanup { rio::project::close } -result {{} {}}

# --- stopping a turn (D104) --------------------------------------------------
# There is no step cap any more: a turn runs until the model is done, and the bound is the
# user's Stop. So Stop has to actually work from every state a turn can be in, and has to
# leave the conversation extendable — the next message must not meet a broken alternation.

# A provider that starts working and never reports back: the state a long turn spends most
# of its time in, and the one a step cap never helped with.
proc hang_provider {conversation tools system post} { set ::hang_post $post }
# A provider that keeps calling a read tool `::pp_steps` times before finishing — more
# round-trips than the old cap of 8 allowed.
proc counting_provider {conversation tools system post} {
	incr ::pp_seen
	if {$::pp_seen > $::pp_steps} {
		{*}$post delta "done" ; {*}$post done end_turn
	} else {
		{*}$post tool t$::pp_seen fs_list [dict create path ""] {{"path":""}}
		{*}$post done tool_use
	}
}
# Do the conversation's roles strictly alternate? The thing Claude rejects a request over.
proc roles_alternate {} {
	set prev ""
	foreach m $::rio::agent::conversation {
		if {[dict get $m role] eq $prev} { return 0 }
		set prev [dict get $m role]
	}
	return 1
}

test agent-stop-in-flight {a turn waiting on the provider stops, and announces it} -setup {
	rio::core::call agent.reset {}
	rio::agent::set_provider hang_provider
	set ::evs {}
} -body {
	set turn [dict get [rio::core::call_stream agent.send {text go} ev_until_stop] result turn]
	set was [info exists ::rio::agent::live($turn)]
	set call [rio::core::call agent.stop {}]
	set evs {} ; foreach e [dict get $call events] { lappend evs [dict get $e event] }
	list $was [dict get [dict get $call response] result stopped] $evs \
		[info exists ::rio::agent::live($turn)] \
		[llength [info commands ::rio::agent::_turn_$turn]]
} -result {1 1 agent.stopped 0 0}

test agent-stop-then-send {after a stop the conversation still alternates and takes a new turn} -setup {
	rio::core::call agent.reset {}
	rio::agent::set_provider hang_provider
	set ::evs {}
} -body {
	rio::core::call_stream agent.send {text first} ev_until_stop
	rio::core::call agent.stop {}
	set a [roles_alternate]
	# The stopped turn left a note where the assistant's answer would have been, so the
	# next user message is not a second user entry in a row.
	set roles {} ; foreach m [rio::agent::history] { lappend roles [dict get $m role] }
	rio::agent::set_provider [namespace which -command ::rio::agent::echo_provider]
	set out [run_turn "second"]
	list $a $roles [dict get $out fin] [roles_alternate]
} -result {1 {user assistant} done 1}

test agent-stop-at-the-gate {a turn parked at the approval gate can be stopped too} -setup {
	set ::pdir [makeDirectory agstop]
	rio::project::open $::pdir
	set fh [open [file join $::pdir a.txt] w] ; puts -nonewline $fh "one\n" ; close $fh
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name propose_edit
	set ::wt_input [dict create path a.txt old_string one new_string two]
	set ::wt_raw {{"path":"a.txt"}}
} -body {
	set s1 [start_write turn]
	set call [rio::core::call agent.stop {}]
	set r [dict get [rio::core::call agent.approve [dict create turn $turn decision approve]] response]
	# Stopped, forgotten, and the file never changed — a stopped proposal is not applied.
	list $s1 [dict get [dict get $call response] result stopped] \
		[dict get $r ok] [dict get $r error code] \
		[dict get [rio::fs::read [file join $::pdir a.txt]] text]
} -cleanup { rio::project::close } -result {propose 1 false bad_request {one
}}

test agent-stop-nothing-running {stopping when nothing is running is not an error} -setup {
	rio::core::call agent.reset {}
} -body {
	set call [rio::core::call agent.stop {}]
	set r [dict get $call response]
	list [dict get $r ok] [dict get $r result stopped] [llength [dict get $call events]]
} -result {true 0 0}

test agent-stop-prunes-dead {a registration whose turn has finished is pruned, not "stopped"} -setup {
	rio::core::call agent.reset {}
} -body {
	# The registry is bookkeeping, and bookkeeping can outlive what it describes. Stop asks
	# the coroutine itself whether it is still there, so a raced or stale entry reports
	# honestly instead of telling the user it stopped something it did not.
	set ::rio::agent::live(9999) ::rio::agent::_turn_9999_gone
	set r [dict get [rio::core::call agent.stop {}] response]
	list [dict get $r ok] [dict get $r result stopped] \
		[info exists ::rio::agent::live(9999)]
} -result {true 0 0}

test agent-no-step-cap {a turn runs as many tool steps as the model asks for} -setup {
	set ::pdir [makeDirectory agsteps]
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_provider counting_provider
	set ::pp_steps 12 ; set ::pp_seen 0   ;# the old cap stopped the turn at 8
	set ::evs {}
} -body {
	set ::stop {}
	rio::core::call_stream agent.send {text go} ev_until_stop
	set tm [after 5000 {set ::stop timeout}] ; vwait ::stop ; after cancel $tm
	set errs {}
	foreach ev $::evs {
		if {[dict get $ev event] eq "agent.error"} { lappend errs [dict get $ev params code] }
	}
	list $::stop $::pp_seen $errs
} -cleanup { rio::project::close } -result {done 13 {}}

# --- allow-list: standing approval (D84) -------------------------------------
# A command covered by an allow-list rule runs WITHOUT an agent.approve — the propose
# event carries auto=1 and the turn completes on its own. The allow-list is pinned to a
# throwaway dir so the real ~/.config is untouched. `ev_auto w1` reads the propose's
# auto flag; the run still round-trips a tool_result.
proc ev_auto {id} {
	foreach ev $::evs {
		if {[dict get $ev event] eq "agent.propose" && [dict get $ev params id] eq $id} {
			return [dict get $ev params auto]
		}
	}
	return ""
}

test agent-exec-allow-auto {an allow-listed command runs with no approval, auto=1} -setup {
	set ::adir [makeDirectory agxa-allow]
	rio::agent::allow::override_dir $::adir
	rio::agent::allow::add global "" [list $::tcl]
	set ::pdir [makeDirectory agxa]
	makeFile "puts ok; exit 0" run.tcl $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name run_command
	set ::wt_input [dict create command [list $::tcl run.tcl]]
	set ::wt_raw {{"command":["tclsh","run.tcl"]}}
} -body {
	# No agent.approve is issued — run_turn pumps straight to done.
	set out [run_turn "go" write_provider]
	list [dict get $out fin] [ev_auto w1] [string match {ran *exit 0} [ev_summary w1]]
} -cleanup {
	rio::agent::allow::override_dir "" ; rio::project::close
} -result {done 1 1}

test agent-exec-unmatched-parks {a command not on the allow-list still parks, auto=0} -setup {
	set ::adir [makeDirectory agxu-allow]
	rio::agent::allow::override_dir $::adir
	rio::agent::allow::add global "" [list some-other-program]
	set ::pdir [makeDirectory agxu]
	makeFile "exit 0" run.tcl $::pdir
	rio::project::open $::pdir
	rio::core::call agent.reset {}
	rio::agent::set_auto_accept 0
	rio::agent::set_provider write_provider
	set ::wt_name run_command
	set ::wt_input [dict create command [list $::tcl run.tcl]]
	set ::wt_raw {{"command":["tclsh","run.tcl"]}}
} -body {
	set s1 [start_write turn]
	set a [ev_auto w1]
	# Nothing ran yet (parked at the gate); approve to finish and not leak the turn.
	rio::core::call agent.approve [dict create turn $turn decision approve]
	set s2 [wait_done]
	list $s1 $a $s2
} -cleanup {
	rio::agent::allow::override_dir "" ; rio::project::close
} -result {propose 0 done}

