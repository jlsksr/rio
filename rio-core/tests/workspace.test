# Tests for the per-project workspace store (rio::workspace) and the workspace.*
# ops (AGENTS.md D31): "resume my working space" — which files were open in a
# project and which tab was active, kept out of tree under the data dir, keyed by
# the open project root, pruned to paths that still exist. Local only. The empty
# root is the anonymous (no-project) session (D72).

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. error.tcl]
source [file join [file dirname [info script]] .. core.tcl]
source [file join [file dirname [info script]] .. wire.tcl]

# Point the store at a throwaway dir for the whole file.
set ::dir [file join [::tcltest::temporaryDirectory] riows-[clock clicks]]
set rio::workspace::override_dir $::dir

# A throwaway project tree with two real files (so pruning has something to keep).
proc make_tree {} {
	set d [file join [::tcltest::temporaryDirectory] riowsproj-[clock clicks]]
	file mkdir $d
	close [open [file join $d a.txt] w]
	close [open [file join $d b.txt] w]
	return $d
}

# --- the pure store (rio::workspace) ----------------------------------------

test ws-absent-empty {a project with no saved session reads back empty} -body {
	rio::workspace::get /no/such/project
} -result {open {} active {} expanded {}}

test ws-roundtrip {save then get returns the same open list and active} -body {
	rio::workspace::save /proj/one [list /proj/one/a.txt /proj/one/b.txt] /proj/one/b.txt
	set s [rio::workspace::get /proj/one]
	list [dict get $s open] [dict get $s active]
} -result {{/proj/one/a.txt /proj/one/b.txt} /proj/one/b.txt}

test ws-expanded-roundtrip {the unfolded-tree set (D89) round-trips like the open list} -body {
	rio::workspace::save /proj/exp [list /proj/exp/a.txt] /proj/exp/a.txt \
		[list /proj/exp/src /proj/exp/src/net]
	dict get [rio::workspace::get /proj/exp] expanded
} -result {/proj/exp/src /proj/exp/src/net}

test ws-expanded-defaults-empty {save without an expanded arg reads back an empty set} -body {
	rio::workspace::save /proj/noexp [list /proj/noexp/a.txt] ""
	dict get [rio::workspace::get /proj/noexp] expanded
} -result {}

test ws-expanded-pre-d89 {a session file missing the expanded key reads back empty, not an error} -body {
	set p [rio::workspace::_path /proj/old]
	file mkdir [file dirname $p]
	set f [open $p w]; puts -nonewline $f {{"root":"/proj/old","active":"","open":["/proj/old/a.txt"]}}; close $f
	set s [rio::workspace::get /proj/old]
	list [dict get $s open] [dict get $s expanded]
} -result {/proj/old/a.txt {}}

test ws-paths-with-spaces {paths containing spaces survive the JSON round-trip} -body {
	rio::workspace::save /proj/sp [list "/a dir/x y.txt"] "/a dir/x y.txt"
	dict get [rio::workspace::get /proj/sp] open
} -result {{/a dir/x y.txt}}

test ws-empty-open {an empty open list round-trips as empty} -body {
	rio::workspace::save /proj/empty {} ""
	rio::workspace::get /proj/empty
} -result {open {} active {} expanded {}}

test ws-overwrite {a second save replaces the first} -body {
	rio::workspace::save /proj/ow [list /x/1] /x/1
	rio::workspace::save /proj/ow [list /x/2] /x/2
	dict get [rio::workspace::get /proj/ow] open
} -result {/x/2}

test ws-key-stable-per-root {each root maps to its own file; the same root is stable} -body {
	list [expr {[rio::workspace::_path /proj/aaa] eq [rio::workspace::_path /proj/aaa]}] \
		[expr {[rio::workspace::_path /proj/aaa] ne [rio::workspace::_path /proj/bbb]}]
} -result {1 1}

test ws-anon-key-reserved {the empty root gets a stable, reserved path, distinct from any real root} -body {
	list [expr {[rio::workspace::_path ""] eq [rio::workspace::_path ""]}] \
		[expr {[rio::workspace::_path ""] ne [rio::workspace::_path /proj/aaa]}] \
		[file tail [rio::workspace::_path ""]]
} -result {1 1 anonymous.json}

test ws-anon-roundtrip {the anonymous (empty-root) session saves and reads back} -body {
	rio::workspace::save "" [list /loose/a.txt /other/b.txt] /loose/a.txt
	set s [rio::workspace::get ""]
	list [dict get $s open] [dict get $s active]
} -result {{/loose/a.txt /other/b.txt} /loose/a.txt}

test ws-forget {forget drops the saved session} -body {
	rio::workspace::save /proj/gone [list /x/1] /x/1
	rio::workspace::forget /proj/gone
	rio::workspace::get /proj/gone
} -result {open {} active {} expanded {}}

test ws-corrupt-reads-empty {a corrupt session file reads back empty, not an error} -body {
	set p [rio::workspace::_path /proj/corrupt]
	file mkdir [file dirname $p]
	set f [open $p w]; puts $f "@@ not valid json @@"; close $f
	rio::workspace::get /proj/corrupt
} -result {open {} active {} expanded {}}

test ws-dir-perms-0700 {the sessions dir is mode 0700} -constraints unix -body {
	rio::workspace::save /proj/perm {} ""
	format %04o [expr {[file attributes $::dir -permissions] & 0777}]
} -result 0700

# --- through the in-process core (the workspace.* ops) ----------------------

test ws-op-anon-fresh-empty {workspace.get with no project open and nothing saved is empty (D72)} -setup {
	rio::project::close
	rio::workspace::forget ""
} -body {
	set resp [dict get [rio::core::call workspace.get {}] response]
	list [dict get $resp result open] [dict get $resp result active]
} -result {{} {}}

test ws-op-anon-roundtrip {with no project open, save/get resume the anonymous session (D72)} -setup {
	rio::project::close
	set ::loose [make_tree]   ;# two real files so the prune keeps them
} -body {
	set a [file join $::loose a.txt]
	set b [file join $::loose b.txt]
	set saved [dict get [dict get [rio::core::call workspace.save \
		[dict create open "$a\n$b" active $a]] response] result saved]
	set resp [dict get [rio::core::call workspace.get {}] response]
	list $saved \
		[expr {[dict get $resp result open] eq [list $a $b]}] \
		[expr {[dict get $resp result active] eq $a}]
} -cleanup { rio::workspace::forget ""; file delete -force $::loose } -result {1 1 1}

test ws-op-save-get-roundtrip {save keyed by the open root, then get reads it back} -setup {
	set ::tree [make_tree]; rio::project::open $::tree
} -body {
	set a [file join $::tree a.txt]
	set b [file join $::tree b.txt]
	rio::core::call workspace.save [dict create open "$a\n$b" active $b]
	set resp [dict get [rio::core::call workspace.get {}] response]
	list [expr {[dict get $resp result open] eq [list $a $b]}] \
		[expr {[dict get $resp result active] eq $b}]
} -cleanup { rio::project::close; file delete -force $::tree } -result {1 1}

test ws-op-newline-splits-and-drops-empty {the newline-joined open param splits; empty segments drop} -setup {
	set ::tree [make_tree]; rio::project::open $::tree
} -body {
	set a [file join $::tree a.txt]
	# trailing + doubled newline: no empty entries should survive the split
	rio::core::call workspace.save [dict create open "$a\n\n"]
	expr {[dict get [dict get [rio::core::call workspace.get {}] response] result open] eq [list $a]}
} -cleanup { rio::project::close; file delete -force $::tree } -result 1

test ws-op-prunes-missing-paths {get drops paths that no longer exist} -setup {
	set ::tree [make_tree]; rio::project::open $::tree
} -body {
	set a    [file join $::tree a.txt]
	set gone [file join $::tree gone.txt]
	rio::core::call workspace.save [dict create open "$a\n$gone" active $gone]
	set resp [dict get [rio::core::call workspace.get {}] response]
	# a.txt stays; gone.txt is pruned; a pruned active falls back to ""
	list [expr {[dict get $resp result open] eq [list $a]}] \
		[expr {[dict get $resp result active] eq ""}]
} -cleanup { rio::project::close; file delete -force $::tree } -result {1 1}

test ws-op-expanded-roundtrip-and-prune {expanded dirs round-trip; a vanished one is pruned (D89)} -setup {
	set ::tree [make_tree]; file mkdir [file join $::tree src]; rio::project::open $::tree
} -body {
	set src  [file join $::tree src]
	set gone [file join $::tree gone]
	rio::core::call workspace.save [dict create open "" active "" expanded "$src\n$gone"]
	set got [dict get [dict get [rio::core::call workspace.get {}] response] result expanded]
	expr {$got eq [list $src]}
} -cleanup { rio::project::close; file delete -force $::tree } -result 1

test ws-ops-registered {workspace.save and workspace.get are in the live registry} -body {
	expr {"workspace.save" in [rio::dispatch::opnames] \
		&& "workspace.get" in [rio::dispatch::opnames]}
} -result 1

test ws-get-wire {workspace.get encodes to JSON with open + expanded arrays and an active string} -body {
	set result [dict create open [list /p/a.txt /p/b.txt] active /p/b.txt expanded [list /p/src]]
	rio::wire::response [dict create id 1 ok true op workspace.get result $result]
} -result {{"id":"1","ok":true,"result":{"open":["/p/a.txt","/p/b.txt"],"active":"/p/b.txt","expanded":["/p/src"]}}}

file delete -force $::dir
cleanupTests
