# Tests for CHANGELOG.md (D124) — the guard that keeps it current.
#
# The decisions are the records in adr/. CHANGELOG.md restates the user-visible ones,
# and nothing fails when a copy falls behind — so this holds the two both ways:
#
#   every decision  ->  cited by an entry, or exempted below with a reason
#   every citation  ->  a decision that exists
#
# A decision is named D1..D136 (the record's **Decision:** line) or, for a record
# without a D number, ADR-NNNN.
#
# The rest is shape: Keep a Changelog sections in order, the top heading carrying
# rio's version, entries newest first, and — given a git repository — every commit
# resolving and every date being that commit's own.
#
# No network. git is only read.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8 (D54).
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

set ::root [file normalize [file join [file dirname [info script]] .. ..]]
source [file join $::root rio-core version.tcl]

proc slurp {path} {
	set f [open $path]
	fconfigure $f -encoding utf-8
	set text [read $f]
	close $f
	return $text
}

set ::changelog [slurp [file join $::root CHANGELOG.md]]

# --- the exemption table ---------------------------------------------------------------
#
# A decision with no changelog entry, and why it has none. Every line is a claim that a
# reader would not have been able to see this one, and `changelog-exemptions-are-live`
# holds each of them to a decision that exists and is genuinely uncited.
array set ::no_entry {
	D25 {JSON value encoding is shape-aware — a wire-format internal, invisible above the protocol}
	D53 {the assisted-not-autonomous line for LLM work — policy, not a change to rio}
	D59 {menus highlighting on hover — tried and REVERTED, so nothing shipped}
	D68 {static help must look unlike an interactive control — a convention the UI follows, not an entry}
	D95 {a headless run never asks a human anything — a test-harness rule}
	D96 {rio speaks the protocol and does not dial — a refusal, and refusing a feature is not a change}
	D124 {this file and the changelog itself — an entry would have to cite the commit that creates the changelog, which does not exist while the entry is being written, and a file announcing its own existence tells its reader nothing}
	ADR-0112 {the TUI is deferred — nothing shipped}
	ADR-0113 {the error-code taxonomy — a wire-format internal}
	ADR-0114 {one project root — how the core is built, not a change to it}
	ADR-0117 {the derived-facts register — policy}
	ADR-0144 {decisions move from AGENTS.md to adr/ — a change to the documents, not to rio}
}
# D1–D21 predate anything runnable, so they were a change to nothing. D22 is the
# first with an entry.
set ::no_entry_before 22

# --- parsing ----------------------------------------------------------------------------
#
# An entry is a top-level list item under a `### Section`, possibly wrapped over several
# lines, ending in its citation: *D101/ADR-0144 · `b01bf98` · 2026-09-11* (the decisions
# are optional — two entries predate the numbering). Nothing here greps the file for a
# word: the parse yields a list of entries and every check below is about that list.
proc parse_entries {text} {
	set entries {} ; set section "" ; set release "" ; set cur ""
	foreach line [split $text \n] {
		if {[regexp {^## (.+)$} $line -> h]} {
			if {$cur ne ""} { lappend entries [entry $release $section $cur] ; set cur "" }
			set release [string trim $h] ; set section ""
		} elseif {[regexp {^### (.+)$} $line -> h]} {
			if {$cur ne ""} { lappend entries [entry $release $section $cur] ; set cur "" }
			set section [string trim $h]
		} elseif {[regexp {^- (.*)$} $line -> rest]} {
			if {$cur ne ""} { lappend entries [entry $release $section $cur] }
			set cur $rest
		} elseif {$cur ne "" && [regexp {^  \S} $line]} {
			append cur " " [string trim $line]
		} elseif {$cur ne ""} {
			lappend entries [entry $release $section $cur] ; set cur ""
		}
	}
	if {$cur ne ""} { lappend entries [entry $release $section $cur] }
	return $entries
}

# One entry as a dict: where it sits, what it cites, and the text as parsed.
proc entry {release section text} {
	set ds {} ; set commit "" ; set date ""
	# The separator is U+00B7, written as an escape: this file is decoded with the SYSTEM
	# encoding on Windows (rio-core/tests/all.tcl), where a literal would arrive mojibake.
	set sep \u00b7
	if {[regexp "\\*((?:\[0-9A-Za-z/-\]+ )?)(?:$sep )?`(\[0-9a-f\]{7,40})` $sep (\\d{4}-\\d{2}-\\d{2})\\*\\s*\$" \
			$text -> dpart commit date]} {
		foreach d [split [string trim $dpart] /] { if {$d ne ""} { lappend ds $d } }
	}
	return [dict create release $release section $section text $text \
		decisions $ds commit $commit date $date]
}

set ::entries [parse_entries $::changelog]

# Every decision the records carry, by name: {D1 D2 … D106 D106a … ADR-0112 …}.
proc decisions {} {
	set out {}
	foreach path [glob -directory [file join $::root adr] {[0-9][0-9][0-9][0-9]-*.md}] {
		regexp {^(\d{4})-} [file tail $path] -> num
		set line ""
		regexp -line {^- \*\*Decision:\*\* (.+)$} [slurp $path] -> line
		set ds [regexp -all -inline {\mD\d+[a-z]?} $line]
		if {![llength $ds]} { set ds [list ADR-$num] }
		lappend out {*}$ds
	}
	return [lsort -dictionary -unique $out]
}
proc cited_decisions {} {
	set out {}
	foreach e $::entries { foreach d [dict get $e decisions] { lappend out $d } }
	return [lsort -unique $out]
}

testConstraint hasgit [expr {[file isdirectory [file join $::root .git]] &&
	![catch {exec git --version}]}]

# --- the register: both directions ------------------------------------------------------

test changelog-every-decision-has-an-entry-or-a-reason {the result is the decisions that
		are neither cited nor exempt — "the changelog is behind", by name} -body {
	set cited [cited_decisions]
	set missing {}
	foreach d [decisions] {
		if {[regexp {^D(\d+)$} $d -> n] && $n < $::no_entry_before} continue
		if {[regexp {^D\d+[a-z]$} $d]} continue   ;# D106a..e ride on D106
		if {[info exists ::no_entry($d)]} continue
		if {$d ni $cited} { lappend missing $d }
	}
	set missing
} -result {}

test changelog-exemptions-are-live {an exemption names a real decision that really has
		no entry, and says why} -body {
	set cited [cited_decisions]
	set have [decisions]
	set wrong {}
	foreach d [lsort -dictionary [array names ::no_entry]] {
		if {$d ni $have} { lappend wrong "$d: no such decision" }
		if {$d in $cited} { lappend wrong "$d: has an entry now" }
		if {[string trim $::no_entry($d)] eq ""} { lappend wrong "$d: no reason given" }
	}
	set wrong
} -result {}

test changelog-cites-only-decisions-that-exist {an entry citing a decision no record
		carries is a typo'd number} -body {
	set have [decisions]
	set bad {}
	foreach d [cited_decisions] { if {$d ni $have} { lappend bad $d } }
	set bad
} -result {}

# --- shape --------------------------------------------------------------------------------

test changelog-release-heading-carries-rios-version {the heading is a fact with a second
		home — rio-core/version.tcl. Read from the file, not typed here, so a bump that
		forgets the changelog fails. Every heading's SHAPE is held too; the COUNT is not,
		or the check would be false from rio's second release onward} -body {
	set headings {}
	foreach line [split $::changelog \n] {
		if {[regexp {^## (.+)$} $line -> h]} { lappend headings [string trim $h] }
	}
	set bad {}
	foreach h $headings {
		if {![regexp {^\[\d+\.\d+\.\d+\] — (unreleased|\d{4}-\d{2}-\d{2})$} $h]} {
			lappend bad $h
		}
	}
	set top [lindex $headings 0]
	list $bad [expr {[llength $headings] > 0}] \
		[regexp "^\\\[[string map {. \\.} $::rio::version]\\\]" $top]
} -result {{} 1 1}

test changelog-sections-are-keep-a-changelog {the vocabulary is the format's, and the
		order is the format's order — an invented section name means an entry lands
		somewhere a reader is not looking for it} -body {
	set canon {Added Changed Deprecated Removed Fixed Security}
	set seen {}
	foreach line [split $::changelog \n] {
		if {[regexp {^## [^#]} $line]} { lappend seen "|release|" }
		if {[regexp {^### (.+)$} $line -> h]} { lappend seen [string trim $h] }
	}
	set bad {} ; set last -1
	foreach s $seen {
		if {$s eq "|release|"} { set last -1 ; continue }
		set i [lsearch -exact $canon $s]
		if {$i < 0} { lappend bad "$s: not a Keep a Changelog section" ; continue }
		if {$i <= $last} { lappend bad "$s: out of order" }
		set last $i
	}
	set bad
} -result {}

test changelog-every-entry-carries-a-citation {an entry without a commit and a date is
		unverifiable prose, and the checks below would skip it in silence} -body {
	set bad {}
	foreach e $::entries {
		if {[dict get $e commit] eq "" || [dict get $e date] eq ""} {
			lappend bad [string range [dict get $e text] 0 50]
		}
	}
	set bad
} -result {}

test changelog-entries-are-newest-first {within a section, so a reader meets the newest
		change first — the one property a changelog has that a decision log does not} -body {
	set bad {} ; set prev "" ; set sect ""
	foreach e $::entries {
		if {[dict get $e section] ne $sect} { set sect [dict get $e section] ; set prev "" }
		set d [dict get $e date]
		if {$prev ne "" && [string compare $d $prev] > 0} {
			lappend bad "$sect: $d after $prev"
		}
		set prev $d
	}
	set bad
} -result {}

# --- against git --------------------------------------------------------------------------

test changelog-commits-resolve {a citation is a pointer; one that does not resolve is
		worse than none} -constraints hasgit -body {
	set bad {}
	foreach e $::entries {
		set c [dict get $e commit]
		if {[catch {exec git -C $::root cat-file -t $c} type] || $type ne "commit"} {
			lappend bad $c
		}
	}
	set bad
} -result {}

test changelog-dates-are-the-commits-own {the date is looked up, never proofread: it must
		be the date the cited commit carries. This is what stops a copied entry keeping the
		date of the one it was copied from} -constraints hasgit -body {
	set bad {}
	foreach e $::entries {
		set c [dict get $e commit]
		if {[catch {exec git -C $::root log -1 --date=short --pretty=%ad $c} real]} continue
		if {$real ne [dict get $e date]} { lappend bad "$c: says [dict get $e date], is $real" }
	}
	set bad
} -result {}

cleanupTests
