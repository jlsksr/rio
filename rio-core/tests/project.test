# Tests for the project / workspace root (rio::project, AGENTS.md project.*) and
# the project.* / fs.list ops driven through the in-process core. A project is a
# single open directory the core holds; fs.list lists one directory of it for the
# file tree, resolving paths against that root.
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. error.tcl]
source [file join [file dirname [info script]] .. fs.tcl]
source [file join [file dirname [info script]] .. core.tcl]
source [file join [file dirname [info script]] .. wire.tcl]

# A throwaway directory tree to list: two files, one subdir, one dotfile.
proc make_tree {} {
	set d [file join [::tcltest::temporaryDirectory] rioproj-[clock clicks]]
	file mkdir $d
	file mkdir [file join $d src]
	close [open [file join $d a.txt] w]
	close [open [file join $d b.txt] w]
	close [open [file join $d .hidden] w]
	return $d
}

# Each test opens a fresh tree as the project root; close it after so state never
# leaks between tests (the root is process-global, like the buffer registry).
proc setup_proj {} { set ::tree [make_tree]; rio::project::open $::tree }
proc teardown_proj { } { rio::project::close; file delete -force $::tree }

# --- root state (rio::project) ----------------------------------------------

test project-open-sets-root {open records a normalized absolute root} -setup {
	set ::tree [make_tree]
} -body {
	set r [rio::project::open $::tree]
	list [expr {$r eq [file normalize $::tree]}] [expr {[rio::project::root] eq $r}]
} -cleanup { rio::project::close; file delete -force $::tree } -result {1 1}

test project-open-rejects-nonexistent {open on a non-directory raises io_error} -body {
	catch {rio::project::open [file join [::tcltest::temporaryDirectory] no-such-dir-[clock clicks]]} m opts
	rio::error::code_of $opts
} -result io_error

test project-open-rejects-empty {open with no path raises bad_request} -body {
	catch {rio::project::open ""} m opts
	rio::error::code_of $opts
} -result bad_request

test project-resolve-empty-is-root {empty path resolves to the root} -setup setup_proj -body {
	expr {[rio::project::resolve ""] eq [file normalize $::tree]}
} -cleanup teardown_proj -result 1

test project-resolve-relative {a relative path joins onto the root} -setup setup_proj -body {
	expr {[rio::project::resolve src] eq [file normalize [file join $::tree src]]}
} -cleanup teardown_proj -result 1

test project-resolve-absolute {an absolute path is taken as-is} -setup setup_proj -body {
	expr {[rio::project::resolve /etc] eq [file normalize /etc]}
} -cleanup teardown_proj -result 1

test project-resolve-no-root {a relative path with no project open raises} -body {
	rio::project::close
	catch {rio::project::resolve src} m opts
	rio::error::code_of $opts
} -result bad_request

# --- directory listing (rio::fs::list) --------------------------------------

test fs-list-names-and-types {lists files and dirs, dotfiles included, with types} -setup {
	set ::tree [make_tree]
} -body {
	set entries [rio::fs::listdir $::tree]
	set names {} ; set types {}
	foreach e $entries { lappend names [dict get $e name]; lappend types [dict get $e type] }
	list $names $types
} -cleanup { file delete -force $::tree } \
  -result {{.hidden a.txt b.txt src} {file file file dir}}

test fs-list-excludes-dot-dotdot {. and .. are never entries} -setup {
	set ::tree [make_tree]
} -body {
	set names {}
	foreach e [rio::fs::listdir $::tree] { lappend names [dict get $e name] }
	expr {"." ni $names && ".." ni $names}
} -cleanup { file delete -force $::tree } -result 1

# --- through the in-process core --------------------------------------------

test project-op-open-and-get {project.open replies {root}, emits project.opened, project.get reads it back} -setup {
	set ::tree [make_tree]
} -body {
	set call [rio::core::call project.open [dict create path $::tree]]
	set resp [dict get $call response]
	set evs  [dict get $call events]
	set root [dict get $resp result root]
	set got  [dict get [dict get [rio::core::call project.get {}] response] result root]
	list [dict get $resp ok] [expr {$root eq [file normalize $::tree]}] \
		[dict get [lindex $evs 0] event] [expr {[dict get [lindex $evs 0] params root] eq $root}] \
		[expr {$got eq $root}]
} -cleanup { rio::project::close; file delete -force $::tree } \
  -result {true 1 project.opened 1 1}

test fs-list-op-defaults-to-root {fs.list with no path lists the open project root} -setup setup_proj -body {
	set resp [dict get [rio::core::call fs.list {}] response]
	set names {}
	foreach e [dict get $resp result entries] { lappend names [dict get $e name] }
	list [dict get $resp ok] [expr {[dict get $resp result path] eq [file normalize $::tree]}] $names
} -cleanup teardown_proj -result {true 1 {.hidden a.txt b.txt src}}

test fs-list-op-relative-subdir {fs.list resolves a relative subdir against the root} -setup setup_proj -body {
	set resp [dict get [rio::core::call fs.list [dict create path src]] response]
	list [dict get $resp ok] [expr {[dict get $resp result path] eq [file normalize [file join $::tree src]]}] \
		[llength [dict get $resp result entries]]
} -cleanup teardown_proj -result {true 1 0}

test fs-list-op-not-a-directory {fs.list on a file raises io_error} -setup setup_proj -body {
	set resp [dict get [rio::core::call fs.list [dict create path a.txt]] response]
	list [dict get $resp ok] [dict get $resp error code]
} -cleanup teardown_proj -result {false io_error}

test project-ops-registered {project.open, project.get, project.search, fs.list are in the live registry} -body {
	expr {"project.open" in [rio::dispatch::opnames] \
		&& "project.get" in [rio::dispatch::opnames] \
		&& "project.search" in [rio::dispatch::opnames] \
		&& "fs.list" in [rio::dispatch::opnames]}
} -result 1

# --- find in files (rio::project::search, D51) ------------------------------
# A tree with the needle spread across files, subdirs, a .git/ dir (must be
# skipped), a binary file (a NUL — must be skipped), and case variation.
proc make_search_tree {} {
	set d [file join [::tcltest::temporaryDirectory] riosearch-[clock clicks]]
	file mkdir [file join $d src]
	file mkdir [file join $d .git]
	set f [open [file join $d a.txt] w]
	puts -nonewline $f "alpha needle\nplain line\nneedle needle again\n" ; close $f
	set f [open [file join $d src b.txt] w]
	puts -nonewline $f "no hit here\na NEEDLE upper\n" ; close $f
	set f [open [file join $d .git config] w]
	puts -nonewline $f "needle in git should be skipped\n" ; close $f
	set f [open [file join $d bin.dat] wb]
	puts -nonewline $f "needle\x00needle\n" ; close $f
	return $d
}
proc setup_search {} { set ::stree [make_search_tree]; rio::project::open $::stree }
proc teardown_search {} { rio::project::close; file delete -force $::stree }

test search-groups-by-file {case-sensitive search groups matching lines by file, root skipped .git} -setup setup_search -body {
	set r [rio::project::search needle 0 0]
	set rels {} ; foreach f [dict get $r results] { lappend rels [dict get $f rel] }
	# a.txt: lines 1 and 3 match (case-sensitive, so "NEEDLE" in src/b.txt does not);
	# .git/ and the binary file are skipped.
	list [dict get $r files] $rels \
		[llength [dict get [lindex [dict get $r results] 0] matches]]
} -cleanup teardown_search -result {1 a.txt 2}

test search-counts-occurrences {count totals every hit, not just matching lines} -setup setup_search -body {
	# a.txt has "needle" x3 (line 1 once, line 3 twice) across 2 rows.
	dict get [rio::project::search needle 0 0] count
} -cleanup teardown_search -result 3

test search-nocase {a case-insensitive search also finds the upper-case hit in the subdir} -setup setup_search -body {
	set r [rio::project::search needle 1 0]
	set rels {} ; foreach f [dict get $r results] { lappend rels [dict get $f rel] }
	list [dict get $r files] [lsort $rels]
} -cleanup teardown_search -result {2 {a.txt src/b.txt}}

test search-match-fields {a match row carries 1-based line/col, every hit's cols, and the text} -setup setup_search -body {
	set r [rio::project::search needle 0 0]
	set ms [dict get [lindex [dict get $r results] 0] matches]
	set m0 [lindex $ms 0] ; set m1 [lindex $ms 1]
	# line 1 has one hit at col 7; line 3 ("needle needle again") has two, cols 1 and 8.
	list [dict get $m0 line] [dict get $m0 col] [dict get $m0 cols] [dict get $m0 text] \
		[dict get $m1 cols]
} -cleanup teardown_search -result {1 7 7 {alpha needle} {1 8}}

test search-wholeword {whole-word skips a hit embedded in a larger word} -setup {
	set ::stree [make_search_tree]
	set f [open [file join $::stree c.txt] w]
	puts -nonewline $f "needle\nneedles pin\na needle.\n" ; close $f
	rio::project::open $::stree
} -body {
	# c.txt rows in each mode. Plain: all three lines (needle, needleS, needle.).
	# Whole-word: "needles" is skipped; "needle" and "needle." (a dot is a boundary) match.
	proc crows {ww} {
		set r [rio::project::search needle 0 $ww]
		foreach fdict [dict get $r results] {
			if {[dict get $fdict rel] eq "c.txt"} { return [llength [dict get $fdict matches]] }
		}
		return 0
	}
	list [crows 0] [crows 1]
} -cleanup teardown_search -result {3 2}

test search-no-project {searching with no project open raises bad_request} -body {
	rio::project::close
	catch {rio::project::search needle 0 0} m opts
	rio::error::code_of $opts
} -result bad_request

test search-empty-needle {an empty needle raises bad_request} -setup setup_search -body {
	catch {rio::project::search "" 0 0} m opts
	rio::error::code_of $opts
} -cleanup teardown_search -result bad_request

test search-op {project.search through the core replies with the grouped result} -setup setup_search -body {
	set resp [dict get [rio::core::call project.search [dict create needle needle]] response]
	list [dict get $resp ok] [dict get $resp result count] [dict get $resp result files]
} -cleanup teardown_search -result {true 3 1}

test search-op-empty-needle {project.search with no needle raises bad_request} -setup setup_search -body {
	set resp [dict get [rio::core::call project.search {}] response]
	list [dict get $resp ok] [dict get $resp error code]
} -cleanup teardown_search -result {false bad_request}

test search-wire {project.search encodes the two-level result (with the cols array) to JSON} -body {
	set result [dict create count 2 files 1 truncated 0 results \
		[list [dict create path /p/a.txt rel a.txt matches \
			[list [dict create line 3 col 1 cols {1 8} text {needle needle}]]]]]
	rio::wire::response [dict create id 1 ok true op project.search result $result]
} -result {{"id":"1","ok":true,"result":{"count":"2","files":"1","truncated":"0","results":[{"path":"/p/a.txt","rel":"a.txt","matches":[{"line":"3","col":"1","cols":["1","8"],"text":"needle needle"}]}]}}}

# --- replace in files (rio::ops::project_replace, D52 Phase B) ---------------
# A tree with a token across a closed file and (in the open-buffer test) a file
# opened as a buffer, to exercise both arms: disk rewrite vs in-buffer replace.
proc make_replace_tree {} {
	set d [file join [::tcltest::temporaryDirectory] riorepl-[clock clicks]]
	file mkdir $d
	set f [open [file join $d a.txt] w] ; puts -nonewline $f "cat and cat\n" ; close $f
	set f [open [file join $d b.txt] w] ; puts -nonewline $f "one cat here\n" ; close $f
	return $d
}

test project-replace-disk {closed files are rewritten on disk; count/files + fs.changed} -setup {
	set ::rtree [make_replace_tree] ; rio::project::open $::rtree
} -body {
	set call [rio::core::call project.replace [dict create needle cat text dog]]
	set r [dict get [dict get $call response] result]
	set evs {} ; foreach e [dict get $call events] { lappend evs [dict get $e event] }
	set a [dict get [rio::fs::read [file join $::rtree a.txt]] text]
	set b [dict get [rio::fs::read [file join $::rtree b.txt]] text]
	# a.txt 2 hits + b.txt 1 = 3 across 2 disk files, no open buffers; two fs.changed.
	list [dict get $r count] [dict get $r files] [dict get $r bufferids] \
		[lsort -unique $evs] $a $b
} -cleanup { rio::project::close ; file delete -force $::rtree } \
  -result [list 3 2 {} fs.changed "dog and dog\n" "one dog here\n"]

test project-replace-open-buffer {an OPEN file is replaced through its buffer, disk untouched} -setup {
	set ::rtree [make_replace_tree] ; rio::project::open $::rtree
} -body {
	set open [dict get [dict get [rio::core::call file.open \
		[dict create path [file join $::rtree a.txt]]] response] result]
	set aid [dict get $open buffer]
	set call [rio::core::call project.replace [dict create needle cat text dog]]
	set r [dict get [dict get $call response] result]
	set evs {} ; foreach e [dict get $call events] { lappend evs [dict get $e event] }
	# a.txt via the buffer (unsaved: disk still "cat"), b.txt via disk. count 3,
	# 1 disk file, bufferids = [a's id]; events carry both a buffer.changed and an fs.changed.
	list [dict get $r count] [dict get $r files] \
		[expr {[dict get $r bufferids] eq $aid}] [lsort -unique $evs] \
		[rio::doc::text $aid] \
		[dict get [rio::fs::read [file join $::rtree a.txt]] text] \
		[dict get [rio::fs::read [file join $::rtree b.txt]] text]
} -cleanup { rio::doc::close $aid ; rio::project::close ; file delete -force $::rtree } \
  -result [list 3 1 1 {buffer.changed fs.changed} "dog and dog\n" "cat and cat\n" "one dog here\n"]

test project-replace-wholeword {the wholeword flag reaches the replace} -setup {
	set ::rtree [file join [::tcltest::temporaryDirectory] riorepl-[clock clicks]]
	file mkdir $::rtree
	set f [open [file join $::rtree w.txt] w] ; puts -nonewline $f "cat cats cat\n" ; close $f
	rio::project::open $::rtree
} -body {
	rio::core::call project.replace [dict create needle cat text dog wholeword 1]
	dict get [rio::fs::read [file join $::rtree w.txt]] text
} -cleanup { rio::project::close ; file delete -force $::rtree } -result "dog cats dog\n"

test project-replace-needs-text {a missing replacement text is a bad_request} -setup setup_search -body {
	set resp [dict get [rio::core::call project.replace [dict create needle needle]] response]
	list [dict get $resp ok] [dict get $resp error code]
} -cleanup teardown_search -result {false bad_request}

test project-replace-empty-needle {an empty needle is a bad_request} -setup setup_search -body {
	set resp [dict get [rio::core::call project.replace [dict create needle "" text x]] response]
	list [dict get $resp ok] [dict get $resp error code]
} -cleanup teardown_search -result {false bad_request}

test project-replace-registered {project.replace is in the live registry} -body {
	expr {"project.replace" in [rio::dispatch::opnames]}
} -result 1

test project-replace-wire {project.replace encodes count/files + a bufferids array} -body {
	set result [dict create count 3 files 1 bufferids {7 9}]
	rio::wire::response [dict create id 1 ok true op project.replace result $result]
} -result {{"id":"1","ok":true,"result":{"count":"3","files":"1","bufferids":["7","9"]}}}

test fs-list-wire {fs.list encodes to JSON with path + an entries array} -body {
	set result [dict create path /p entries \
		[list [dict create name a.txt type file] [dict create name src type dir]]]
	rio::wire::response [dict create id 1 ok true op fs.list result $result]
} -result {{"id":"1","ok":true,"result":{"path":"/p","entries":[{"name":"a.txt","type":"file"},{"name":"src","type":"dir"}]}}}

cleanupTests
