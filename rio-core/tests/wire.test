# Tests for the JSON wire encoder (rio::wire) — shape-aware encoding (D11),
# including round-trips back through tcllib's parser.
package require tcltest
namespace import ::tcltest::*
package require json

source [file join [file dirname [info script]] .. wire.tcl]

test wire-str-plain {a plain string} -body {
	rio::wire::str hello
} -result {"hello"}

test wire-str-escapes {quotes, backslashes, newlines, tabs are escaped} -body {
	rio::wire::str "a\"b\\c\nd\te"
} -result {"a\"b\\c\nd\te"}

test wire-str-controls {raw C0 controls are \u-escaped (RFC 8259: all of 0x00-0x1F)} -body {
	# ESC (0x1b), unit separator (0x1f), vertical tab (0x0b), backspace, formfeed —
	# the kinds of bytes an opened log/data file carries. A strict (non-tcllib)
	# JSON parser rejects a line holding any of them raw.
	rio::wire::str "a\x1bb\x1fc\x0bd\be\ff"
} -result {"a\u001bb\u001fc\u000bd\be\ff"}

test wire-str-controls-roundtrip {control characters survive encode -> json2dict} -body {
	set payload "esc\x1b us\x1f vt\x0b nul\x00 end"
	set enc [rio::wire::event [dict create event buffer.changed \
		params [dict create text $payload]]]
	expr {[dict get [json::json2dict $enc] params text] eq $payload}
} -result 1

# --- the two-tier escape, held to the one-tier map it replaced ------------------
#
# `str` used to run one 34-pair `string map` over every value on the wire. It now asks
# one regexp whether the value contains any of the twenty-nine rare C0 controls, and runs
# either that same 34-pair map or a five-pair one over a value proven not to need the
# rest. Cheaper (56 -> 20 ms/MB) and, because the two maps never both run, equivalent for
# a reason that fits in a sentence — but "equivalent" is a claim about every possible
# string, so it is checked against the original over every string short enough to
# enumerate and a corpus of ones that are not.

# The single-map implementation, verbatim, as the oracle.
proc str_reference {s} {
	set m [list \\ \\\\ \" \\\"]
	for {set c 0} {$c < 32} {incr c} {
		switch -- $c {
			8       { lappend m \b \\b }
			9       { lappend m \t \\t }
			10      { lappend m \n \\n }
			12      { lappend m \f \\f }
			13      { lappend m \r \\r }
			default { lappend m [format %c $c] [format {\u%04x} $c] }
		}
	}
	return "\"[string map $m $s]\""
}

test wire-str-differential-1 {every single character encodes as it did before} -body {
	set bad {}
	for {set c 0} {$c < 256} {incr c} {
		set s [format %c $c]
		if {[rio::wire::str $s] ne [str_reference $s]} { lappend bad $c }
	}
	return $bad
} -result {}

test wire-str-differential-2 {every two-character string over the control-heavy alphabet} -body {
	# 0x00-0x1f (every control), the two metacharacters, and a few ordinary characters —
	# 40 x 40, so the pair where a rare control sits BESIDE a quote or a backslash, which
	# is where a two-map split would go wrong if the guard were misjudged, is covered
	# exhaustively rather than sampled.
	set alphabet {}
	for {set c 0} {$c < 32} {incr c} { lappend alphabet [format %c $c] }
	foreach ch {\\ \" a " " é 😀} { lappend alphabet $ch }
	set bad {}
	foreach a $alphabet {
		foreach b $alphabet {
			set s $a$b
			if {[rio::wire::str $s] ne [str_reference $s]} {
				lappend bad [list [scan $a %c] [scan $b %c]]
			}
		}
	}
	return $bad
} -result {}

test wire-str-differential-3 {random strings mixing controls, quotes and astral characters} -body {
	set alphabet [list \\ \" a b " " \n \t \r \x00 \x1b \x1f \x0b \b \f é 😀 ÿ]
	set seed 20260921
	set bad {}
	for {set i 0} {$i < 2000} {incr i} {
		set s ""
		set n [expr {$i % 30 + 1}]
		for {set j 0} {$j < $n} {incr j} {
			set seed [expr {($seed * 1103515245 + 12345) & 0x7fffffff}]
			append s [lindex $alphabet [expr {$seed % [llength $alphabet]}]]
		}
		if {[rio::wire::str $s] ne [str_reference $s]} { lappend bad $i }
	}
	return $bad
} -result {}

test wire-str-differential-4 {a document-sized value, with and without a control} -body {
	set doc ""
	for {set i 0} {$i < 2000} {incr i} {
		append doc "set x \[expr {\$a + \$b}\] ;# a \"quoted\" line, one \\ backslash\n"
	}
	set withctl [string replace $doc 5000 5000 \x1b]
	list [expr {[rio::wire::str $doc] eq [str_reference $doc]}] \
	     [expr {[rio::wire::str $withctl] eq [str_reference $withctl]}]
} -result {1 1}

test wire-obj-flat {a flat dict becomes an object of string values} -body {
	rio::wire::obj {start 1.0 end 1.0 text X}
} -result {{"start":"1.0","end":"1.0","text":"X"}}

test wire-obj-empty {an empty dict is an empty object} -body {
	rio::wire::obj {}
} -result "{}"

test wire-response-ok {an ok response carries a bare-true ok and an object result} -body {
	rio::wire::response {id 7 ok true result {text hi}}
} -result {{"id":"7","ok":true,"result":{"text":"hi"}}}

test wire-response-error {an error response carries bare-false ok and a {code,message} object} -body {
	rio::wire::response {id 7 ok false error {code unknown_op message {unknown op: nope}}}
} -result {{"id":"7","ok":false,"error":{"code":"unknown_op","message":"unknown op: nope"}}}

test wire-event {an event encodes its name and params} -body {
	rio::wire::event {event buffer.changed params {start 1.0 end 1.0 text X removed {}}}
} -result {{"event":"buffer.changed","params":{"start":"1.0","end":"1.0","text":"X","removed":""}}}

test wire-roundtrip-response {encode -> json2dict recovers the fields} -body {
	set enc [rio::wire::response {id 42 ok true result {text {hi there}}}]
	set d [json::json2dict $enc]
	list [dict get $d id] [dict get $d ok] [dict get $d result text]
} -result {42 true {hi there}}

test wire-roundtrip-tricky-text {text with quotes/newlines survives the round-trip} -body {
	set payload "say \"hi\"\nline2\tend"
	set enc [rio::wire::event [dict create event buffer.changed \
		params [dict create text $payload]]]
	dict get [json::json2dict $enc] params text
} -result "say \"hi\"\nline2\tend"

# --- arrays / non-flat results (D25) -----------------------------------------

test wire-arr {arr joins encoded fragments into a JSON array} -body {
	rio::wire::arr [list [rio::wire::obj {a 1}] [rio::wire::obj {b 2}]]
} -result {[{"a":"1"},{"b":"2"}]}

test wire-arr-empty {an empty array} -body {
	rio::wire::arr {}
} -result {[]}

test wire-result-buffer-list {buffer.list shapes its result as an array of objects} -body {
	rio::wire::response [dict create id 3 ok true op buffer.list \
		result [dict create buffers [list \
			[dict create buffer 1 name a path "" linecount 2] \
			[dict create buffer 2 name b path /x linecount 9]]]]
} -result {{"id":"3","ok":true,"result":{"buffers":[{"buffer":"1","name":"a","path":"","linecount":"2"},{"buffer":"2","name":"b","path":"/x","linecount":"9"}]}}}

test wire-result-buffer-matches {buffer.matches shapes count + an array of ranges} -body {
	rio::wire::response [dict create id 6 ok true op buffer.matches \
		result [dict create count 2 matches [list \
			[dict create start 1.1 end 1.2] \
			[dict create start 1.3 end 1.4]]]]
} -result {{"id":"6","ok":true,"result":{"count":"2","matches":[{"start":"1.1","end":"1.2"},{"start":"1.3","end":"1.4"}]}}}

test wire-result-buffer-matches-empty {zero matches encode as an empty array} -body {
	rio::wire::response [dict create id 7 ok true op buffer.matches \
		result [dict create count 0 matches {}]]
} -result {{"id":"7","ok":true,"result":{"count":"0","matches":[]}}}

test wire-result-buffers-stale {buffers.stale shapes an array of flat objects (D94)} -body {
	rio::wire::response [dict create id 8 ok true op buffers.stale \
		result [dict create stale [list \
			[dict create buffer 1 path /x/a.txt gone 0] \
			[dict create buffer 2 path /x/b.txt gone 1]]]]
} -result {{"id":"8","ok":true,"result":{"stale":[{"buffer":"1","path":"/x/a.txt","gone":"0"},{"buffer":"2","path":"/x/b.txt","gone":"1"}]}}}

test wire-result-buffers-stale-empty {nothing stale encodes as an empty array} -body {
	rio::wire::response [dict create id 9 ok true op buffers.stale result [dict create stale {}]]
} -result {{"id":"9","ok":true,"result":{"stale":[]}}}

test wire-result-buffers-reload {buffers.reload shapes both arrays, reloaded and failed} -body {
	rio::wire::response [dict create id 10 ok true op buffers.reload \
		result [dict create \
			reloaded [list [dict create buffer 1 path /x/a.txt encoding utf-8 eol lf linecount 3]] \
			failed   [list [dict create buffer 2 message {no such file}]]]]
} -result {{"id":"10","ok":true,"result":{"reloaded":[{"buffer":"1","path":"/x/a.txt","encoding":"utf-8","eol":"lf","linecount":"3"}],"failed":[{"buffer":"2","message":"no such file"}]}}}

test wire-result-flat-default {an op without a registered shape stays a flat object} -body {
	rio::wire::response {id 4 ok true op buffer.text result {text hi}}
} -result {{"id":"4","ok":true,"result":{"text":"hi"}}}

test wire-result-no-op {a response without op falls back to a flat object} -body {
	rio::wire::response {id 5 ok true result {text hi}}
} -result {{"id":"5","ok":true,"result":{"text":"hi"}}}

test wire-roundtrip-buffer-list {the encoded buffer.list survives json2dict} -body {
	set enc [rio::wire::response [dict create id 9 ok true op buffer.list \
		result [dict create buffers [list \
			[dict create buffer 1 name {a b} path "" linecount 2]]]]]
	set d [json::json2dict $enc]
	set b0 [lindex [dict get $d result buffers] 0]
	list [dict get $d ok] [llength [dict get $d result buffers]] \
		[dict get $b0 name] [dict get $b0 linecount]
} -result {true 1 {a b} 2}

test wire-strarr {strarr makes a JSON array of strings} -body {
	rio::wire::strarr {a b c}
} -result {["a","b","c"]}

test wire-strarr-empty {an empty string array} -body {
	rio::wire::strarr {}
} -result {[]}

test wire-result-session-hello {session.hello shapes scalars + an array of op strings} -body {
	rio::wire::response [dict create id 2 ok true op session.hello \
		result [dict create protocol 1 name rio-core version 9.9.9 \
			ops {buffer.text file.open} fsroot /]]
} -result {{"id":"2","ok":true,"result":{"protocol":"1","name":"rio-core","version":"9.9.9","ops":["buffer.text","file.open"],"fsroot":"/"}}}

test wire-roundtrip-session-hello {the encoded hello survives json2dict} -body {
	set enc [rio::wire::response [dict create id 7 ok true op session.hello \
		result [dict create protocol 1 name rio-core version 9.9.9 ops {a b c} fsroot /]]]
	set d [json::json2dict $enc]
	list [dict get $d result protocol] [dict get $d result name] \
		[dict get $d result version] [dict get $d result ops] [dict get $d result fsroot]
} -result {1 rio-core 9.9.9 {a b c} /}

# The release version (D123) is a STRING leaf like the others, not a number: "0.1.0" is
# not a JSON number at all, and a client that read it as one would be wrong the moment a
# pre-release suffix appeared. This is the D25 string-leaf rule earning its keep.
test wire-session-hello-version-string {the version is a string leaf, suffix and all} -body {
	set enc [rio::wire::response [dict create id 9 ok true op session.hello \
		result [dict create protocol 2 name rio-core version 1.0.0-beta.2 ops {a} fsroot /]]]
	list [expr {[string first {"version":"1.0.0-beta.2"} $enc] >= 0}] \
		[dict get [json::json2dict $enc] result version]
} -result {1 1.0.0-beta.2}

test wire-session-hello-windows-fsroot {a Windows core's drive root survives encoding} -body {
	# The drive letter and colon must not need escaping, and the trailing slash stays.
	set enc [rio::wire::response [dict create id 8 ok true op session.hello \
		result [dict create protocol 2 name rio-core version 9.9.9 ops {a} fsroot C:/]]]
	dict get [json::json2dict $enc] result fsroot
} -result {C:/}

# --- nested objects (theme.get; D25) -----------------------------------------

test wire-objmap {objmap encodes each value with the given encoder} -body {
	rio::wire::objmap {a {x 1} b {y 2}} rio::wire::obj
} -result {{"a":{"x":"1"},"b":{"y":"2"}}}

test wire-result-theme-get {theme.get nests a flat colours object + an object of font objects} -body {
	rio::wire::response [dict create id 1 ok true op theme.get \
		result [dict create \
			colors {editor.bg white} \
			fonts {RioEditorFont {family monospace size 12}}]]
} -result {{"id":"1","ok":true,"result":{"colors":{"editor.bg":"white"},"fonts":{"RioEditorFont":{"family":"monospace","size":"12"}}}}}

test wire-roundtrip-theme-get {the encoded theme survives json2dict} -body {
	set enc [rio::wire::response [dict create id 8 ok true op theme.get \
		result [dict create colors {editor.bg #002b36 editor.fg #839496} \
			fonts {RioEditorFont {family mono size 13}}]]]
	set d [json::json2dict $enc]
	list [dict get $d result fonts RioEditorFont size] \
		[dict get $d result colors editor.bg]
} -result {13 #002b36}

test wire-result-diff-lines {diff.lines encodes ops as an array of flat {tag,a,b} objects} -body {
	rio::wire::response [dict create id 3 ok true op diff.lines \
		result [dict create ops [list \
			[dict create tag equal a 1 b 1] \
			[dict create tag delete a 2 b 0] \
			[dict create tag insert a 0 b 2]]]]
} -result {{"id":"3","ok":true,"result":{"ops":[{"tag":"equal","a":"1","b":"1"},{"tag":"delete","a":"2","b":"0"},{"tag":"insert","a":"0","b":"2"}]}}}

test wire-roundtrip-diff-lines {the encoded diff survives json2dict} -body {
	set enc [rio::wire::response [dict create id 4 ok true op diff.lines \
		result [dict create ops [list [dict create tag insert a 0 b 5]]]]]
	set d [json::json2dict $enc]
	list [dict get [lindex [dict get $d result ops] 0] tag] \
		[dict get [lindex [dict get $d result ops] 0] b]
} -result {insert 5}

test wire-result-agent-options {agent.options.list encodes BOTH levels — options and their choices} -body {
	rio::wire::response [dict create id 5 ok true op agent.options.list \
		result [dict create provider claude options [list \
			[dict create name model label Model hint "" value m1 free 1 refresh 1 \
				choices [list [dict create value m1 label "One"] \
				              [dict create value m2 label "Two"]]]]]]
} -result {{"id":"5","ok":true,"result":{"provider":"claude","options":[{"name":"model","label":"Model","hint":"","value":"m1","free":"1","refresh":"1","choices":[{"value":"m1","label":"One"},{"value":"m2","label":"Two"}]}]}}}

test wire-roundtrip-agent-options {the encoded option list survives json2dict} -body {
	set enc [rio::wire::response [dict create id 6 ok true op agent.options.list \
		result [dict create provider openai options [list \
			[dict create name effort label Effort hint "how hard" value high free 0 refresh 0 \
				choices [list [dict create value low label Low] \
				              [dict create value high label High]]]]]]]
	set d [json::json2dict $enc]
	set o [lindex [dict get $d result options] 0]
	list [dict get $o name] [dict get $o value] \
		[dict get [lindex [dict get $o choices] 1] label]
} -result {effort high High}

test wire-result-agent-status {agent.status nests the option summary as an object} -body {
	rio::wire::response [dict create id 7 ok true op agent.status \
		result [dict create provider claude auto_accept 0 mode build key_set 1 \
			options [dict create model m1 effort high]]]
} -result {{"id":"7","ok":true,"result":{"provider":"claude","auto_accept":"0","mode":"build","key_set":"1","options":{"model":"m1","effort":"high"}}}}

test wire-result-agent-status-empty {a provider with no options still shapes as an object} -body {
	set d [json::json2dict [rio::wire::response [dict create id 8 ok true op agent.status \
		result [dict create provider echo auto_accept 0 mode build key_set 0 options {}]]]]
	dict get $d result options
} -result {}

cleanupTests
