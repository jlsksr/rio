# Tests for the JSON wire encoder (rio::wire) — shape-aware encoding (D11),
# including round-trips back through tcllib's parser.
package require tcltest
namespace import ::tcltest::*
package require json

source [file join [file dirname [info script]] .. wire.tcl]

test wire-str-plain {a plain string} -body {
	rio::wire::str hello
} -result {"hello"}

test wire-str-escapes {quotes, backslashes, newlines, tabs are escaped} -body {
	rio::wire::str "a\"b\\c\nd\te"
} -result {"a\"b\\c\nd\te"}

test wire-obj-flat {a flat dict becomes an object of string values} -body {
	rio::wire::obj {start 1.0 end 1.0 text X}
} -result {{"start":"1.0","end":"1.0","text":"X"}}

test wire-obj-empty {an empty dict is an empty object} -body {
	rio::wire::obj {}
} -result "{}"

test wire-response-ok {an ok response carries a bare-true ok and an object result} -body {
	rio::wire::response {id 7 ok true result {text hi}}
} -result {{"id":"7","ok":true,"result":{"text":"hi"}}}

test wire-response-error {an error response carries bare-false ok and a string error} -body {
	rio::wire::response {id 7 ok false error {unknown op: nope}}
} -result {{"id":"7","ok":false,"error":"unknown op: nope"}}

test wire-event {an event encodes its name and params} -body {
	rio::wire::event {event buffer.changed params {start 1.0 end 1.0 text X removed {}}}
} -result {{"event":"buffer.changed","params":{"start":"1.0","end":"1.0","text":"X","removed":""}}}

test wire-roundtrip-response {encode -> json2dict recovers the fields} -body {
	set enc [rio::wire::response {id 42 ok true result {text {hi there}}}]
	set d [json::json2dict $enc]
	list [dict get $d id] [dict get $d ok] [dict get $d result text]
} -result {42 true {hi there}}

test wire-roundtrip-tricky-text {text with quotes/newlines survives the round-trip} -body {
	set payload "say \"hi\"\nline2\tend"
	set enc [rio::wire::event [dict create event buffer.changed \
		params [dict create text $payload]]]
	dict get [json::json2dict $enc] params text
} -result "say \"hi\"\nline2\tend"

# --- arrays / non-flat results (D25) -----------------------------------------

test wire-arr {arr joins encoded fragments into a JSON array} -body {
	rio::wire::arr [list [rio::wire::obj {a 1}] [rio::wire::obj {b 2}]]
} -result {[{"a":"1"},{"b":"2"}]}

test wire-arr-empty {an empty array} -body {
	rio::wire::arr {}
} -result {[]}

test wire-result-buffer-list {buffer.list shapes its result as an array of objects} -body {
	rio::wire::response [dict create id 3 ok true op buffer.list \
		result [dict create buffers [list \
			[dict create buffer 1 name a path "" linecount 2] \
			[dict create buffer 2 name b path /x linecount 9]]]]
} -result {{"id":"3","ok":true,"result":{"buffers":[{"buffer":"1","name":"a","path":"","linecount":"2"},{"buffer":"2","name":"b","path":"/x","linecount":"9"}]}}}

test wire-result-flat-default {an op without a registered shape stays a flat object} -body {
	rio::wire::response {id 4 ok true op buffer.text result {text hi}}
} -result {{"id":"4","ok":true,"result":{"text":"hi"}}}

test wire-result-no-op {a response without op falls back to a flat object} -body {
	rio::wire::response {id 5 ok true result {text hi}}
} -result {{"id":"5","ok":true,"result":{"text":"hi"}}}

test wire-roundtrip-buffer-list {the encoded buffer.list survives json2dict} -body {
	set enc [rio::wire::response [dict create id 9 ok true op buffer.list \
		result [dict create buffers [list \
			[dict create buffer 1 name {a b} path "" linecount 2]]]]]
	set d [json::json2dict $enc]
	set b0 [lindex [dict get $d result buffers] 0]
	list [dict get $d ok] [llength [dict get $d result buffers]] \
		[dict get $b0 name] [dict get $b0 linecount]
} -result {true 1 {a b} 2}

test wire-strarr {strarr makes a JSON array of strings} -body {
	rio::wire::strarr {a b c}
} -result {["a","b","c"]}

test wire-strarr-empty {an empty string array} -body {
	rio::wire::strarr {}
} -result {[]}

test wire-result-session-hello {session.hello shapes scalars + an array of op strings} -body {
	rio::wire::response [dict create id 2 ok true op session.hello \
		result [dict create protocol 1 name rio-core ops {buffer.text file.open}]]
} -result {{"id":"2","ok":true,"result":{"protocol":"1","name":"rio-core","ops":["buffer.text","file.open"]}}}

test wire-roundtrip-session-hello {the encoded hello survives json2dict} -body {
	set enc [rio::wire::response [dict create id 7 ok true op session.hello \
		result [dict create protocol 1 name rio-core ops {a b c}]]]
	set d [json::json2dict $enc]
	list [dict get $d result protocol] [dict get $d result name] \
		[dict get $d result ops]
} -result {1 rio-core {a b c}}

cleanupTests
