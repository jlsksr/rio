# Tests for the JSON wire encoder (rio::wire) — shape-aware encoding (D11),
# including round-trips back through tcllib's parser.
package require tcltest
namespace import ::tcltest::*
package require json

source [file join [file dirname [info script]] .. wire.tcl]

test wire-str-plain {a plain string} -body {
	rio::wire::str hello
} -result {"hello"}

test wire-str-escapes {quotes, backslashes, newlines, tabs are escaped} -body {
	rio::wire::str "a\"b\\c\nd\te"
} -result {"a\"b\\c\nd\te"}

test wire-obj-flat {a flat dict becomes an object of string values} -body {
	rio::wire::obj {start 1.0 end 1.0 text X}
} -result {{"start":"1.0","end":"1.0","text":"X"}}

test wire-obj-empty {an empty dict is an empty object} -body {
	rio::wire::obj {}
} -result "{}"

test wire-response-ok {an ok response carries a bare-true ok and an object result} -body {
	rio::wire::response {id 7 ok true result {text hi}}
} -result {{"id":"7","ok":true,"result":{"text":"hi"}}}

test wire-response-error {an error response carries bare-false ok and a string error} -body {
	rio::wire::response {id 7 ok false error {unknown op: nope}}
} -result {{"id":"7","ok":false,"error":"unknown op: nope"}}

test wire-event {an event encodes its name and params} -body {
	rio::wire::event {event buffer.changed params {start 1.0 end 1.0 text X removed {}}}
} -result {{"event":"buffer.changed","params":{"start":"1.0","end":"1.0","text":"X","removed":""}}}

test wire-roundtrip-response {encode -> json2dict recovers the fields} -body {
	set enc [rio::wire::response {id 42 ok true result {text {hi there}}}]
	set d [json::json2dict $enc]
	list [dict get $d id] [dict get $d ok] [dict get $d result text]
} -result {42 true {hi there}}

test wire-roundtrip-tricky-text {text with quotes/newlines survives the round-trip} -body {
	set payload "say \"hi\"\nline2\tend"
	set enc [rio::wire::event [dict create event buffer.changed \
		params [dict create text $payload]]]
	dict get [json::json2dict $enc] params text
} -result "say \"hi\"\nline2\tend"

cleanupTests
