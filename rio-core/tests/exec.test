# Tests for the command-execution primitive (rio::exec, AGENTS.md D15) and the
# exec.run op driven through the in-process core. The subject under test is
# tclsh itself (info nameofexecutable) so the suite needs no /bin/sh or coreutils
# and runs the same on every platform: a script is fed on the child's stdin, or
# written to a temp file when we also need to exercise stdin passthrough.
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. error.tcl]
source [file join [file dirname [info script]] .. exec.tcl]
source [file join [file dirname [info script]] .. core.tcl]

set ::tcl [info nameofexecutable]

# The child under test is tclsh itself, and a Tcl child's stdout/stderr default to the
# PLATFORM line-ending convention — CRLF on Windows. rio::exec::run captures the child's
# bytes faithfully by design (no EOL translation, the D22 ethos), so a test that expects
# bare LF without pinning the child's translation is asserting the platform's stdio
# convention rather than rio's capture fidelity. Pin it in the child; the assertions below
# then mean the same thing everywhere.
set ::lf {fconfigure stdout -translation lf; fconfigure stderr -translation lf; }

test exec-run-stdout {captures stdout and a zero exit} -body {
	set r [rio::exec::run [list $::tcl] "" "$::lf puts hello"]
	list [dict get $r exitcode] [dict get $r stdout] [dict get $r stderr]
} -result {0 {hello
} {}}

test exec-run-exitcode {a non-zero exit is a successful op; the code is data} -body {
	set r [rio::exec::run [list $::tcl] "" "exit 3"]
	list [dict get $r exitcode] [dict get $r stdout]
} -result {3 {}}

test exec-run-stderr-separate {stdout and stderr are captured on separate streams} -body {
	set r [rio::exec::run [list $::tcl] "" "$::lf puts out; puts stderr oops"]
	list [dict get $r stdout] [dict get $r stderr]
} -result {{out
} {oops
}}

test exec-run-stdin {stdin is passed through to the child} -setup {
	set ::sp [file join [::tcltest::temporaryDirectory] exec-stdin.tcl]
	set f [open $::sp w]
	puts $f $::lf
	puts $f {puts [string toupper [read stdin]]}
	close $f
} -body {
	set r [rio::exec::run [list $::tcl $::sp] "" "abc"]
	dict get $r stdout
} -cleanup {
	file delete $::sp
} -result {ABC
}

test exec-run-cwd {the command runs in the requested working directory} -setup {
	set ::wd [file join [::tcltest::temporaryDirectory] exec-cwd]
	file mkdir $::wd
} -body {
	set r [rio::exec::run [list $::tcl] $::wd "puts \[pwd\]"]
	expr {[file normalize [string trim [dict get $r stdout]]] eq [file normalize $::wd]}
} -cleanup {
	file delete -force $::wd
} -result 1

test exec-run-empty-argv {an empty argv is a bad_request} -body {
	catch {rio::exec::run {}} e opts
	list [rio::error::code_of $opts] $e
} -result {bad_request {exec.run requires a non-empty argv}}

test exec-run-bad-cwd {a missing working directory is an io_error} -body {
	catch {rio::exec::run [list $::tcl] /no/such/dir/here "puts hi"} e opts
	rio::error::code_of $opts
} -result io_error

test exec-run-launch-failure {failing to launch the command is an io_error} -body {
	catch {rio::exec::run [list rio-no-such-command-xyzzy]} e opts
	rio::error::code_of $opts
} -result io_error

# --- through the in-process core --------------------------------------------

test exec-op-run {exec.run op returns the capture shape} -body {
	set r [rio::core::call exec.run [dict create argv [list $::tcl] stdin "$::lf puts hi"]]
	set resp [dict get $r response]
	list [dict get $resp ok] [dict get $resp result exitcode] \
		[dict get $resp result stdout]
} -result {true 0 {hi
}}

test exec-op-missing-argv {exec.run without argv is a bad_request} -body {
	set resp [dict get [rio::core::call exec.run {}] response]
	list [dict get $resp ok] [dict get $resp error code]
} -result {false bad_request}

test exec-op-registered {exec.run shows up in the live op registry} -body {
	expr {"exec.run" in [rio::dispatch::opnames]}
} -result 1

# --- async spawn (rio::exec::start, D83) -------------------------------------
# The callback stores its result in ::done; vwait pumps the event loop until it
# fires. Same tclsh-as-child trick as run, so no /bin/sh is needed.

test exec-start-stdout {async start captures stdout and a zero exit} -body {
	set ::done ""
	rio::exec::start [list $::tcl] "" "$::lf puts hello" 0 [list set ::done]
	vwait ::done
	list [dict get $::done exitcode] [dict get $::done stdout] [dict get $::done timedout]
} -result {0 {hello
} 0}

test exec-start-exitcode {async non-zero exit reports the code, not a timeout} -body {
	set ::done ""
	rio::exec::start [list $::tcl] "" "exit 3" 0 [list set ::done]
	vwait ::done
	list [dict get $::done exitcode] [dict get $::done timedout]
} -result {3 0}

test exec-start-stderr {async captures stdout and stderr on separate streams} -body {
	set ::done ""
	rio::exec::start [list $::tcl] "" "$::lf puts out; puts stderr oops" 0 [list set ::done]
	vwait ::done
	list [dict get $::done stdout] [dict get $::done stderr]
} -result {{out
} {oops
}}

# The exit code of a KILLED child is platform-specific, so it is deliberately not
# pinned here: unix reports CHILDKILLED (exitcode -1), but Windows has no signals —
# taskkill /F makes the child exit 1, which arrives as an ordinary CHILDSTATUS.
# `timedout` is the flag that carries the meaning, and format_exec reads it before it
# ever looks at the exit code. What must hold on every host: the child is marked timed
# out, it really was killed (non-zero), and it never got to write.
test exec-start-timeout {a child that overruns its timeout is killed and marked timedout} -body {
	set ::done ""
	rio::exec::start [list $::tcl] "" "after 5000; puts done" 100 [list set ::done]
	vwait ::done
	list [dict get $::done timedout] \
		[expr {[dict get $::done exitcode] != 0}] [dict get $::done stdout]
} -result {1 1 {}}

test exec-start-cwd {async runs in the requested working directory} -setup {
	set ::wd [file join [::tcltest::temporaryDirectory] exec-start-cwd]
	file mkdir $::wd
} -body {
	set ::done ""
	rio::exec::start [list $::tcl] $::wd "puts \[pwd\]" 0 [list set ::done]
	vwait ::done
	expr {[file normalize [string trim [dict get $::done stdout]]] eq [file normalize $::wd]}
} -cleanup {
	file delete -force $::wd
} -result 1

test exec-start-launch-failure {a bad executable reports failure asynchronously, exit -1} -body {
	set ::done ""
	rio::exec::start [list rio-no-such-command-xyzzy] "" "" 0 [list set ::done]
	vwait ::done
	list [dict get $::done exitcode] \
		[expr {[dict exists $::done error] || [string length [dict get $::done stderr]] > 0}]
} -result {-1 1}

test exec-start-empty-argv {start with an empty argv is a bad_request} -body {
	catch {rio::exec::start {} "" "" 0 [list set ::done]} e opts
	rio::error::code_of $opts
} -result bad_request

test exec-start-bad-cwd {start with a missing working directory is an io_error} -body {
	catch {rio::exec::start [list $::tcl] /no/such/dir/here "puts hi" 0 [list set ::done]} e opts
	rio::error::code_of $opts
} -result io_error

test exec-start-cancel {cancel kills the child and fires NO callback} -body {
	set ::done SENTINEL
	set tok [rio::exec::start [list $::tcl] "" "after 5000" 0 [list set ::done]]
	rio::exec::cancel $tok
	after 200 {set ::wake 1} ; vwait ::wake
	set ::done
} -result SENTINEL

cleanupTests
