# Tests for file I/O — encoding / BOM / line-ending detection and preservation
# (rio::fs, AGENTS.md D22), plus the fs.* ops driven through the in-process core.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. fs.tcl]
source [file join [file dirname [info script]] .. core.tcl]

# Write raw bytes to a throwaway file; return its path.
proc tmpbytes {bytes} {
	set f [file tempfile path]
	fconfigure $f -translation binary
	puts -nonewline $f $bytes
	close $f
	return $path
}
# Read a file back as raw bytes.
proc rawbytes {path} {
	set f [open $path rb]
	set b [::read $f]
	close $f
	return $b
}

# --- detection (rio::fs::read) ----------------------------------------------

test fs-read-lf-utf8 {a plain LF UTF-8 file} -body {
	set p [tmpbytes "alpha\nbeta\n"]
	set d [rio::fs::read $p]
	list [dict get $d encoding] [dict get $d eol] [dict get $d bom] \
		[dict get $d mixed] [dict get $d text]
} -result {utf-8 lf {} 0 {alpha
beta
}}

test fs-read-crlf {CRLF is detected and normalized to \n for the model} -body {
	set p [tmpbytes "a\r\nb\r\n"]
	set d [rio::fs::read $p]
	list [dict get $d eol] [dict get $d text]
} -result {crlf {a
b
}}

test fs-read-multibyte {valid multibyte UTF-8 is decoded, not byte-fallback} -body {
	# "café" + a CJK char, UTF-8 bytes.
	set p [tmpbytes "caf\xC3\xA9 \xE6\x97\xA5\n"]
	set d [rio::fs::read $p]
	list [dict get $d encoding] [dict get $d text]
# The input above must be \x escapes \u2014 it is a BYTE string, not text, which is the whole
# point of the test. The expected value need not be: the D54 guard at the top re-reads
# this file as UTF-8, so a literal would decode correctly on a cp1252 host too. It is
# written as \u anyway, to say which codepoints the bytes above are meant to become
# (\u00e9 = e-acute, \u65e5 = the CJK char).
} -result "utf-8 {caf\u00e9 \u65e5\n}"

test fs-read-bom {a UTF-8 BOM is detected, stripped from text, and recorded} -body {
	set p [tmpbytes "\xEF\xBB\xBFhi\n"]
	set d [rio::fs::read $p]
	list [dict get $d bom] [dict get $d encoding] [dict get $d text]
} -result "utf-8 utf-8 {hi\n}"

test fs-read-invalid-utf8 {invalid UTF-8 falls back to lossless iso8859-1} -body {
	# 0xFF is never valid UTF-8; iso8859-1 maps it to U+00FF.
	set p [tmpbytes "x\xFFy\n"]
	set d [rio::fs::read $p]
	dict get $d encoding
} -result iso8859-1

# The well-formedness verdict is decided by re-encoding and comparing bytes (D126).
# That is exact everywhere except one place — a surrogate re-encodes to itself — so the
# surrogate is excluded explicitly, and these cases are what pin that. Each is a form
# that decodes to SOMETHING but is not well-formed UTF-8: the verdict must be the
# byte-preserving iso8859-1 fallback, never a false "utf-8".
test fs-read-overlong-utf8 {an overlong encoding is not UTF-8} -body {
	# \xC0\x80 is a 2-byte spelling of U+0000 — the classic overlong NUL.
	set p [tmpbytes "a\xC0\x80b\n"]
	dict get [rio::fs::read $p] encoding
} -result iso8859-1

test fs-read-surrogate-utf8 {a surrogate (CESU-8) is not UTF-8} -body {
	# \xED\xA0\x80 spells U+D800. It survives a decode/re-encode round trip intact,
	# so it is the one form the round-trip test alone would wrongly accept.
	set p [tmpbytes "a\xED\xA0\x80b\n"]
	dict get [rio::fs::read $p] encoding
} -result iso8859-1

test fs-read-ed-is-not-a-surrogate {0xED below the surrogate range is still UTF-8} -body {
	# \xED\x9F\xBF is U+D7FF — the code point just under the surrogates. The cheap
	# 0xED gate must not reject it (퟿ is the expected decoded character).
	set p [tmpbytes "a\xED\x9F\xBFb\n"]
	set d [rio::fs::read $p]
	list [dict get $d encoding] [dict get $d text]
} -result "utf-8 {a\uD7FFb\n}"

test fs-read-truncated-utf8 {a truncated multibyte sequence is not UTF-8} -body {
	# \xE6\x97 is the first two bytes of a three-byte character.
	set p [tmpbytes "a\xE6\x97\n"]
	dict get [rio::fs::read $p] encoding
} -result iso8859-1

test fs-read-out-of-range-utf8 {a lead byte above U+10FFFF is not UTF-8} -body {
	# \xF5 would start a code point beyond the Unicode range RFC 3629 allows.
	set p [tmpbytes "a\xF5\x80\x80\x80b\n"]
	dict get [rio::fs::read $p] encoding
} -result iso8859-1

test fs-read-astral-utf8 {a four-byte astral character is UTF-8} -body {
	# \xF0\x9F\x98\x80 is U+1F600. The four-byte arm must still be accepted.
	set p [tmpbytes "a\xF0\x9F\x98\x80b\n"]
	dict get [rio::fs::read $p] encoding
} -result utf-8

test fs-read-mixed {mixed endings: dominant chosen and surfaced} -body {
	set p [tmpbytes "a\r\nb\r\nc\n"]
	set d [rio::fs::read $p]
	list [dict get $d eol] [dict get $d mixed]
} -result {crlf 1}

# --- the EOL detection, held to the implementation it replaced ----------------
#
# `rio::fs::read` used to count line endings with two `regexp -all` passes BEFORE
# normalizing, and now derives the CRLF count from the normalization itself and skips the
# second pass entirely when there is no CRLF. That is the one computation in rio whose
# wrong answer corrupts a file in silence — D22's round-trip writes back whatever `eol`
# says — so it is not tested by example. The two-pass original is kept here verbatim as
# the reference, and the answers have to agree over everything awkward: the `crlf >= lf`
# tie, `\r\r\n` (where the pair starts at the SECOND carriage return), a lone CR, a CR or
# a CRLF at EOF, no trailing newline at all, and a few hundred random permutations.

# The two-pass implementation this replaced, verbatim, as the oracle.
proc eol_reference {text} {
	set crlf [regexp -all "\r\n" $text]
	set lf   [expr {[regexp -all "\n" $text] - $crlf}]
	set mixed [expr {$crlf > 0 && $lf > 0}]
	set eol [expr {$crlf > 0 && $crlf >= $lf ? "crlf" : "lf"}]
	set text [string map [list "\r\n" "\n"] $text]
	return [list eol $eol mixed $mixed text $text]
}
# What rio::fs::read answers for the same content, through the real proc and a real file.
proc eol_actual {text} {
	set p [tmpbytes [encoding convertto iso8859-1 $text]]
	set d [rio::fs::read $p]
	file delete $p
	return [list eol [dict get $d eol] mixed [dict get $d mixed] text [dict get $d text]]
}

test fs-eol-differential {every eol verdict agrees with the two-pass original} -body {
	set cases {}
	# the named awkward ones
	foreach c {
		{}  "a"  "a\n"  "a\r\n"  "a\r"  "\r"  "\n"  "\r\n"
		"a\nb\n"  "a\r\nb\r\n"  "a\r\nb\nc\n"  "a\nb\r\nc\n"
		"a\r\nb\n"              "a\n\r\nb"
		"a\r\r\nb"  "\r\r\n"  "\r\r\r\n"  "a\n\rb"  "a\r\n\r\n"
		"no trailing newline"   "a\r\nb\r\nc"   "x\ny\rz\r\nw"
	} { lappend cases $c }
	# the tie: equal numbers of CRLF and bare LF must still answer `crlf`
	lappend cases "a\r\nb\n"  "a\r\nb\r\nc\nd\n"
	# a few hundred random permutations over the alphabet that matters
	set alphabet [list "\r" "\n" "\r\n" "a" "b" " "]
	set seed 20260921
	for {set i 0} {$i < 400} {incr i} {
		set s ""
		set n [expr {$i % 40 + 1}]
		for {set j 0} {$j < $n} {incr j} {
			set seed [expr {($seed * 1103515245 + 12345) & 0x7fffffff}]
			append s [lindex $alphabet [expr {$seed % [llength $alphabet]}]]
		}
		lappend cases $s
	}
	set bad {}
	foreach c $cases {
		set want [eol_reference $c]
		set got  [eol_actual $c]
		if {$got ne $want} { lappend bad [list [string map {\r \\r \n \\n} $c] $got $want] }
	}
	return $bad
} -result {}

# --- disk identity: mtime + size (D94) ---------------------------------------
# What a buffer stamps at open/save and a later stat is compared against, so it can ask
# "did this file change under us?" — the pair, because mtime alone misses a same-second
# rewrite and size alone misses a same-length edit.

test fs-read-reports-identity {read returns the file's mtime and size} -body {
	set p [tmpbytes "alpha\nbeta\n"]
	set d [rio::fs::read $p]
	list [expr {[dict get $d size] == [file size $p]}] \
		[expr {[dict get $d mtime] == [file mtime $p]}]
} -result {1 1}

test fs-stamp-pair {stamp is exactly {mtime size} for a file that is there} -body {
	set p [tmpbytes "x\n"]
	set st [rio::fs::stamp $p]
	list [lsort [dict keys $st]] [dict get $st size]
} -result {{mtime size} 2}

test fs-stamp-gone {a path that is not there has no identity at all} -body {
	set p [tmpbytes "x\n"]
	file delete $p
	rio::fs::stamp $p
} -result {}

test fs-stamp-follows-a-rewrite {a rewrite of a different length changes the stamp} -body {
	set p [tmpbytes "short\n"]
	set before [rio::fs::stamp $p]
	set f [open $p wb] ; puts -nonewline $f "a rather longer line\n" ; close $f
	set after [rio::fs::stamp $p]
	expr {$before ne $after}
} -result 1

# --- round-trips (read -> write reproduces the original bytes) ---------------

test fs-roundtrip-crlf {CRLF bytes survive read+write unchanged} -body {
	set src "one\r\ntwo\r\n"
	set p [tmpbytes $src]
	set d [rio::fs::read $p]
	set out [tmpbytes ""]
	rio::fs::write $out [dict get $d text] \
		[dict create encoding [dict get $d encoding] eol [dict get $d eol] bom [dict get $d bom]]
	rawbytes $out
} -result "one\r\ntwo\r\n"

test fs-roundtrip-bom {a BOM is restored on save} -body {
	set src "\xEF\xBB\xBFhi\n"
	set p [tmpbytes $src]
	set d [rio::fs::read $p]
	set out [tmpbytes ""]
	rio::fs::write $out [dict get $d text] \
		[dict create encoding [dict get $d encoding] eol [dict get $d eol] bom [dict get $d bom]]
	rawbytes $out
} -result "\xEF\xBB\xBFhi\n"

test fs-roundtrip-invalid-bytes {unknown bytes round-trip intact via iso8859-1} -body {
	set src "x\xFFy\n"
	set p [tmpbytes $src]
	set d [rio::fs::read $p]
	set out [tmpbytes ""]
	rio::fs::write $out [dict get $d text] \
		[dict create encoding [dict get $d encoding] eol [dict get $d eol] bom [dict get $d bom]]
	rawbytes $out
} -result "x\xFFy\n"

test fs-roundtrip-no-trailing-newline {a missing final newline is preserved} -body {
	set src "no newline at end"
	set p [tmpbytes $src]
	set d [rio::fs::read $p]
	set out [tmpbytes ""]
	rio::fs::write $out [dict get $d text] {}
	rawbytes $out
} -result {no newline at end}

# --- classify: the cheap look before the expensive read (D125) ----------------

test fs-classify-ok {an ordinary text file passes, and its size is reported} -body {
	set p [tmpbytes "hello\nworld\n"]
	set c [rio::fs::classify $p 8000000]
	list [dict get $c verdict] [dict get $c size]
} -result {ok 12}

test fs-classify-too-large {over the caller's budget is too_large, with the real size} -body {
	set p [tmpbytes [string repeat x 5000]]
	set c [rio::fs::classify $p 4096]
	list [dict get $c verdict] [dict get $c size]
} -result {too_large 5000}

test fs-classify-at-the-limit {exactly the budget is not over it} -body {
	set p [tmpbytes [string repeat x 4096]]
	dict get [rio::fs::classify $p 4096] verdict
} -result ok

test fs-classify-binary {a NUL in the probed prefix is binary} -body {
	set p [tmpbytes "\x7FELF\x02\x01\x01\x00\x00\x00 payload"]
	set c [rio::fs::classify $p 8000000]
	list [dict get $c verdict] [dict get $c size]
} -result {binary 18}

test fs-classify-probe-is-a-prefix {a NUL beyond the probe is NOT seen — by design} -body {
	# The prefix rule is a deliberate trade (git makes the same one): cheap enough to
	# run before every open, so it cannot be exact. Pinned here so the trade is a
	# decision someone made, not a surprise someone finds.
	set p [tmpbytes "[string repeat a 100]\x00"]
	dict get [rio::fs::classify $p 8000000 16] verdict
} -result ok

test fs-classify-no-size-limit {max_bytes 0 leaves only the binary probe} -body {
	set p [tmpbytes [string repeat x 5000]]
	list [dict get [rio::fs::classify $p 0] verdict] \
		[dict get [rio::fs::classify [tmpbytes "a\x00b"] 0] verdict]
} -result {ok binary}

test fs-classify-missing {a path that cannot be stat'd is ok — the read raises the real error} -body {
	set p [file join [temporaryDirectory] no-such-classify-[pid].txt]
	dict get [rio::fs::classify $p 10] verdict
} -result ok

test fs-classify-empty {an empty file is ordinary} -body {
	dict get [rio::fs::classify [tmpbytes ""] 8000000] verdict
} -result ok

test fs-human-size {sizes read the way a person says them} -body {
	list [rio::fs::human_size 0] [rio::fs::human_size 512] [rio::fs::human_size 1024] \
		[rio::fs::human_size 934000] [rio::fs::human_size 8800000] \
		[rio::fs::human_size 412000000] [rio::fs::human_size 3000000000]
} -result {{0 bytes} {512 bytes} {1 KB} {912 KB} {8.4 MB} {392.9 MB} {2.8 GB}}

# --- the fs.* ops through the in-process core --------------------------------

test fs-op-open {file.open creates a buffer and reports detected attributes} -body {
	set p [tmpbytes "hello\nworld\n"]
	set r [rio::core::call file.open [dict create path $p]]
	set res [dict get $r response result]
	list [dict get $r response ok] \
		[expr {[dict get $res name] eq [file tail $p]}] \
		[dict get $res eol] [dict get $res encoding] \
		[dict get $res linecount] \
		[rio::doc::text [dict get $res buffer]]
} -result "true 1 lf utf-8 3 {hello\nworld\n}"

test fs-op-edit-save {open, edit through buffer.replace, save preserves CRLF} -body {
	set p [tmpbytes "a\r\nb\r\n"]
	set buf [dict get [rio::core::call file.open [dict create path $p]] response result buffer]
	# Insert "X" at the very start (1.0,1.0).
	rio::core::call buffer.replace [dict create buffer $buf start 1.0 end 1.0 text X]
	rio::core::call file.save [dict create buffer $buf]
	rawbytes $p
} -result "Xa\r\nb\r\n"

test fs-op-save-as {file.save with a path writes there and retargets the buffer} -body {
	set p [tmpbytes "data\n"]
	set buf [dict get [rio::core::call file.open [dict create path $p]] response result buffer]
	set p2 [tmpbytes ""]
	rio::core::call file.save [dict create buffer $buf path $p2]
	# A subsequent save with no path should now go to p2.
	rio::core::call buffer.replace [dict create buffer $buf start 1.0 end 1.0 text Z]
	rio::core::call file.save [dict create buffer $buf]
	list [rawbytes $p] [rawbytes $p2]
} -result "{data\n} {Zdata\n}"

test fs-op-open-missing {opening a nonexistent file is an io_error, not a crash} -body {
	set p [file join [temporaryDirectory] no-such-file-[pid].txt]
	set r [dict get [rio::core::call file.open [dict create path $p]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false io_error}

test fs-op-open-no-path {file.open without a path is a bad_request} -body {
	set r [dict get [rio::core::call file.open {}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

# --- file.open declines what it should not read unasked (D125) ---------------
#
# The guard is a QUESTION, so these assert both halves: that the op says no with a
# code a frontend can branch on, and that `force` gets you past it.

test fs-op-open-too-large {a file over the budget is declined, not read} -body {
	set saved $rio::ops::open_max_bytes
	set rio::ops::open_max_bytes 1000
	set p [tmpbytes [string repeat x 4000]]
	set r [dict get [rio::core::call file.open [dict create path $p]] response]
	set rio::ops::open_max_bytes $saved
	list [dict get $r ok] [dict get $r error code] \
		[string match "*4 KB*" [dict get $r error message]] \
		[string match "*[file tail $p]*" [dict get $r error message]]
} -result {false too_large 1 1}

test fs-op-open-binary {a binary file is declined by its own code} -body {
	set p [tmpbytes "\x7FELF\x00\x00\x00 and more"]
	set r [dict get [rio::core::call file.open [dict create path $p]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false binary_file}

test fs-op-open-force-too-large {force opens it anyway, with the text intact} -body {
	set saved $rio::ops::open_max_bytes
	set rio::ops::open_max_bytes 10
	set p [tmpbytes "plenty of text here\n"]
	set r [dict get [rio::core::call file.open [dict create path $p force 1]] response]
	set rio::ops::open_max_bytes $saved
	list [dict get $r ok] [rio::doc::text [dict get $r result buffer]]
} -result "true {plenty of text here\n}"

test fs-op-open-force-binary {force opens a binary file too, bytes preserved} -body {
	# NUL is perfectly valid UTF-8 (U+0000), so this one decodes as utf-8 — a reminder
	# that "binary" here is the practical prefix rule, not an encoding verdict.
	set p [tmpbytes "a\x00b\n"]
	set r [dict get [rio::core::call file.open [dict create path $p force 1]] response]
	list [dict get $r ok] [dict get $r result encoding] \
		[string length [rio::doc::text [dict get $r result buffer]]]
} -result {true utf-8 4}

test fs-op-open-force-false {force 0 is the same as no force} -body {
	set p [tmpbytes "a\x00b\n"]
	set r [dict get [rio::core::call file.open [dict create path $p force 0]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false binary_file}

test fs-op-open-ordinary-file-unaffected {the common case never meets the guard} -body {
	set p [tmpbytes "ordinary source\n"]
	dict get [rio::core::call file.open [dict create path $p]] response ok
} -result true

test fs-guard-agrees-with-project-search {one rule, two callers: the editor and the
	search reach the SAME verdict on the same file when given the same budget — so
	extracting the rule into rio::fs::classify cannot be quietly undone on one side} -body {
	source [file join [file dirname [info script]] .. project.tcl]
	set saved $rio::ops::open_max_bytes
	set rio::ops::open_max_bytes $rio::project::search_max_bytes
	set out {}
	foreach {label bytes} [list \
			text   "findme here\n" \
			binary "fi\x00ndme\n" \
			big    "findme[string repeat . 3000000]\n"] {
		set p [tmpbytes $bytes]
		set opened [dict get [rio::core::call file.open [dict create path $p]] response ok]
		set found  [expr {[llength [lindex [rio::project::_search_file $p findme 0 0 50] 0]] > 0}]
		lappend out $label [expr {$opened eq "true" ? 1 : 0}] $found
	}
	set rio::ops::open_max_bytes $saved
	set out
} -result {text 1 1 binary 0 0 big 0 0}

test fs-op-save-no-path {saving a buffer with no file errors cleanly} -body {
	set buf [rio::doc::new "scratch" untitled]
	set r [rio::core::call file.save [dict create buffer $buf]]
	list [dict get $r response ok] [dict get $r response error code] \
		[dict get $r response error message]
} -result {false no_path {buffer has no associated file; supply a path}}

# --- fs.read: read a file's text WITHOUT opening a buffer (D26 slice 4) -------

test fs-op-read {fs.read returns text + attributes and mints no buffer} -body {
	set p [tmpbytes "one\r\ntwo\r\nthree\n"]
	set before [llength [rio::doc::inventory]]
	set res [dict get [rio::core::call fs.read [dict create path $p]] response result]
	set after [llength [rio::doc::inventory]]
	list [expr {$after == $before}] \
		[dict get $res eol] [dict get $res encoding] [dict get $res linecount] \
		[dict get $res text]
} -result "1 crlf utf-8 3 {one\ntwo\nthree\n}"

test fs-op-read-no-path {fs.read without a path is a bad_request} -body {
	set r [dict get [rio::core::call fs.read {}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test fs-op-read-missing {fs.read of a nonexistent file is an io_error} -body {
	set p [file join [temporaryDirectory] no-such-file-[pid].txt]
	set r [dict get [rio::core::call fs.read [dict create path $p]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false io_error}

test fs-op-read-dir {fs.read of a directory is an io_error, not a crash} -body {
	set r [dict get [rio::core::call fs.read [dict create path [temporaryDirectory]]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false io_error}

# --- fs.write: write text to a path, creating parent dirs (D26 slice 5) -------

test fs-op-write {fs.write creates the file with the given text} -body {
	set p [file join [makeDirectory fsw] out.txt]
	set res [dict get [rio::core::call fs.write [dict create path $p text "hello\n"]] response result]
	list [dict get $res chars] [file exists $p] [dict get [rio::fs::read $p] text]
} -result "6 1 {hello\n}"

test fs-op-write-mkdir {fs.write creates missing parent directories} -body {
	set p [file join [makeDirectory fswd] a b c deep.txt]
	rio::core::call fs.write [dict create path $p text "deep\n"]
	list [file exists $p] [dict get [rio::fs::read $p] text]
} -result "1 {deep\n}"

test fs-op-write-no-text {fs.write without text is a bad_request} -body {
	set r [dict get [rio::core::call fs.write [dict create path /tmp/x]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test fs-op-write-event {fs.write emits fs.changed naming the written path} -body {
	set p [file join [makeDirectory fswe] made.txt]
	set evs [dict get [rio::core::call fs.write [dict create path $p text "x\n"]] events]
	set ev [lindex $evs 0]
	list [dict get $ev event] [expr {[dict get $ev params path] eq [file normalize $p]}]
} -result {fs.changed 1}

# --- fs.create / fs.rename / fs.delete: file-management write ops (D48) --------
# Absolute paths resolve as-is (no project needed); the events name the changed path.

test fs-op-create-file {fs.create makes an empty file and emits fs.changed} -body {
	set p [file join [makeDirectory fsc] new.txt]
	set r [rio::core::call fs.create [dict create path $p]]
	set ev [lindex [dict get $r events] 0]
	list [file isfile $p] \
		[expr {[dict get $r response result path] eq [file normalize $p]}] \
		[dict get $ev event] \
		[expr {[dict get $ev params path] eq [file normalize $p]}]
} -result {1 1 fs.changed 1}

test fs-op-create-dir {fs.create with type dir makes a directory} -body {
	set p [file join [makeDirectory fscd] sub]
	rio::core::call fs.create [dict create path $p type dir]
	list [file isdirectory $p]
} -result 1

test fs-op-create-clobber {fs.create refuses to overwrite an existing path} -body {
	set p [file join [makeDirectory fscc] there.txt]
	rio::core::call fs.create [dict create path $p]
	set r [dict get [rio::core::call fs.create [dict create path $p]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false io_error}

test fs-op-create-bad-type {fs.create rejects a type that is not file or dir} -body {
	set p [file join [makeDirectory fsct] x]
	set r [dict get [rio::core::call fs.create [dict create path $p type link]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test fs-op-create-no-path {fs.create without a path is a bad_request} -body {
	set r [dict get [rio::core::call fs.create {}] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test fs-op-rename {fs.rename moves a file and emits fs.changed for both ends} -body {
	set d [makeDirectory fsr]
	set a [file join $d a.txt] ; set b [file join $d b.txt]
	rio::core::call fs.create [dict create path $a]
	set r [rio::core::call fs.rename [dict create path $a to $b]]
	set evs [dict get $r events]
	list [file exists $a] [file exists $b] [llength $evs] \
		[expr {[dict get [lindex $evs 0] params path] eq [file normalize $a]}] \
		[expr {[dict get [lindex $evs 1] params path] eq [file normalize $b]}]
} -result {0 1 2 1 1}

test fs-op-rename-clobber {fs.rename refuses to overwrite an existing destination} -body {
	set d [makeDirectory fsrc]
	set a [file join $d a.txt] ; set b [file join $d b.txt]
	rio::core::call fs.create [dict create path $a]
	rio::core::call fs.create [dict create path $b]
	set r [dict get [rio::core::call fs.rename [dict create path $a to $b]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false io_error}

test fs-op-rename-missing-arg {fs.rename without `to` is a bad_request} -body {
	set r [dict get [rio::core::call fs.rename [dict create path /tmp/x]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

test fs-op-delete-file {fs.delete removes a file and emits fs.changed} -body {
	set p [file join [makeDirectory fsd] gone.txt]
	rio::core::call fs.create [dict create path $p]
	set ev [lindex [dict get [rio::core::call fs.delete [dict create path $p]] events] 0]
	list [file exists $p] [dict get $ev event]
} -result {0 fs.changed}

test fs-op-delete-tree {fs.delete removes a non-empty directory recursively} -body {
	set d [makeDirectory fsdt]
	set sub [file join $d sub]
	rio::core::call fs.create [dict create path $sub type dir]
	rio::core::call fs.create [dict create path [file join $sub inner.txt]]
	rio::core::call fs.delete [dict create path $sub]
	list [file exists $sub]
} -result 0

test fs-op-delete-missing {fs.delete of a nonexistent path is an io_error} -body {
	set p [file join [temporaryDirectory] no-such-[pid].txt]
	set r [dict get [rio::core::call fs.delete [dict create path $p]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false io_error}

cleanupTests
