# Tests for the agent system-prompt composer (rio::agent::prompt, AGENTS.md D34/D70):
# the three layers (shipped base + XDG override, the user's `system.md`, and the
# per-project `.rio/agent.md`), how compose() joins them in order, and the path/ensure
# helpers + the agent.prompt.edit op behind Settings ▸ Agent Prompts…. Pure filesystem
# — no network, no event loop.
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. core.tcl]

# A throwaway dir per test, cleaned up after.
proc mkdir {args} {
	set d [file join [::tcltest::temporaryDirectory] rioprompt-[clock clicks][incr ::seq]]
	file mkdir $d
	return $d
}
proc writefile {path text} {
	file mkdir [file dirname $path]
	set fh [open $path w] ; fconfigure $fh -encoding utf-8 ; puts -nonewline $fh $text ; close $fh
}

# Every test starts from a known base-search override and no open project, so one
# test's project root or override can't leak into the next.
proc reset_prompt {} {
	rio::agent::prompt::override_dirs ""
	rio::project::close
}

# --- the shipped base loads (no override, no project) ------------------------

test shipped-base {without any override the shipped agent/prompt.md is found} -setup {
	reset_prompt
} -body {
	set s [rio::agent::prompt::compose]
	list [expr {$s ne ""}] [string match {*propose*} $s]
} -cleanup { reset_prompt } -result {1 1}

# --- base override: a user file replaces the shipped one ----------------------

test base-override {a prompt.md in the search dir is used as the base} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE INSTRUCTIONS"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::d } -result {BASE INSTRUCTIONS}

test base-precedence {the first search dir with a prompt.md wins} -setup {
	reset_prompt
	set ::d1 [mkdir] ; set ::d2 [mkdir]
	writefile [file join $::d1 prompt.md] "FROM ONE"
	writefile [file join $::d2 prompt.md] "FROM TWO"
	rio::agent::prompt::override_dirs [list $::d1 $::d2]
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::d1 $::d2 } -result {FROM ONE}

# --- project layer: .rio/agent.md at the open root, appended ------------------

test project-appended {an open project's .rio/agent.md is appended to the base} -setup {
	reset_prompt
	set ::b [mkdir]
	writefile [file join $::b prompt.md] "BASE"
	rio::agent::prompt::override_dirs [list $::b]
	set ::proj [mkdir]
	writefile [file join $::proj .rio agent.md] "PROJECT RULES"
	rio::project::open $::proj
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::b $::proj } -result "BASE

PROJECT RULES"

test project-optional {no .rio/agent.md means the base stands alone} -setup {
	reset_prompt
	set ::b [mkdir]
	writefile [file join $::b prompt.md] "BASE"
	rio::agent::prompt::override_dirs [list $::b]
	set ::proj [mkdir]
	rio::project::open $::proj
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::b $::proj } -result {BASE}

test project-only {a project layer with no base file yields just the project text} -setup {
	reset_prompt
	set ::b [mkdir]   ;# empty: no prompt.md
	rio::agent::prompt::override_dirs [list $::b]
	set ::proj [mkdir]
	writefile [file join $::proj .rio agent.md] "ONLY PROJECT"
	rio::project::open $::proj
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::b $::proj } -result {ONLY PROJECT}

# --- nothing available: an empty prompt (safe degrade) -----------------------

test none {no base file and no project composes to the empty string} -setup {
	reset_prompt
	set ::b [mkdir]   ;# empty
	rio::agent::prompt::override_dirs [list $::b]
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::b } -result {}

# --- the user system layer (D70): system.md, between base and project ---------

test system-layer {system.md is composed on top of the base} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	writefile [file join $::d system.md] "MY RULES"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::d } -result "BASE

MY RULES"

test compose-order {base, then system, then project — in that order} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	writefile [file join $::d system.md] "SYSTEM"
	rio::agent::prompt::override_dirs [list $::d]
	set ::proj [mkdir]
	writefile [file join $::proj .rio agent.md] "PROJECT"
	rio::project::open $::proj
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::d $::proj } -result "BASE

SYSTEM

PROJECT"

test system-optional {no system.md leaves the base alone} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::d } -result {BASE}

test system-only {system.md alone (no base, no project) composes to just it} -setup {
	reset_prompt
	set ::d [mkdir]   ;# no prompt.md
	writefile [file join $::d system.md] "ONLY SYSTEM"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::d } -result {ONLY SYSTEM}

# --- the per-provider layer (D79): providers/<name>.md, for the active provider --

test provider-layer {providers/<name>.md is composed for the active provider} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	writefile [file join $::d providers claude.md] "CLAUDE RULES"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose claude
} -cleanup { reset_prompt ; file delete -force $::d } -result "BASE

CLAUDE RULES"

test compose-order-four {base, then system, then provider, then project — in order} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	writefile [file join $::d system.md] "SYSTEM"
	writefile [file join $::d providers claude.md] "PROVIDER"
	rio::agent::prompt::override_dirs [list $::d]
	set ::proj [mkdir]
	writefile [file join $::proj .rio agent.md] "PROJECT"
	rio::project::open $::proj
} -body {
	rio::agent::prompt::compose claude
} -cleanup { reset_prompt ; file delete -force $::d $::proj } -result "BASE

SYSTEM

PROVIDER

PROJECT"

test provider-optional {no providers/<name>.md leaves the other layers alone} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose claude
} -cleanup { reset_prompt ; file delete -force $::d } -result {BASE}

test provider-only {a provider file alone composes to just it} -setup {
	reset_prompt
	set ::d [mkdir]   ;# no prompt.md
	writefile [file join $::d providers claude.md] "ONLY CLAUDE"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose claude
} -cleanup { reset_prompt ; file delete -force $::d } -result {ONLY CLAUDE}

test provider-inactive {only the ACTIVE provider's file is added} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	writefile [file join $::d providers openai.md] "OPENAI RULES"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose claude
} -cleanup { reset_prompt ; file delete -force $::d } -result {BASE}

test provider-echo-none {echo contributes no provider layer even if the file exists} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	writefile [file join $::d providers echo.md] "SHOULD NOT LOAD"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose echo
} -cleanup { reset_prompt ; file delete -force $::d } -result {BASE}

test provider-none-named {compose with no provider name adds no provider layer} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	writefile [file join $::d providers claude.md] "SHOULD NOT LOAD"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose
} -cleanup { reset_prompt ; file delete -force $::d } -result {BASE}

test provider-unsafe-name {an unsafe provider name loads nothing (no traversal)} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d prompt.md] "BASE"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	rio::agent::prompt::compose "../system"
} -cleanup { reset_prompt ; file delete -force $::d } -result {BASE}

# --- path / ensure: locate and create the user-editable files -----------------

test path-system {path system points at system.md in the user dir} -setup {
	reset_prompt
	set ::d [mkdir]
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	string equal [rio::agent::prompt::path system] [file join $::d system.md]
} -cleanup { reset_prompt ; file delete -force $::d } -result 1

test path-project-none {path project is "" with no open project} -setup {
	reset_prompt
} -body {
	rio::agent::prompt::path project
} -cleanup { reset_prompt } -result {}

test path-provider {path provider <name> points at providers/<name>.md} -setup {
	reset_prompt
	set ::d [mkdir]
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	string equal [rio::agent::prompt::path provider claude] \
		[file join $::d providers claude.md]
} -cleanup { reset_prompt ; file delete -force $::d } -result 1

test path-provider-unsafe {path provider with an unsafe name is ""} -setup {
	reset_prompt
	set ::d [mkdir]
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	list [rio::agent::prompt::path provider "../x"] [rio::agent::prompt::path provider ""]
} -cleanup { reset_prompt ; file delete -force $::d } -result {{} {}}

test ensure-provider {ensure provider creates providers/<name>.md empty} -setup {
	reset_prompt
	set ::d [mkdir]
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	set r [rio::agent::prompt::ensure provider claude]
	list [dict get $r created] \
		[string equal [dict get $r path] [file join $::d providers claude.md]] \
		[file isfile [dict get $r path]] [file size [dict get $r path]]
} -cleanup { reset_prompt ; file delete -force $::d } -result {1 1 1 0}

test ensure-creates-empty {ensure system creates an empty file and reports created} -setup {
	reset_prompt
	set ::d [mkdir]
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	set r [rio::agent::prompt::ensure system]
	list [dict get $r created] [file isfile [dict get $r path]] [file size [dict get $r path]]
} -cleanup { reset_prompt ; file delete -force $::d } -result {1 1 0}

test ensure-idempotent {ensure on an existing file keeps content and reports created 0} -setup {
	reset_prompt
	set ::d [mkdir]
	writefile [file join $::d system.md] "KEEP ME"
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	set r [rio::agent::prompt::ensure system]
	list [dict get $r created] [rio::agent::prompt::_read [dict get $r path]]
} -cleanup { reset_prompt ; file delete -force $::d } -result {0 {KEEP ME}}

test ensure-project {ensure project creates .rio/agent.md under the open root} -setup {
	reset_prompt
	set ::proj [mkdir]
	rio::project::open $::proj
} -body {
	set r [rio::agent::prompt::ensure project]
	list [dict get $r created] \
		[string equal [dict get $r path] [file join $::proj .rio agent.md]] \
		[file isfile [dict get $r path]]
} -cleanup { reset_prompt ; file delete -force $::proj } -result {1 1 1}

# --- the agent.prompt.edit op --------------------------------------------------

test op-system {agent.prompt.edit system returns path + created} -setup {
	reset_prompt
	set ::d [mkdir]
	rio::agent::prompt::override_dirs [list $::d]
} -body {
	set res [dict get [rio::ops::agent_prompt_edit {which system}] result]
	list [dict get $res created] [string equal [dict get $res path] [file join $::d system.md]]
} -cleanup { reset_prompt ; file delete -force $::d } -result {1 1}

test op-project-none {agent.prompt.edit project with no project is a bad_request} -setup {
	reset_prompt
} -body {
	catch {rio::ops::agent_prompt_edit {which project}} e
	set e
} -cleanup { reset_prompt } -match glob -result {*no project*}

test op-bad-which {agent.prompt.edit rejects an unknown prompt} -setup {
	reset_prompt
} -body {
	catch {rio::ops::agent_prompt_edit {which bogus}} e
	set e
} -cleanup { reset_prompt } -match glob -result {*unknown prompt*}

# The op validates the provider name against the registry; register a throwaway
# provider so a valid `provider` edit has something to match (the core process carries
# only `echo`; the real claude/openai faces live in their extensions).
test op-provider {agent.prompt.edit provider returns path + created} -setup {
	reset_prompt
	set ::d [mkdir]
	rio::agent::prompt::override_dirs [list $::d]
	rio::agent::register_provider testprov ::testprov_cmd -label Test
} -body {
	set res [dict get [rio::ops::agent_prompt_edit {which provider name testprov}] result]
	list [dict get $res created] \
		[string equal [dict get $res path] [file join $::d providers testprov.md]]
} -cleanup { reset_prompt ; file delete -force $::d } -result {1 1}

test op-provider-noname {agent.prompt.edit provider without a name is a bad_request} -setup {
	reset_prompt
} -body {
	catch {rio::ops::agent_prompt_edit {which provider}} e
	set e
} -cleanup { reset_prompt } -match glob -result {*requires name*}

test op-provider-echo {agent.prompt.edit provider echo is a bad_request} -setup {
	reset_prompt
} -body {
	catch {rio::ops::agent_prompt_edit {which provider name echo}} e
	set e
} -cleanup { reset_prompt } -match glob -result {*echo*}

test op-provider-unknown {agent.prompt.edit provider with an unregistered name is a bad_request} -setup {
	reset_prompt
} -body {
	catch {rio::ops::agent_prompt_edit {which provider name nope}} e
	set e
} -cleanup { reset_prompt } -match glob -result {*unknown agent provider*}

cleanupTests
