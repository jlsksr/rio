# Tests for the bounded HTTP GET (rio::http, AGENTS.md D39, D109) and the
# repo.fetch op over it. NO network, not even loopback: only the pure logic is
# tested here — Location resolution, scheme refusal, parameter validation, the
# dispatch registration. The wire-level behaviour (redirect chains, the 2 MB
# cap, timeouts) is exercised against a real webdir at release verification
# (D39); https over a real loopback connection is tls.test's; the GUI suite
# stubs repo.fetch entirely.
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. error.tcl]
source [file join [file dirname [info script]] .. dispatch.tcl]
source [file join [file dirname [info script]] .. tls.tcl]
source [file join [file dirname [info script]] .. http.tcl]
namespace eval rio::ops {}   ;# normally created by document.tcl, not loaded here
source [file join [file dirname [info script]] .. ops-repo.tcl]

# --- Location resolution ------------------------------------------------------
test http-resolve-absolute {an absolute Location passes through} -body {
	rio::http::_resolve http://a.example/x/y http://b.example/z
} -result http://b.example/z

test http-resolve-host-absolute {/path keeps the origin} -body {
	rio::http::_resolve http://a.example:8080/x/y /z
} -result http://a.example:8080/z

test http-resolve-relative {a bare path resolves against the base's directory} -body {
	rio::http::_resolve http://a.example/x/y z
} -result http://a.example/x/z

test http-resolve-relative-rootless {a bare path on a bare host resolves at /} -body {
	rio::http::_resolve http://a.example z
} -result http://a.example/z

test http-resolve-protocol-relative {//host/path keeps the scheme (http)} -body {
	rio::http::_resolve http://a.example/x //b.example/z
} -result http://b.example/z

test http-resolve-scheme-change-passes {a Location with another scheme passes through
		untouched — whether to follow it is `get`'s call (D109), not resolution's} -body {
	list [rio::http::_resolve http://a.example/x https://b.example/z] \
		[rio::http::_resolve https://a.example/x http://b.example/z]
} -result {https://b.example/z http://b.example/z}

test http-resolve-https-origin {an https base keeps its origin, scheme included} -body {
	list [rio::http::_resolve https://a.example:8443/x/y /z] \
		[rio::http::_resolve https://a.example/x/y z]
} -result {https://a.example:8443/z https://a.example/x/z}

test http-resolve-protocol-relative-https {//host/path inherits https from an https base —
		a scheme-relative redirect is never a downgrade} -body {
	list [rio::http::_resolve https://a.example/x //b.example/z] \
		[rio::http::_resolve HTTPS://a.example/x //b.example/z]
} -result {https://b.example/z https://b.example/z}

# --- scheme refusal in the fetcher itself -------------------------------------
test http-get-refuses-other-schemes {get itself refuses a url that is neither http nor
		https: io_error, no connection attempted} -body {
	catch {rio::http::get ftp://example.org/repo} e opts
	list [rio::error::code_of $opts] [string match "not an http:// or https:// url*" $e]
} -result {io_error 1}

test http-scheme {the scheme, case-folded; "" for anything else} -body {
	list [rio::http::_scheme http://a] [rio::http::_scheme HTTPS://a] \
		[rio::http::_scheme ftp://a] [rio::http::_scheme https:a]
} -result {http https {} {}}

# --- body decoding (pure: the seam is the decoder, not the socket) ------------
# Since D118 the fetch is -binary, so _decode's input is always BYTES — one
# character per byte — and every decision about what they mean is made here. A
# repository is a plain webdir, which declares no charset, and the RFC default for
# that is latin-1: left alone, the GUI writes those characters back out as UTF-8
# and the installed extension is corrupted on disk (found live against
# rio.skylm.org, 2026-09-12).

# The three bytes of an em-dash, as a byte string.
#
# Every non-ASCII value below is a \u escape, not a literal, and must stay that way:
# tcltest runs each .test in a CHILD tclsh, which decodes the file with the SYSTEM
# encoding — cp1252 on Windows — before any -load script can run. A literal here
# would arrive mojibake on Windows and be compared against a correctly-decoded
# result, failing for a reason that has nothing to do with the decoder. This is the
# only .test whose non-ASCII is data rather than commentary. See WINDOWS.md §8.
set mangled "a\u00E2\u0080\u0094b"

test http-decode-undeclared-charset-is-utf8 {no charset means UTF-8, not latin-1} -body {
	rio::http::_decode $::mangled "text/plain"
} -result "a\u2014b"

test http-decode-declared-latin1 {a server that says latin-1 is believed} -body {
	# The same bytes; the difference is that the server said what they are.
	rio::http::_decode $::mangled "text/plain; charset=iso-8859-1"
} -result "a\u00E2\u0080\u0094b"

test http-decode-declared-utf8 {and a server that says utf-8 is believed too} -body {
	rio::http::_decode $::mangled "text/plain; charset=utf-8"
} -result "a\u2014b"

test http-decode-charset-quoted-and-cased {charset="UTF-8"; \u2026, as servers write it} -body {
	list [rio::http::_decode $::mangled {text/plain; charset="UTF-8"}] \
		[rio::http::_decode $::mangled {text/html;charset=utf-8}]
} -result [list "a\u2014b" "a\u2014b"]

test http-encoding-for {the IANA name a server sends -> the name Tcl knows} -body {
	set out {}
	foreach cs {utf-8 UTF-8 iso-8859-1 iso8859-1 windows-1252 cp1252 us-ascii
			utf8 klingon-9 {}} {
		lappend out [rio::http::_encoding_for $cs]
	}
	set out
} -result {utf-8 utf-8 iso8859-1 iso8859-1 cp1252 cp1252 ascii utf-8 {} {}}

test http-decode-unknown-charset-falls-back {a charset this Tcl has no encoding for
		is no reason to mangle anything \u2014 the UTF-8 guess still runs} -body {
	rio::http::_decode $::mangled "text/plain; charset=klingon-9"
} -result "a\u2014b"

test http-decode-ascii-unchanged {the overwhelmingly common case costs nothing} -body {
	rio::http::_decode "name = night\nkind = theme\n" "text/plain"
} -result "name = night\nkind = theme\n"

test http-decode-invalid-utf8-kept-as-is {bytes that are NOT utf-8 are not replaced by U+FFFD} -body {
	# A lone 0xE9 (latin-1 "é") is not a valid UTF-8 sequence: decoding it as UTF-8
	# would destroy it, so the bytes stand as they are.
	rio::http::_decode "caf\u00E9" "text/plain"
} -result "caf\u00E9"

test http-decode-multibyte-round-trip {a whole manifest line survives intact} -body {
	set src "description = OpenAI-compatible agent provider \u2014 hosted ChatGPT"
	set wire [encoding convertfrom iso8859-1 [encoding convertto utf-8 $src]]
	rio::http::_decode $wire "text/plain"
} -result "description = OpenAI-compatible agent provider \u2014 hosted ChatGPT"

test http-decode-keeps-crlf {line endings are NOT translated (D118): a signature
		covers bytes, and a repository published from Windows must stay verifiable} -body {
	list [rio::http::_decode "a\r\nb\r\n" "text/plain"] \
		[rio::http::_decode "a\r\nb\r\n" "text/plain; charset=utf-8"]
} -result [list "a\r\nb\r\n" "a\r\nb\r\n"]

# --- the hash of what arrived (AGENTS.md D118) --------------------------------
test http-sha256-of-bytes {the hash is over BYTES, and is the one sha256sum prints
		for the same input — checked against `printf abc | sha256sum`} -body {
	list [rio::http::_sha256 "abc"] \
		[rio::http::_sha256 [encoding convertto utf-8 "caf\u00E9"]]
} -result {ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad 850f7dc43910ff890f8879c0ed26fe697c93a067ad93a7d50f466a7028a9bf4e}

test http-sha256-is-not-the-hash-of-the-decoded-text {the distinction the whole
		design rests on: one body, two strings, two different hashes — which is why
		the core hashes and the GUI never re-derives} -body {
	expr {[rio::http::_sha256 $::mangled]
		ne [rio::http::_sha256 [rio::http::_decode $::mangled "text/plain"]]}
} -result 1

# --- repo.fetch parameter validation (no fetch is ever attempted) -------------
test repo-fetch-requires-url {a missing url is bad_request} -body {
	catch {rio::ops::repo_fetch {}} e opts
	rio::error::code_of $opts
} -result bad_request

test repo-fetch-https-accepted {https is a first-class url now (D109): it reaches the
		fetcher, which here reports the missing tcltls — not a bad_request} -setup {
	rename rio::tls::ensure _real_ensure
	proc rio::tls::ensure {} { error {can't find package tls} }
} -body {
	catch {rio::ops::repo_fetch {url https://example.org/repo}} e opts
	list [rio::error::code_of $opts] [string match "*needs tcltls*" $e]
} -cleanup {
	rename rio::tls::ensure {} ; rename _real_ensure rio::tls::ensure
} -result {io_error 1}

test repo-fetch-scheme-refused {a non-http scheme is bad_request} -body {
	catch {rio::ops::repo_fetch {url ftp://example.org/repo}} e opts
	rio::error::code_of $opts
} -result bad_request

test repo-fetch-bad-timeout {a garbage timeout is bad_request, not internal} -body {
	catch {rio::ops::repo_fetch {url http://example.org/repo timeout soon}} e opts
	rio::error::code_of $opts
} -result bad_request

test repo-fetch-bad-sha256-flag {and so is a garbage sha256 flag (D118)} -body {
	catch {rio::ops::repo_fetch {url http://example.org/repo sha256 maybe}} e opts
	rio::error::code_of $opts
} -result bad_request

test repo-fetch-registered {repo.fetch is a registered op; a bad request comes
		back as a clean error reply through dispatch} -body {
	set resp [rio::dispatch::handle \
		{id 1 op repo.fetch params {url ftp://example.org/x}} [list apply {{ev} {}}]]
	list [dict get $resp ok] [dict get $resp error code]
} -result {false bad_request}

cleanupTests
