# Tests for the secrets store (rio::secret, AGENTS.md D21/D26): a tight-perms,
# machine-written token store kept apart from settings/session. Local only.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. error.tcl]
source [file join [file dirname [info script]] .. conf.tcl]
source [file join [file dirname [info script]] .. secret.tcl]

# Point the store at a throwaway dir for the whole file.
set ::dir [file join [::tcltest::temporaryDirectory] riosecret-[clock clicks]]
set rio::secret::override_dir $::dir

test secret-absent-empty {a missing secret reads back as empty} -body {
	rio::secret::get nope
} -result {}

test secret-has-false {has is false before a save} -body {
	rio::secret::has claude-api
} -result 0

test secret-roundtrip {save then get returns the same flat dict} -body {
	rio::secret::save claude-api \
		[dict create api_key sk-ant org acme created 123]
	set d [rio::secret::get claude-api]
	list [dict get $d api_key] [dict get $d org] [dict get $d created]
} -result {sk-ant acme 123}

test secret-has-true {has is true after a save} -body {
	rio::secret::has claude-api
} -result 1

test secret-overwrite {a second save replaces the first} -body {
	rio::secret::save claude-api [dict create api_key NEW]
	set d [rio::secret::get claude-api]
	list [dict get $d api_key] [dict exists $d org]
} -result {NEW 0}

test secret-perms-0600 {the secret file is created mode 0600} -constraints unix -body {
	rio::secret::save permcheck [dict create k v]
	format %04o [expr {[file attributes \
		[file join $::dir permcheck.secret] -permissions] & 0777}]
} -result 0600

test secret-dir-perms-0700 {the secrets dir is mode 0700} -constraints unix -body {
	format %04o [expr {[file attributes $::dir -permissions] & 0777}]
} -result 0700

test secret-value-with-spaces {values may contain spaces and = signs} -body {
	rio::secret::save weird [dict create token "a b=c d"]
	dict get [rio::secret::get weird] token
} -result {a b=c d}

test secret-forget {forget deletes the secret} -body {
	rio::secret::save gone [dict create k v]
	rio::secret::forget gone
	list [rio::secret::has gone] [rio::secret::get gone]
} -result {0 {}}

file delete -force $::dir
cleanupTests
