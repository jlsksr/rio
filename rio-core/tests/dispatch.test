# Tests for the dispatch layer (rio::dispatch) and the buffer.* ops — the D11
# request/response/event shapes, exercised through the in-process transport.
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. core.tcl]

# Edit a fresh buffer in isolation so tests don't depend on each other.
proc freshbuf {{text ""}} { return [rio::doc::new $text] }

test dispatch-unknown-op {an unknown op yields ok:false with a coded error} -body {
	set out [rio::core::call nope {}]
	set r [dict get $out response]
	list [dict get $r ok] [dict get $r error code] [dict get $r error message]
} -result {false unknown_op {unknown op: nope}}

test dispatch-missing-op {a request without op is rejected as bad_request} -body {
	set r [rio::dispatch::handle {id 7} [list lappend ::ignore]]
	list [dict get $r ok] [dict get $r error code] [dict get $r error message]
} -result {false bad_request {missing op}}

test dispatch-id-echoed {the response carries the request id} -body {
	set r [rio::dispatch::handle {id 42 op buffer.text} [list lappend ::ignore]]
	list [dict get $r id] [dict get $r ok]
} -result {42 true}

test buffer-text-result {buffer.text returns the document text} -body {
	set b [freshbuf "hi\nthere"]
	set out [rio::core::call buffer.text [dict create buffer $b]]
	dict get [dict get $out response] result
} -result {text {hi
there}}

test buffer-replace-response {buffer.replace responds ok with empty result} -body {
	set b [freshbuf "abc"]
	set out [rio::core::call buffer.replace \
		[dict create buffer $b start 1.1 end 1.1 text X]]
	set r [dict get $out response]
	list [dict get $r ok] [dict get $r result]
} -result {true {}}

test buffer-replace-mutates {buffer.replace edits the document} -body {
	set b [freshbuf "abc"]
	rio::core::call buffer.replace [dict create buffer $b start 1.1 end 1.1 text X]
	rio::doc::text $b
} -result "aXbc"

test buffer-replace-emits-event {buffer.replace emits one buffer.changed event} -body {
	set b [freshbuf "abc"]
	set out [rio::core::call buffer.replace \
		[dict create buffer $b start 1.3 end 1.3 text Z]]
	set evs [dict get $out events]
	set ev [lindex $evs 0]
	list [llength $evs] [dict get $ev event] \
		[dict get $ev params text] [dict get $ev params start]
} -result {1 buffer.changed Z 1.3}

test buffer-changed-carries-removed {a deleting replace reports the removed text} -body {
	set b [freshbuf "hello world"]
	set out [rio::core::call buffer.replace \
		[dict create buffer $b start 1.5 end 1.11 text ""]]
	dict get [lindex [dict get $out events] 0] params removed
} -result { world}

test buffer-text-no-event {a pure read emits no events} -body {
	set b [freshbuf "abc"]
	set out [rio::core::call buffer.text [dict create buffer $b]]
	llength [dict get $out events]
} -result 0

test buffer-handler-error-propagates {a doc error becomes ok:false} -body {
	set b [freshbuf "abc"]
	set out [rio::core::call buffer.replace \
		[dict create buffer $b start 9.0 end 9.0 text x]]
	set r [dict get $out response]
	list [dict get $r ok] [dict get $r error code] \
		[string match {index out of range*} [dict get $r error message]]
} -result {false bad_index 1}

test buffer-new-creates {buffer.new mints a fresh empty buffer} -body {
	set out [rio::core::call buffer.new {}]
	set id [dict get $out response result buffer]
	list [dict get $out response ok] [rio::doc::exists $id] [rio::doc::text $id]
} -result {true 1 {}}

test buffer-new-name {buffer.new honours a name} -body {
	set out [rio::core::call buffer.new [dict create name scratch]]
	dict get $out response result name
} -result scratch

test buffer-close-forgets {buffer.close removes the buffer} -body {
	set b [freshbuf "bye"]
	set out [rio::core::call buffer.close [dict create buffer $b]]
	list [dict get $out response ok] [rio::doc::exists $b]
} -result {true 0}

test buffer-close-unknown {closing a missing buffer errors cleanly} -body {
	set out [rio::core::call buffer.close [dict create buffer 99999]]
	set r [dict get $out response]
	list [dict get $r ok] [dict get $r error code] [dict get $r error message]
} -result {false no_buffer {no such buffer: 99999}}

# --- buffer.setpath (repoint a buffer without writing; D48 rename support) ----

test buffer-setpath-updates {buffer.setpath changes the stored path, no write} -body {
	set b [rio::doc::new "hi" old.txt [dict create path /tmp/old.txt]]
	set out [rio::core::call buffer.setpath [dict create buffer $b path /tmp/new.txt]]
	list [dict get $out response ok] [dict get [rio::doc::meta $b] path]
} -result {true /tmp/new.txt}

test buffer-setpath-unknown {setpath on a missing buffer errors cleanly} -body {
	set out [rio::core::call buffer.setpath [dict create buffer 99999 path /tmp/x]]
	set r [dict get $out response]
	list [dict get $r ok] [dict get $r error code]
} -result {false no_buffer}

test buffer-setpath-no-path {setpath without a path is a bad_request} -body {
	set b [rio::doc::new "hi" p.txt]
	set r [dict get [rio::core::call buffer.setpath [dict create buffer $b]] response]
	list [dict get $r ok] [dict get $r error code]
} -result {false bad_request}

# --- buffer.list (inventory; the first non-flat result) ----------------------
# The registry is shared across tests, so don't assert the whole list — locate
# the buffer under test within it.
proc bufentry {id} {
	foreach e [dict get [rio::core::call buffer.list {}] response result buffers] {
		if {[dict get $e buffer] eq $id} { return $e }
	}
	return ""
}

test buffer-list-shape {buffer.list summarises a buffer: name, linecount, path} -body {
	set b [rio::doc::new "x\ny\nz" listtest]
	set e [bufentry $b]
	list [dict get $e name] [dict get $e linecount] [dict get $e path]
} -result {listtest 3 {}}

test buffer-list-path {a file-backed buffer reports its stored path} -body {
	set b [rio::doc::new "hi" doc.txt [dict create path /tmp/doc.txt]]
	dict get [bufentry $b] path
} -result /tmp/doc.txt

test buffer-list-order {buffers appear in creation order} -body {
	set a [rio::doc::new "" first]
	set z [rio::doc::new "" second]
	set ids {}
	foreach e [dict get [rio::core::call buffer.list {}] response result buffers] {
		lappend ids [dict get $e buffer]
	}
	expr {[lsearch -exact $ids $a] < [lsearch -exact $ids $z]}
} -result 1

test buffer-list-no-event {listing buffers emits no events} -body {
	llength [dict get [rio::core::call buffer.list {}] events]
} -result 0

# --- session.hello (capability / version negotiation) ------------------------

test session-hello-identity {session.hello reports protocol version and name} -body {
	set r [dict get [rio::core::call session.hello {}] response result]
	list [dict get $r protocol] [dict get $r name]
} -result {2 rio-core}

# The RELEASE version (D123), additive beside `protocol` and reported as the one literal
# in version.tcl — not a second copy that could drift from it. `protocol` says whether a
# client can talk to this core; this says which rio it reached.
test session-hello-version {session.hello reports rio's release version} -body {
	set r [dict get [rio::core::call session.hello {}] response result]
	list [dict get $r version] [expr {[dict get $r version] eq $rio::version}]
} -result [list $rio::version 1]

# It is a version a client can ORDER — the same shape rio holds extensions to (D107),
# so "which of these two rios is newer" is answerable rather than a string compare.
test session-hello-version-semver {the reported version is semver-shaped} -body {
	regexp {^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$} \
		[dict get [rio::core::call session.hello {}] response result version]
} -result 1

test session-hello-ops {session.hello lists registered ops, sorted, including itself} -body {
	set ops [dict get [rio::core::call session.hello {}] response result ops]
	list [expr {"session.hello" in $ops}] [expr {"buffer.replace" in $ops}] \
		[expr {"file.open" in $ops}] [expr {$ops eq [lsort $ops]}] \
		[expr {"fs.create" in $ops}] [expr {"fs.rename" in $ops}] \
		[expr {"fs.delete" in $ops}] [expr {"buffer.setpath" in $ops}]
} -result {1 1 1 1 1 1 1 1}

test session-hello-no-event {session.hello is a pure query — no events} -body {
	llength [dict get [rio::core::call session.hello {}] events]
} -result 0

# The frontend browses the CORE's disk (D30) and the two may be different platforms,
# so the core reports its own filesystem root rather than letting the client assume
# "/" — which is unlistable on a Windows core. Asserted against this host's own answer
# so the test is meaningful on either platform.
test session-hello-fsroot {session.hello reports the core's filesystem root} -body {
	set r [dict get [rio::core::call session.hello {}] response result]
	list [dict get $r fsroot] [expr {[file isdirectory [dict get $r fsroot]]}]
} -result [list [file normalize /] 1]

# --- theme.get (role table; the third non-flat result) -----------------------

test theme-get-default {theme.get with no name returns the built-in default} -body {
	set r [dict get [rio::core::call theme.get {}] response result]
	list [dict get $r colors editor.bg] [dict get $r fonts RioEditorFont size]
} -result {white 12}

test theme-get-named {theme.get loads a named theme file} -body {
	set r [dict get [rio::core::call theme.get {name solarized-dark}] response result]
	dict get $r colors editor.bg
} -result {#002b36}

test theme-get-missing {theme.get on an unknown theme is ok:false} -body {
	set resp [dict get [rio::core::call theme.get {name nope}] response]
	list [dict get $resp ok] [dict get $resp error code] [dict get $resp error message]
} -result {false bad_request {no such theme: nope}}

test theme-get-no-event {theme.get is a pure query — no events} -body {
	llength [dict get [rio::core::call theme.get {}] events]
} -result 0

cleanupTests
