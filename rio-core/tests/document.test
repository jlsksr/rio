# Tests for the document model (rio::doc) — the D12 range-replacement primitive.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. core.tcl]

test doc-new-empty {a new empty document is one empty line} -body {
	set b [rio::doc::new ""]
	list [rio::doc::text $b] [rio::doc::linecount $b]
} -result {{} 1}

test doc-roundtrip {text splits into lines and rejoins} -body {
	set b [rio::doc::new "a\nb\nc"]
	list [rio::doc::linecount $b] [rio::doc::text $b]
} -result "3 {a\nb\nc}"

test doc-trailing-newline {a trailing newline is a real empty last line} -body {
	set b [rio::doc::new "x\n"]
	list [rio::doc::linecount $b] [rio::doc::text $b]
} -result "2 {x\n}"

test doc-insert {zero-width replace inserts} -body {
	set b [rio::doc::new "helloworld"]
	rio::doc::replace $b 1.5 1.5 " "
	rio::doc::text $b
} -result "hello world"

test doc-insert-returns-empty-removed {insert removes nothing} -body {
	set b [rio::doc::new "ab"]
	rio::doc::replace $b 1.1 1.1 "X"
} -result {}

test doc-delete {replacing a span with empty deletes} -body {
	set b [rio::doc::new "hello world"]
	rio::doc::replace $b 1.5 1.11 ""
	rio::doc::text $b
} -result "hello"

test doc-delete-returns-removed {delete returns the removed text} -body {
	set b [rio::doc::new "hello world"]
	rio::doc::replace $b 1.5 1.11 ""
} -result " world"

test doc-replace-span {replace a span with new text} -body {
	set b [rio::doc::new "hello world"]
	set removed [rio::doc::replace $b 1.6 1.11 "there"]
	list [rio::doc::text $b] $removed
} -result {{hello there} world}

test doc-insert-newline {inserting a newline splits a line} -body {
	set b [rio::doc::new "ab"]
	rio::doc::replace $b 1.1 1.1 "\n"
	list [rio::doc::linecount $b] [rio::doc::text $b]
} -result "2 {a\nb}"

test doc-multiline-insert {inserting multi-line text} -body {
	set b [rio::doc::new "ad"]
	rio::doc::replace $b 1.1 1.1 "b\nc"
	list [rio::doc::linecount $b] [rio::doc::text $b]
} -result "2 {ab\ncd}"

test doc-multiline-delete {deleting across lines joins them} -body {
	set b [rio::doc::new "hello,\nbrave world"]
	set removed [rio::doc::replace $b 1.5 2.5 ""]
	list [rio::doc::text $b] $removed
} -result "{hello world} {,\nbrave}"

test doc-multiline-replace {replace a cross-line span with new text} -body {
	set b [rio::doc::new "one\ntwo\nthree"]
	rio::doc::replace $b 1.1 3.2 "X"
	rio::doc::text $b
} -result "oXree"

test doc-col-clamp {a column past end of line clamps to end} -body {
	set b [rio::doc::new "ab"]
	rio::doc::replace $b 1.99 1.99 "c"
	rio::doc::text $b
} -result "abc"

test doc-bad-index {a malformed index errors} -body {
	set b [rio::doc::new "ab"]
	rio::doc::replace $b "1" 1.0 "x"
} -returnCodes error -match glob -result {bad index*}

test doc-line-out-of-range {a line past the document errors} -body {
	set b [rio::doc::new "ab"]
	rio::doc::replace $b 5.0 5.0 "x"
} -returnCodes error -match glob -result {index out of range*}

test doc-end-before-start {end before start errors} -body {
	set b [rio::doc::new "abcd"]
	rio::doc::replace $b 1.3 1.1 "x"
} -returnCodes error -match glob -result {end before start*}

test doc-no-such-buffer {operating on an unknown buffer errors} -body {
	rio::doc::text 99999
} -returnCodes error -match glob -result {no such buffer*}

cleanupTests
