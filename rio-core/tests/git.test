# Tests for the git read layer (rio::git, AGENTS.md D7) and the git.* ops driven
# through the in-process core. We build a throwaway real repo and shell out to a
# real `git`; if git isn't installed the whole file skips (the hasgit constraint).

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. error.tcl]
source [file join [file dirname [info script]] .. exec.tcl]
source [file join [file dirname [info script]] .. git.tcl]
source [file join [file dirname [info script]] .. core.tcl]
source [file join [file dirname [info script]] .. wire.tcl]

testConstraint hasgit [expr {![catch {exec git --version}]}]

# Drive a real git in $dir with a fixed identity (no dependence on user config).
proc git_in {dir args} {
	exec git -C $dir -c user.email=t@example.com -c user.name=tester {*}$args
}
proc writefile {path content} {
	set f [open $path w] ; puts -nonewline $f $content ; close $f
}

# Build a repo with one committed file, one modified-unstaged, one staged-add,
# and one untracked — so status exercises X, Y, and ?? codes.
proc makerepo {} {
	set dir [file join [::tcltest::temporaryDirectory] riogit-[clock clicks]]
	file mkdir $dir
	git_in $dir init -q
	git_in $dir branch -M main
	# Persist a local identity so rio::git::commit (which shells a plain `git commit`,
	# no -c identity) works without depending on the machine's global git config.
	git_in $dir config user.email t@example.com
	git_in $dir config user.name tester
	writefile [file join $dir a.txt] "one\n"
	git_in $dir add a.txt
	git_in $dir commit -q -m first
	writefile [file join $dir a.txt] "one\ntwo\n"      ;# modify, leave unstaged -> " M"
	writefile [file join $dir c.txt] "new staged\n"
	git_in $dir add c.txt                              ;# staged add -> "A "
	writefile [file join $dir b.txt] "untracked\n"     ;# untracked -> "??"
	return $dir
}

if {[testConstraint hasgit]} { set ::repo [makerepo] }

# Index changes by path for order-independent assertions.
proc by_path {changes} {
	set d {}
	foreach c $changes { dict set d [dict get $c path] $c }
	return $d
}

test git-status-branch {status reports the current branch} -constraints hasgit -body {
	dict get [rio::git::status $::repo] branch
} -result main

test git-status-codes {status reports X/Y codes for staged, modified, untracked} -constraints hasgit -body {
	set c [by_path [dict get [rio::git::status $::repo] changes]]
	list [dict get $c a.txt y] [dict get $c c.txt x] [dict get $c b.txt x][dict get $c b.txt y]
} -result {M A ??}

test git-diff-worktree {diff shows the unstaged change to a.txt} -constraints hasgit -body {
	set d [rio::git::diff $::repo a.txt 0]
	list [string match {*a/a.txt*} $d] [string match "*+two*" $d]
} -result {1 1}

test git-diff-staged {diff --cached shows the staged add} -constraints hasgit -body {
	string match {*c.txt*} [rio::git::diff $::repo "" 1]
} -result 1

# A rename's diff must say "rename", not "new file". Asked for by the new name alone, git
# cannot see the source inside the pathspec and prints the whole file as an addition — so
# the diff described the change as the one thing it is not (the D97 lesson, one op over).
test git-diff-rename {a staged rename diffs as a rename, not a whole-file add} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	git_in $d mv a.txt r.txt        ;# ONE change, two names -> "R "
	set out [rio::git::diff $d r.txt 1]
	list [string match {*rename from a.txt*} $out] [string match {*rename to r.txt*} $out] \
		[string match {*new file*} $out]
} -cleanup {file delete -force $d} -result {1 1 0}

test git-diff-rename-edited {a rename carrying edits shows the rename AND the edit} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	# Its own committed file, several lines long: git calls a move a rename only while the
	# two sides stay similar enough (50% by default), and makerepo's one-line a.txt drops
	# under that threshold the moment an edit rides along.
	writefile [file join $d big.txt] "1\n2\n3\n4\n5\n6\n7\n8\n"
	git_in $d add big.txt ; git_in $d commit -q -m big
	git_in $d mv big.txt r.txt
	writefile [file join $d r.txt] "1\n2\n3\n4\n5\n6\n7\n8\nnine\n"
	git_in $d add r.txt             ;# edits staged too, still one "R " entry
	set out [rio::git::diff $d r.txt 1]
	list [string match {*rename from big.txt*} $out] [string match {*+nine*} $out]
} -cleanup {file delete -force $d} -result {1 1}

# The other half of an `RM`. The index and the worktree hold the file under the SAME name,
# so this diff is an ordinary edit and must read as one — no rename framing, and the edit
# still visible. (It does not prove the widening is skipped here: handing git the old name
# too changes nothing when that name is in neither side. The reason to skip it is the status
# call it would cost on every ordinary row click.)
test git-diff-rename-worktree {the unstaged half of an RM is a plain edit diff} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	git_in $d mv a.txt r.txt
	writefile [file join $d r.txt] "one\nlater\n"    ;# edit AFTER the mv -> "RM"
	set out [rio::git::diff $d r.txt 0]
	list [string match {*+later*} $out] [string match {*rename*} $out]
} -cleanup {file delete -force $d} -result {1 0}

test git-status-not-a-repo {status on a non-repo dir is a bad_request} -constraints hasgit -setup {
	set ::bare [file join [::tcltest::temporaryDirectory] riogit-bare-[clock clicks]]
	file mkdir $::bare
	# The temp dir lives inside rio's own repo, so stop git ascending out of the
	# bare dir — otherwise it discovers rio's .git and (wrongly) succeeds. The
	# ceiling is the dir git must not ascend INTO: the bare dir's parent.
	set ::env(GIT_CEILING_DIRECTORIES) [::tcltest::temporaryDirectory]
} -body {
	catch {rio::git::status $::bare} e opts
	rio::error::code_of $opts
} -cleanup {
	unset ::env(GIT_CEILING_DIRECTORIES)
	file delete -force $::bare
} -result bad_request

# --- through the in-process core --------------------------------------------

test git-op-status {git.status op returns {branch, changes}} -constraints hasgit -body {
	set resp [dict get [rio::core::call git.status [dict create cwd $::repo]] response]
	list [dict get $resp ok] [dict get $resp result branch] \
		[expr {[llength [dict get $resp result changes]] == 3}]
} -result {true main 1}

test git-op-status-defaults-to-project-root {with a project open, git.status needs no cwd} -constraints hasgit -setup {
	rio::project::open $::repo
} -body {
	set resp [dict get [rio::core::call git.status {}] response]
	list [dict get $resp ok] [dict get $resp result branch]
} -cleanup {
	rio::project::close
} -result {true main}

test git-op-diff {git.diff op returns {diff}} -constraints hasgit -body {
	set resp [dict get [rio::core::call git.diff [dict create cwd $::repo path a.txt]] response]
	list [dict get $resp ok] [string match "*+two*" [dict get $resp result diff]]
} -result {true 1}

test git-log-fields {log returns newest-first commits with parsed fields} -constraints hasgit -body {
	set commits [dict get [rio::git::log $::repo "" ""] commits]
	set top [lindex $commits 0]
	list [llength $commits] [dict get $top subject] [dict get $top author] \
		[string length [dict get $top hash]]
} -result {1 first tester 40}

test git-log-order-and-max {log is newest-first and respects max} -constraints hasgit -setup {
	set ::r2 [file join [::tcltest::temporaryDirectory] riogit-log-[clock clicks]]
	file mkdir $::r2
	git_in $::r2 init -q
	writefile [file join $::r2 f.txt] "1\n" ; git_in $::r2 add f.txt
	git_in $::r2 commit -q -m first
	writefile [file join $::r2 f.txt] "2\n" ; git_in $::r2 add f.txt
	git_in $::r2 commit -q -m second
} -body {
	set all [dict get [rio::git::log $::r2 "" ""] commits]
	set capped [dict get [rio::git::log $::r2 1 ""] commits]
	list [llength $all] [dict get [lindex $all 0] subject] \
		[llength $capped] [dict get [lindex $capped 0] subject]
} -cleanup {
	file delete -force $::r2
} -result {2 second 1 second}

test git-op-log {git.log op returns {commits}} -constraints hasgit -body {
	set resp [dict get [rio::core::call git.log [dict create cwd $::repo]] response]
	list [dict get $resp ok] [dict get [lindex [dict get $resp result commits] 0] subject]
} -result {true first}

test git-ops-registered {git.status, git.diff, git.log are in the live registry} -body {
	expr {"git.status" in [rio::dispatch::opnames] \
		&& "git.diff" in [rio::dispatch::opnames] \
		&& "git.log" in [rio::dispatch::opnames]}
} -result 1

test git-status-wire {git.status encodes to JSON with branch + a changes array} -body {
	set result [dict create branch main changes \
		[list [dict create x A y { } path c.txt]]]
	rio::wire::response [dict create id 1 ok true op git.status result $result]
} -result {{"id":"1","ok":true,"result":{"branch":"main","changes":[{"x":"A","y":" ","path":"c.txt"}]}}}

# --- write layer: add (track/stage) and unstage (D44) ------------------------
# These mutate the index, so each gets its OWN repo (makerepo: a.txt " M", c.txt
# "A ", b.txt "??") rather than the shared read-only $::repo. xy_of reads one path's
# two status chars back out.
proc xy_of {repo path} {
	set c [by_path [dict get [rio::git::status $repo] changes]]
	if {![dict exists $c $path]} { return "" }
	return "[dict get $c $path x][dict get $c $path y]"
}

test git-add-tracks-untracked {add stages an untracked file (?? -> A )} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	rio::git::add $d b.txt
	xy_of $d b.txt
} -cleanup {file delete -force $d} -result {A }

test git-add-stages-modified {add stages a modified tracked file ( M -> M )} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	rio::git::add $d a.txt
	xy_of $d a.txt
} -cleanup {file delete -force $d} -result {M }

test git-unstage-staged-add {unstage drops a staged add back to untracked (A  -> ??)} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	rio::git::unstage $d c.txt
	xy_of $d c.txt
} -cleanup {file delete -force $d} -result {??}

test git-unstage-unborn-head {unstage works on an unborn HEAD (no commits yet)} \
		-constraints hasgit -setup {
	set d [file join [::tcltest::temporaryDirectory] riogit-unborn-[clock clicks]]
	file mkdir $d ; git_in $d init -q ; git_in $d branch -M main
	writefile [file join $d f.txt] "hi\n" ; git_in $d add f.txt   ;# staged add, no HEAD
} -body {
	rio::git::unstage $d f.txt
	xy_of $d f.txt
} -cleanup {file delete -force $d} -result {??}

test git-op-add {git.add op stages through the core and returns ok} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set resp [dict get [rio::core::call git.add [dict create cwd $d path b.txt]] response]
	list [dict get $resp ok] [xy_of $d b.txt]
} -cleanup {file delete -force $d} -result {true {A }}

test git-op-unstage {git.unstage op unstages through the core and returns ok} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set resp [dict get [rio::core::call git.unstage [dict create cwd $d path c.txt]] response]
	list [dict get $resp ok] [xy_of $d c.txt]
} -cleanup {file delete -force $d} -result {true ??}

test git-commit-records-staged {commit records the staged index and clears it} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set hash [rio::git::commit $d "add c.txt"]
	# c.txt was staged (A ) -> now committed, so no longer a change; hash is the short SHA.
	list [regexp {^[0-9a-f]{4,}$} $hash] [xy_of $d c.txt]
} -cleanup {file delete -force $d} -result {1 {}}

test git-commit-unborn-head {commit works on an unborn HEAD (first commit)} \
		-constraints hasgit -setup {
	set d [file join [::tcltest::temporaryDirectory] riogit-commit0-[clock clicks]]
	file mkdir $d ; git_in $d init -q ; git_in $d branch -M main
	git_in $d config user.email t@example.com ; git_in $d config user.name tester
	writefile [file join $d f.txt] "hi\n" ; git_in $d add f.txt   ;# staged add, no HEAD
} -body {
	set hash [rio::git::commit $d "first"]
	list [regexp {^[0-9a-f]{4,}$} $hash] [dict get [rio::git::status $d] branch]
} -cleanup {file delete -force $d} -result {1 main}

test git-commit-nothing-staged {commit with nothing staged is a bad_request} \
		-constraints hasgit -setup {
	set d [file join [::tcltest::temporaryDirectory] riogit-clean-[clock clicks]]
	file mkdir $d ; git_in $d init -q ; git_in $d branch -M main
	writefile [file join $d f.txt] "hi\n" ; git_in $d add f.txt ; git_in $d commit -q -m first
} -body {
	catch {rio::git::commit $d "nope"} err opts
	rio::error::code_of $opts
} -cleanup {file delete -force $d} -result bad_request

test git-op-commit {git.commit op commits through the core and returns the hash} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set resp [dict get [rio::core::call git.commit \
		[dict create cwd $d message "via op"]] response]
	list [dict get $resp ok] [regexp {^[0-9a-f]{4,}$} [dict get $resp result hash]] \
		[xy_of $d c.txt]
} -cleanup {file delete -force $d} -result {true 1 {}}

# --- write layer: discard (D80) ---------------------------------------------
# Discard throws away a path's local changes: a tracked file reverts to its last commit
# (both staged and worktree edits dropped); a new file (untracked or staged-add) is
# removed; a rename goes back to its old name (D97). Same makerepo states (a.txt " M",
# c.txt "A ", b.txt "??"); a.txt's committed baseline is "one\n". The proc returns
# {action ..., paths ...} — `paths` is what the op turns into fs.changed (D94).
proc slurp {path} { set fh [open $path] ; set c [read $fh] ; close $fh ; return $c }
proc discard_action {dir path} { dict get [rio::git::discard $dir $path] action }

test git-discard-modified {discard reverts a modified tracked file to HEAD (returns revert)} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set act [discard_action $d a.txt]
	list $act [string trim [slurp [file join $d a.txt]]] [xy_of $d a.txt]
} -cleanup {file delete -force $d} -result {revert one {}}

test git-discard-staged-modification {discard reverts AND unstages a staged modification} \
		-constraints hasgit -setup {set d [makerepo] ; rio::git::add $d a.txt} -body {
	set act [discard_action $d a.txt]
	list $act [string trim [slurp [file join $d a.txt]]] [xy_of $d a.txt]
} -cleanup {file delete -force $d} -result {revert one {}}

test git-discard-untracked {discard removes an untracked new file (returns remove)} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set act [discard_action $d b.txt]
	list $act [file exists [file join $d b.txt]] [xy_of $d b.txt]
} -cleanup {file delete -force $d} -result {remove 0 {}}

test git-discard-staged-add {discard removes a staged-add file (returns remove)} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set act [discard_action $d c.txt]
	list $act [file exists [file join $d c.txt]] [xy_of $d c.txt]
} -cleanup {file delete -force $d} -result {remove 0 {}}

# Rename-aware discard (D97). `git mv a.txt r.txt` is ONE change with two names, so undoing
# it has to put a.txt back — with its committed content — and take r.txt away. Before D97
# the plain tracked branch ran and left r.txt behind as an untracked file: the rename was
# unstaged, not undone.
test git-discard-rename {discard undoes a rename — the file returns under its old name} \
		-constraints hasgit -setup {
	set d [makerepo]
	writefile [file join $d a.txt] "one\n"      ;# back to the committed content: a CLEAN "R "
	git_in $d mv a.txt r.txt
} -body {
	set r [rio::git::discard $d r.txt]
	list [dict get $r action] [file exists [file join $d r.txt]] \
		[string trim [slurp [file join $d a.txt]]] [xy_of $d a.txt] [xy_of $d r.txt]
} -cleanup {file delete -force $d} -result {revert 0 one {} {}}

test git-discard-rename-paths {a discarded rename reports BOTH names, so both get fs.changed} \
		-constraints hasgit -setup {set d [makerepo] ; git_in $d mv a.txt r.txt} -body {
	lsort [dict get [rio::git::discard $d r.txt] paths]
} -cleanup {file delete -force $d} -result {a.txt r.txt}

test git-discard-rename-edited {a rename WITH edits discards the edits too, under the old name} \
		-constraints hasgit -setup {
	set d [makerepo]
	git_in $d mv a.txt r.txt
	writefile [file join $d r.txt] "one\nedited\n"
} -body {
	list [discard_action $d r.txt] [file exists [file join $d r.txt]] \
		[string trim [slurp [file join $d a.txt]]]
} -cleanup {file delete -force $d} -result {revert 0 one}

# A COPY is not a rename: the new file is an addition and the source was never touched, so
# discarding it removes the copy and must leave the source exactly as it was.
test git-discard-copy {discard removes a staged copy and leaves its source alone} \
		-constraints hasgit -setup {
	set d [makerepo]
	git_in $d config status.renames copies
	file copy [file join $d a.txt] [file join $d cp.txt]
	git_in $d add cp.txt
} -body {
	set act [discard_action $d cp.txt]
	list $act [file exists [file join $d cp.txt]] [file exists [file join $d a.txt]]
} -cleanup {file delete -force $d} -result {remove 0 1}

test git-discard-nothing {discard on a path with no changes is a bad_request} \
		-constraints hasgit -setup {
	set d [file join [::tcltest::temporaryDirectory] riogit-clean-[clock clicks]]
	file mkdir $d ; git_in $d init -q ; git_in $d branch -M main
	writefile [file join $d f.txt] "hi\n" ; git_in $d add f.txt ; git_in $d commit -q -m first
} -body {
	catch {rio::git::discard $d f.txt} err opts
	rio::error::code_of $opts
} -cleanup {file delete -force $d} -result bad_request

test git-op-discard {git.discard op discards through the core and returns the action} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set resp [dict get [rio::core::call git.discard [dict create cwd $d path b.txt]] response]
	list [dict get $resp ok] [dict get $resp result action] [file exists [file join $d b.txt]]
} -cleanup {file delete -force $d} -result {true remove 0}

# --- write layer: discard_all (D93) ------------------------------------------
# The bulk form: every change at once, in git rather than by looping the per-path op.
# makerepo gives three changes in one go (a.txt " M", c.txt "A ", b.txt "??").

test git-discard-all-mixed {discard_all reverts, removes and unstages the whole repo at once} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set r [rio::git::discard_all $d]
	list [dict get $r count] [lsort [dict get $r paths]] \
		[llength [dict get [rio::git::status $d] changes]] \
		[string trim [slurp [file join $d a.txt]]] \
		[file exists [file join $d b.txt]] [file exists [file join $d c.txt]]
} -cleanup {file delete -force $d} -result {3 {a.txt b.txt c.txt} 0 one 0 0}

test git-discard-all-restores-deletion {discard_all brings back a deleted tracked file} \
		-constraints hasgit -setup {
	set d [makerepo] ; file delete [file join $d a.txt]      ;# " D" on top of the rest
} -body {
	rio::git::discard_all $d
	list [file exists [file join $d a.txt]] [string trim [slurp [file join $d a.txt]]] \
		[llength [dict get [rio::git::status $d] changes]]
} -cleanup {file delete -force $d} -result {1 one 0}

test git-discard-all-keeps-ignored {discard_all leaves git-ignored files alone (no clean -x)} \
		-constraints hasgit -setup {
	set d [makerepo]
	writefile [file join $d .gitignore] "out.log\n"
	git_in $d add .gitignore ; git_in $d commit -q -m ignore
	writefile [file join $d out.log] "build noise\n"          ;# ignored, not a change
} -body {
	rio::git::discard_all $d
	list [file exists [file join $d out.log]] \
		[llength [dict get [rio::git::status $d] changes]]
} -cleanup {file delete -force $d} -result {1 0}

test git-discard-all-unborn-head {discard_all works with no commits yet (nothing to revert to)} \
		-constraints hasgit -setup {
	set d [file join [::tcltest::temporaryDirectory] riogit-dall0-[clock clicks]]
	file mkdir $d ; git_in $d init -q ; git_in $d branch -M main
	git_in $d config user.email t@example.com ; git_in $d config user.name tester
	writefile [file join $d s.txt] "staged\n" ; git_in $d add s.txt   ;# "A ", unborn HEAD
	writefile [file join $d u.txt] "untracked\n"                      ;# "??"
} -body {
	set r [rio::git::discard_all $d]
	list [dict get $r count] [file exists [file join $d s.txt]] \
		[file exists [file join $d u.txt]] \
		[llength [dict get [rio::git::status $d] changes]]
} -cleanup {file delete -force $d} -result {2 0 0 0}

test git-discard-all-nothing {discard_all on a clean repo is a bad_request} \
		-constraints hasgit -setup {
	set d [file join [::tcltest::temporaryDirectory] riogit-dallclean-[clock clicks]]
	file mkdir $d ; git_in $d init -q ; git_in $d branch -M main
	writefile [file join $d f.txt] "hi\n" ; git_in $d add f.txt ; git_in $d commit -q -m first
} -body {
	catch {rio::git::discard_all $d} err opts
	rio::error::code_of $opts
} -cleanup {file delete -force $d} -result bad_request

test git-op-discard-all {git.discard_all op clears the repo through the core and counts} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set resp [dict get [rio::core::call git.discard_all [dict create cwd $d]] response]
	list [dict get $resp ok] [dict get $resp result count] \
		[llength [dict get [rio::git::status $d] changes]]
} -cleanup {file delete -force $d} -result {true 3 0}

test git-discard-all-rename-both-ends {a reverted rename lists both names among the paths} \
		-constraints hasgit -setup {
	set d [makerepo]
	git_in $d add -A ; git_in $d commit -q -m base              ;# clean tree first
	git_in $d mv a.txt renamed.txt                              ;# one entry, two names
} -body {
	set r [rio::git::discard_all $d]
	list [dict get $r count] [lsort [dict get $r paths]] \
		[file exists [file join $d a.txt]] [file exists [file join $d renamed.txt]]
} -cleanup {file delete -force $d} -result {1 {a.txt renamed.txt} 1 0}

# --- D94: rio announces the disk writes it causes itself ---------------------
# Until now git.discard/git.discard_all rewrote the worktree in silence — the file pane
# would not repaint and an open buffer could not learn it had gone stale. They emit
# fs.changed with an absolute path now, exactly as fs.write/create/rename/delete do.

test git-op-discard-emits-fs-changed {git.discard emits fs.changed for the path it touched} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set r [rio::core::call git.discard [dict create cwd $d path a.txt]]
	set evs [dict get $r events]
	list [llength $evs] [dict get [lindex $evs 0] event] \
		[expr {[dict get [lindex $evs 0] params path] eq [file join $d a.txt]}]
} -cleanup {file delete -force $d} -result {1 fs.changed 1}

test git-op-discard-all-emits-fs-changed {git.discard_all emits one fs.changed per path} \
		-constraints hasgit -setup {set d [makerepo]} -body {
	set evs [dict get [rio::core::call git.discard_all [dict create cwd $d]] events]
	set names {}
	set kinds {}
	foreach ev $evs {
		lappend kinds [dict get $ev event]
		set p [dict get $ev params path]
		# absolute, and under the repo — record the tail so the result is stable
		if {[file dirname $p] eq $d} { lappend names [file tail $p] }
	}
	list [lsort -unique $kinds] [lsort $names]
} -cleanup {file delete -force $d} -result {fs.changed {a.txt b.txt c.txt}}

test git-write-ops-registered {git.add, git.unstage, git.commit, git.discard, git.discard_all are in the live registry} -body {
	expr {"git.add" in [rio::dispatch::opnames] \
		&& "git.unstage" in [rio::dispatch::opnames] \
		&& "git.commit" in [rio::dispatch::opnames] \
		&& "git.discard" in [rio::dispatch::opnames] \
		&& "git.discard_all" in [rio::dispatch::opnames]}
} -result 1

if {[testConstraint hasgit] && [info exists ::repo]} {
	file delete -force $::repo
}
cleanupTests
