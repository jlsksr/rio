# Tests for the shared HTTPS transport (rio::llm::http, AGENTS.md D8/D26). TLS and
# any real LLM are not involved: the transport is driven over plain HTTP against a
# local one-shot server, which is enough to exercise the http plumbing — the
# streaming handler, the buffered POST, the request body, and the status mapping.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. transport.tcl]

# A one-shot HTTP/1.1 server: reads the request (capturing it in ::srv_req),
# then replies with the given status + body and closes.
#
# Every read here is NON-BLOCKING and driven by fileevents, which matters more than it
# looks. This server shares its process — and so its single event loop — with the async
# client it is serving: ::http writes the request from that same loop. A blocking `gets`
# in this callback therefore starves the client, and the server ends up waiting for
# headers that nobody can now send. That deadlock is latent on Linux, where a loopback
# connect completes so promptly that the whole request is already buffered by the time
# this callback first runs; it is reproducible on Windows, where the async connect
# completes via the event loop and geturl returns having written only the request line
# (verified: the server read "POST /v1/messages HTTP/1.0" and then hung forever).
# Reading from fileevents keeps the loop turning for both sides on either host.
proc http_accept {status body chan addr port} {
	fconfigure $chan -translation crlf -blocking 0
	set ::srvconn($chan) [dict create phase head line "" hdrs {} clen 0 body "" \
		status $status reply $body]
	fileevent $chan readable [list http_handle $chan]
}
proc http_handle {chan} {
	set st $::srvconn($chan)
	if {[dict get $st phase] eq "head"} {
		while {[gets $chan line] >= 0} {
			if {[dict get $st line] eq ""} { dict set st line $line ; continue }
			if {$line eq ""} {
				dict set st phase body
				fconfigure $chan -translation binary
				break
			}
			dict lappend st hdrs $line
			if {[regexp -nocase {^Content-Length:\s*(\d+)} $line -> n]} { dict set st clen $n }
		}
		set ::srvconn($chan) $st
		if {[dict get $st phase] eq "head"} { return }   ;# a partial request: wait for more
	}
	dict append st body [read $chan]
	set ::srvconn($chan) $st
	if {[string length [dict get $st body]] < [dict get $st clen] && ![eof $chan]} { return }
	set ::srv_req [dict create line [dict get $st line] \
		headers [dict get $st hdrs] body [dict get $st body]]
	http_reply $chan
}
# The response is a couple of hundred bytes — well inside the socket buffer — so this
# one blocking write cannot stall the way a blocking READ can.
proc http_reply {chan} {
	set st $::srvconn($chan) ; unset ::srvconn($chan)
	set status [dict get $st status] ; set body [dict get $st reply]
	fileevent $chan readable {}
	fconfigure $chan -translation crlf -blocking 1
	puts $chan "HTTP/1.1 $status [expr {$status == 200 ? {OK} : {Error}}]"
	puts $chan "Content-Type: text/event-stream"
	puts $chan "Content-Length: [string length $body]"
	puts $chan "Connection: close"
	puts $chan ""
	fconfigure $chan -translation binary
	puts -nonewline $chan $body ; flush $chan ; close $chan
}
proc serve {status body} { socket -myaddr 127.0.0.1 -server [list http_accept $status $body] 0 }
proc port_of {srv} { lindex [fconfigure $srv -sockname] 2 }

proc tchunk {c} { append ::tchunks $c }
proc tdone {status err} { set ::tdone [list $status $err] }
proc run_stream {url body} {
	set ::tchunks "" ; set ::tdone ""
	rio::llm::http::stream \
		[dict create url $url headers {Content-Type application/json} body $body] tchunk tdone
	set t [after 5000 {set ::tdone TIMEOUT}] ; vwait ::tdone ; after cancel $t
}

set ::sse "data: {\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"hi\"}}\n\ndata: {\"type\":\"message_stop\"}\n\n"

test transport-headers-split {Content-Type is split out; other headers pass through} -body {
	set rest [rio::llm::http::_headers {Content-Type application/json x-api-key K} ct]
	list $ct $rest
} -result {application/json {x-api-key K}}

test transport-stream-200 {a streamed 200 delivers the body to on_chunk and ends ok} -setup {
	set srv [serve 200 $::sse]
} -body {
	run_stream "http://127.0.0.1:[port_of $srv]/v1/messages" {{"q":1}}
	list $::tdone $::tchunks
} -cleanup { close $srv } -result [list {200 {}} $::sse]

test transport-stream-sends-body {the streamed POST carries our body to the server} -setup {
	set srv [serve 200 $::sse]
} -body {
	run_stream "http://127.0.0.1:[port_of $srv]/v1/messages" {{"hello":"world"}}
	list [string match "POST /v1/messages*" [dict get $::srv_req line]] [dict get $::srv_req body]
} -cleanup { close $srv } -result {1 {{"hello":"world"}}}

test transport-stream-401 {a non-200 is reported with its status (body still streamed)} -setup {
	set srv [serve 401 {{"type":"error","error":{"message":"bad token"}}}]
} -body {
	run_stream "http://127.0.0.1:[port_of $srv]/v1/messages" {{}}
	lindex $::tdone 0
} -cleanup { close $srv } -result 401

test transport-connect-fail {a connection that can't be made is status 0} -body {
	set srv [serve 200 x] ; set p [port_of $srv] ; close $srv   ;# free, then nobody listening
	run_stream "http://127.0.0.1:$p/" {{}}
	lindex $::tdone 0
} -result 0

# --- the host-name gate (D110) -----------------------------------------------
#
# A tcltls older than 1.8 never compares a certificate's name with the host, so the agent
# refuses https there unless the core says the user allowed it. Driven with no network:
# `checks_hostname` answers what a 1.7 would, `::http::geturl` only records that it was
# reached, and the core-wide switch `rio::tls::unchecked_ok` (D114) answers per case.
# (tcltls itself is really loaded first; a fake `package provide tls 1.7` cannot coexist
# with the real one in the same interpreter.)
rio::tls::ensure
proc gate {checks allow url {seam stream}} {
	set ::dialled 0 ; set ::gdone ""
	rename ::rio::tls::checks_hostname ::_real_checks
	proc ::rio::tls::checks_hostname {} [list return $checks]
	rename ::http::geturl ::_real_geturl
	proc ::http::geturl {args} { set ::dialled 1 ; error "not dialled in this test" }
	# "absent": the real switch, pointed at a tls.conf that doesn't exist.
	set ::rio::tls::settings_override [file join [temporaryDirectory] rio-no-such-tls-[pid].conf]
	rename ::rio::tls::unchecked_ok ::_real_unchecked
	if {$allow ne "absent"} { proc ::rio::tls::unchecked_ok {} [list return $allow] } else { rename ::_real_unchecked ::rio::tls::unchecked_ok }
	try {
		set req [dict create url $url headers {} body {}]
		if {$seam eq "stream"} {
			rio::llm::http::stream $req tchunk {apply {{s e} { set ::gdone [list $s $e] }}}
		} else {
			rio::llm::http::get $req {apply {{s e b} { set ::gdone [list $s $e] }}}
		}
	} finally {
		rename ::rio::tls::checks_hostname {} ; rename ::_real_checks ::rio::tls::checks_hostname
		rename ::http::geturl {} ; rename ::_real_geturl ::http::geturl
		if {[llength [info commands ::_real_unchecked]]} {
			rename ::rio::tls::unchecked_ok {} ; rename ::_real_unchecked ::rio::tls::unchecked_ok
		}
		set ::rio::tls::settings_override ""
	}
	# refused-before-dialling? what did on_done say? did it name the way out?
	list $::dialled [lindex $::gdone 0] \
		[string match {*refused https to api.example.com*Install tcltls 1.8*Preferences*Network*Allow https without host-name checks*} [lindex $::gdone 1]]
}

test transport-gate-refuses-by-default {https on a tcltls without host-name checks is refused before dialling — with no core setting the answer is no} -body {
	gate 0 absent https://api.example.com/v1/messages
} -result {0 0 1}

test transport-gate-refuses-when-not-allowed {the core's setting off refuses the same} -body {
	gate 0 0 https://api.example.com/v1/messages
} -result {0 0 1}

test transport-gate-allowed {the core's setting on lets it through to the dial} -body {
	lrange [gate 0 1 https://api.example.com/v1/messages] 0 0
} -result 1

test transport-gate-get-seam {the model-list GET is gated the same as the streamed turn} -body {
	gate 0 absent https://api.example.com/v1/models get
} -result {0 0 1}

test transport-gate-plain-http {plain http is never gated — a local model server keeps working on any tcltls} -body {
	lrange [gate 0 absent http://127.0.0.1:11434/v1/chat/completions] 0 0
} -result 1

test transport-gate-checking-tcltls {a tcltls that checks host names is never gated, whatever the setting} -body {
	list [lindex [gate 1 absent https://api.example.com/v1/messages] 0] \
		[lindex [gate 1 0 https://api.example.com/v1/models get] 0]
} -result {1 1}

cleanupTests
