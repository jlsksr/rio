# Tests for the claude-oauth face (rio::claude::oauth, AGENTS.md D26): the OAuth
# paste-a-code sign-in (verified Claude Code flow — hosted callback), auth
# resolution, and the provider. Network stays a seam (a fake token transport, a
# fake SSE transport) and the browser is a no-op, so the whole flow runs offline.
package require tcltest
namespace import ::tcltest::*

source [file join [file dirname [info script]] .. .. .. rio-core core.tcl]
source [file join [file dirname [info script]] .. inference.tcl]
source [file join [file dirname [info script]] .. oauth-face.tcl]

# Keep secrets in a throwaway dir; don't actually launch a browser.
set rio::secret::override_dir [file join [::tcltest::temporaryDirectory] rioccf-[clock clicks]]
set rio::oauth::opener [list apply {{url} {return 1}}]

proc collect_post {args} { lappend ::posts $args }
proc collect_ev {ev} {
	lappend ::evs $ev
	switch -- [dict get $ev event] { agent.message - agent.error { set ::fin done } }
}
proc fake_token {status body req on_result} { {*}$on_result $status $body }
proc fake_sse {sse status req on_chunk on_done} { {*}$on_chunk $sse ; {*}$on_done $status "" }

# Drive a paste sign-in: start the flow (stashing PKCE+state), then feed back a
# pasted "code#state" built per `mode` (good = the real state, bad = wrong state,
# none = no state suffix, empty = nothing). complete_sign_in is synchronous here
# because the fake token transport resolves immediately.
proc paste_signin {code mode} {
	rio::claude::oauth::sign_in
	set st [dict get $::rio::claude::oauth::pending state]
	switch -- $mode {
		good  { set pasted "$code#$st" }
		bad   { set pasted "$code#WRONGSTATE" }
		none  { set pasted $code }
		empty { set pasted "" }
	}
	set ::res {}
	rio::claude::oauth::complete_sign_in $pasted [list set ::res]
	return $::res
}

# --- URL / form encoding -----------------------------------------------------

test claude-oauth-urlenc {form encoding escapes spaces and reserved chars} -body {
	rio::claude::oauth::_form {a {b c} d e:f}
} -result {a=b%20c&d=e%3Af}

test claude-oauth-authorize-url {the authorize URL carries code=true, PKCE, state, hosted redirect} -body {
	set url [rio::claude::oauth::_authorize_url CHAL STATE123]
	list [string match "https://claude.ai/oauth/authorize?*" $url] \
		[string match "*code=true*" $url] \
		[string match "*response_type=code*" $url] \
		[string match "*code_challenge=CHAL*" $url] \
		[string match "*code_challenge_method=S256*" $url] \
		[string match "*state=STATE123*" $url] \
		[string match "*redirect_uri=https%3A%2F%2Fconsole.anthropic.com%2Foauth%2Fcode%2Fcallback*" $url]
} -result {1 1 1 1 1 1 1}

# --- auth resolution + provider ----------------------------------------------

test claude-oauth-not-signed-in {with no token the provider posts not_signed_in} -setup {
	rio::claude::oauth::sign_out
} -body {
	set ::posts {}
	rio::claude::oauth::provider {{role user text hi}} {} collect_post
	lindex [lindex $::posts 0] 1
} -result not_signed_in

test claude-oauth-sign-out {sign_out forgets the credential} -setup {
	rio::secret::save claude-oauth {access_token AT}
} -body {
	set before [rio::claude::oauth::signed_in]
	rio::claude::oauth::sign_out
	list $before [rio::claude::oauth::signed_in]
} -result {1 0}

# --- the paste sign-in flow (fake exchange) ----------------------------------

test claude-oauth-signin-success {a pasted code is exchanged and the token saved} -setup {
	rio::claude::oauth::sign_out
	set ::rio::claude::oauth::token_transport \
		[list fake_token 200 {{"access_token":"AT","refresh_token":"RT","expires_in":3600}}]
} -body {
	set res [paste_signin GOODCODE good]
	list [dict get $res ok] [rio::claude::oauth::signed_in] \
		[dict get [rio::secret::get claude-oauth] access_token] \
		[dict get [rio::secret::get claude-oauth] refresh_token]
} -cleanup {
	set ::rio::claude::oauth::token_transport rio::claude::oauth::_token_http
} -result {true 1 AT RT}

test claude-oauth-signin-state-mismatch {a wrong pasted state aborts before any exchange} -setup {
	rio::claude::oauth::sign_out
	set ::rio::claude::oauth::token_transport [list fake_token 200 {{"access_token":"NO"}}]
} -body {
	set res [paste_signin GOODCODE bad]
	list [dict get $res ok] [dict get $res code] [rio::claude::oauth::signed_in]
} -cleanup {
	set ::rio::claude::oauth::token_transport rio::claude::oauth::_token_http
} -result {false state_mismatch 0}

test claude-oauth-signin-denied {an empty paste is reported as denied} -setup {
	rio::claude::oauth::sign_out
} -body {
	set res [paste_signin "" empty]
	list [dict get $res ok] [dict get $res code]
} -result {false denied}

test claude-oauth-signin-exchange-fails {a non-200 token exchange is a classified error} -setup {
	rio::claude::oauth::sign_out
	set ::rio::claude::oauth::token_transport [list fake_token 400 {{"error":"invalid_grant"}}]
} -body {
	set res [paste_signin GOODCODE good]
	list [dict get $res ok] [dict get $res code] [rio::claude::oauth::signed_in]
} -cleanup {
	set ::rio::claude::oauth::token_transport rio::claude::oauth::_token_http
} -result {false exchange 0}

test claude-oauth-complete-without-start {completing with no flow in progress is rejected} -body {
	set ::rio::claude::oauth::pending {}
	set ::r {}
	rio::claude::oauth::complete_sign_in "X#Y" [list set ::r]
	dict get $::r code
} -result no_flow

# --- the spoof: OAuth inference must identify as Claude Code ------------------

test claude-oauth-system-spoof {the request carries the required Claude Code system prompt} -setup {
	rio::secret::save claude-oauth {access_token AT}
	set ::seen ""
	proc capture_tp {req on_chunk on_done} { set ::seen [dict get $req body] ; {*}$on_done 200 "" }
	set ::rio::claude::oauth::transport capture_tp
} -body {
	rio::claude::oauth::provider {{role user text hi}} {} collect_post
	string match {*You are Claude Code, Anthropic's official CLI for Claude.*} \
		[dict get [json::json2dict $::seen] system]
} -cleanup {
	set ::rio::claude::oauth::transport rio::claude::oauth::_http_transport
	rio::claude::oauth::sign_out
} -result 1

# --- end to end: a signed-in provider streams through the real agent loop -----

set ::face_sse ""
append ::face_sse "data: {\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"Hi there\"}}\n\n"
append ::face_sse "data: {\"type\":\"message_stop\"}\n\n"

test claude-oauth-provider-streams {a signed-in provider streams a Claude reply via agent.send} -setup {
	rio::secret::save claude-oauth {access_token AT refresh_token RT expires_at 9999999999}
	set ::rio::claude::oauth::transport [list fake_sse $::face_sse 200]
	rio::agent::set_provider rio::claude::oauth::provider
	rio::core::call agent.reset {}
} -body {
	set ::evs {} ; set ::fin {}
	rio::core::call_stream agent.send {text {say hi}} collect_ev
	set t [after 3000 {set ::fin timeout}] ; vwait ::fin ; after cancel $t
	set reply ""
	foreach ev $::evs { if {[dict get $ev event] eq "agent.message"} { set reply [dict get $ev params text] } }
	list $::fin $reply
} -cleanup {
	rio::agent::set_provider ::rio::agent::echo_provider
	set ::rio::claude::oauth::transport rio::claude::oauth::_http_transport
	rio::claude::oauth::sign_out
} -result {done {Hi there}}

file delete -force $rio::secret::override_dir
cleanupTests
