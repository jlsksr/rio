# Tests for the shared Claude inference core (rio::claude, AGENTS.md D8/D26):
# request shaping, the streaming SSE -> agent-event mapping, and HTTP-status
# error classification. The network is faked — a transport replays canned bytes
# — so this is deterministic and offline. (The real tcltls transport is step 3.)
package require tcltest
namespace import ::tcltest::*
package require json

source [file join [file dirname [info script]] .. inference.tcl]

set ::conf [dict create \
	messages_url      https://api.test/v1/messages \
	anthropic_version 2023-06-01 \
	model             claude-test \
	max_tokens        1024]

# A fake transport: `[list fake_transport $chunks $status $err]` replays the body
# chunks to on_chunk (in whatever pieces given, to exercise line buffering), then
# calls on_done with the status. Synchronous — deterministic for assertions.
proc fake_transport {chunks status err req on_chunk on_done} {
	foreach c $chunks { {*}$on_chunk $c }
	{*}$on_done $status $err
}
# Collect the provider `post` calls.
proc collect_post {args} { lappend ::posts $args }
proc run_infer {chunks status {err ""} {auth {x-api-key T}} {tools {}}} {
	set ::posts {}
	rio::claude::infer $::conf {{role user text hi}} $tools $auth \
		[list fake_transport $chunks $status $err] collect_post
}
# The post calls of one kind, each as the args list after the kind word.
proc posts_of {kind} {
	set out {}
	foreach p $::posts { if {[lindex $p 0] eq $kind} { lappend out [lrange $p 1 end] } }
	return $out
}
proc deltas {} {
	set t ""
	foreach p $::posts { if {[lindex $p 0] eq "delta"} { append t [lindex $p 1] } }
	return $t
}
proc terminal {} { lindex $::posts end }

# A normal streamed text completion. Built with append (no backslash-newline
# continuations, which would collapse to spaces and corrupt the `data:` lines).
set ::sse ""
append ::sse "event: message_start\n"
append ::sse "data: {\"type\":\"message_start\"}\n\n"
append ::sse "event: content_block_delta\n"
append ::sse "data: {\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Hello\"}}\n\n"
append ::sse "data: {\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\" world\"}}\n\n"
append ::sse "data: {\"type\":\"message_stop\"}\n\n"

# --- request shaping ---------------------------------------------------------

test claude-request-shape {the request JSON carries model, stream, and the messages} -body {
	set body [rio::claude::_request_json $::conf \
		[list [dict create role user text {hi "there"}] [dict create role assistant text ok]] {}]
	set d [json::json2dict $body]
	set blk0 [lindex [dict get [lindex [dict get $d messages] 0] content] 0]
	list [dict get $d model] [dict get $d max_tokens] [dict get $d stream] \
		[llength [dict get $d messages]] \
		[dict get [lindex [dict get $d messages] 0] role] \
		[dict get $blk0 type] [dict get $blk0 text] \
		[dict exists $d system] [dict exists $d tools]
} -result {claude-test 1024 true 2 user text {hi "there"} 0 0}

test claude-request-system {a system prompt is included when set} -body {
	set c [dict merge $::conf {system {You are terse.}}]
	dict get [json::json2dict [rio::claude::_request_json $c {{role user text hi}} {}]] system
} -result {You are terse.}

test claude-request-tools {tool specs ride along as a top-level tools array} -body {
	set tools [list [dict create name fs_read description "read a file" \
		input_schema {{"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}}]]
	set d [json::json2dict [rio::claude::_request_json $::conf {{role user text hi}} $tools]]
	set t [lindex [dict get $d tools] 0]
	list [llength [dict get $d tools]] [dict get $t name] \
		[dict get $t description] [dict get $t input_schema type] \
		[dict get $t input_schema required]
} -result {1 fs_read {read a file} object path}

test claude-tooluse-controlchars {a tool_use input with literal control chars re-serializes to a valid, ASCII body} -body {
	# `raw` is deliberately bogus — the encoder must use the parsed `input` and
	# escape its literal newline/tab, not splice raw (which would break the body).
	set convo [list [dict create role assistant content [list \
		[dict create type tool_use id t1 name propose_edit \
			input [dict create path f.txt new_string "a\nb\tc→d"] raw {NOT VALID}]]]]
	set body [rio::claude::_request_json $::conf $convo {}]
	set blk [lindex [dict get [lindex [dict get [json::json2dict $body] messages] 0] content] 0]
	list [string is ascii $body] [expr {[dict get $blk input new_string] eq "a\nb\tc→d"}]
} -result {1 1}

test claude-request-tool-roundtrip {tool_use/tool_result content blocks serialize for the follow-up request} -body {
	set convo [list \
		[dict create role user content [list [dict create type text text "list it"]]] \
		[dict create role assistant content [list \
			[dict create type tool_use id tu_1 name fs_list input {path src} raw {{"path":"src"}}]]] \
		[dict create role user content [list \
			[dict create type tool_result tool_use_id tu_1 content "a.tcl\nb.tcl" is_error 0]]]]
	set d [json::json2dict [rio::claude::_request_json $::conf $convo {}]]
	set use [lindex [dict get [lindex [dict get $d messages] 1] content] 0]
	set res [lindex [dict get [lindex [dict get $d messages] 2] content] 0]
	list [dict get $use type] [dict get $use id] [dict get $use name] \
		[dict get $use input path] \
		[dict get $res type] [dict get $res tool_use_id] [dict get $res content]
} -result {tool_use tu_1 fs_list src tool_result tu_1 {a.tcl
b.tcl}}

test claude-jstr-escapes {the JSON string escaper handles quotes, backslashes, controls} -body {
	rio::claude::_jstr "a\"b\\c\nd\te"
} -result {"a\"b\\c\nd\te"}

test claude-jstr-nonascii {non-ASCII is escaped: the literal is ASCII-only and round-trips} -body {
	set j [rio::claude::_jstr "a→b…"]
	list [string is ascii $j] [json::json2dict $j]
} -result {1 a→b…}

test claude-jstr-astral {an astral codepoint escapes to a UTF-16 surrogate pair} -body {
	# U+1F600 the way a file read delivers it (4 UTF-8 bytes F0 9F 98 80) — on a
	# narrow Tcl build a surrogate pair, on a wide build one codepoint; both must
	# spell 😀 in the body.
	set ch [encoding convertfrom utf-8 "\xF0\x9F\x98\x80"]
	set j [rio::claude::_jstr "x$ch"]
	list [string is ascii $j] [string match {*\\ud83d\\ude00*} $j]
} -result {1 1}

test claude-request-ascii-body {a tool_result with non-ASCII text yields a pure-ASCII body} -body {
	set convo [list [dict create role user content [list \
		[dict create type tool_result tool_use_id t1 content "arrow → and 日本 text" is_error 0]]]]
	string is ascii [rio::claude::_request_json $::conf $convo {}]
} -result 1

# --- streaming SSE -> events -------------------------------------------------

test claude-stream-text {text deltas accumulate, ending with done} -body {
	run_infer [list $::sse] 200
	list [deltas] [terminal]
} -result {{Hello world} done}

test claude-stream-chunk-split {the same stream split mid-line parses identically} -body {
	set chunks {}
	for {set i 0} {$i < [string length $::sse]} {incr i 7} {
		lappend chunks [string range $::sse $i [expr {$i + 6}]]
	}
	run_infer $chunks 200
	list [deltas] [terminal]
} -result {{Hello world} done}

test claude-stream-error-event {an SSE error event becomes a classified post error} -body {
	run_infer [list "data: {\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"slow down\"}}\n\n"] 200
	terminal
} -result {error overloaded_error {slow down}}

test claude-stream-clean-close {a 200 that ends without message_stop still finishes the turn} -body {
	run_infer [list "data: {\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"hi\"}}\n\n"] 200
	list [deltas] [terminal]
} -result {hi done}

# --- error classification (D26 resilience) -----------------------------------

test claude-http-401 {a 401 is an actionable auth error, with the API's detail} -body {
	set body {{"type":"error","error":{"type":"authentication_error","message":"invalid bearer token"}}}
	run_infer [list $body] 401
	set t [terminal]
	list [lindex $t 0] [lindex $t 1] \
		[string match {*HTTP 401*check your API key*invalid bearer token*} [lindex $t 2]]
} -result {error auth 1}

test claude-http-429 {a 429 is a rate-limit error} -body {
	run_infer [list ""] 429
	lindex [terminal] 1
} -result rate_limit

test claude-http-500 {a 5xx is a server error} -body {
	run_infer [list ""] 503
	lindex [terminal] 1
} -result server

test claude-http-unexpected {an unmapped status is the break-without-notice case} -body {
	run_infer [list ""] 418
	set t [terminal]
	list [lindex $t 1] [string match {*the integration may need an update*} [lindex $t 2]]
} -result {unexpected 1}

test claude-network-fail {a failure to connect (status 0) is a network error} -body {
	run_infer [list ""] 0 "connection refused"
	set t [terminal]
	list [lindex $t 1] [string match {*connection refused*} [lindex $t 2]]
} -result {network 1}

test claude-tls-missing {status 0 from a missing tcltls is a distinct, actionable error — not "check your connection"} -body {
	run_infer [list ""] 0 "can't find package tls"
	set t [terminal]
	list [lindex $t 1] \
		[string match {*install tcltls*} [lindex $t 2]] \
		[string match {*check your connection*} [lindex $t 2]]
} -result {tls_unavailable 1 0}

# --- auth header passthrough -------------------------------------------------

test claude-auth-header-passed {the face's auth pair is sent as a request header} -body {
	set ::seen {}
	proc capture_tp {req on_chunk on_done} { set ::seen [dict get $req headers] ; {*}$on_done 200 "" }
	rio::claude::infer $::conf {{role user text hi}} {} {x-api-key SEKRET} capture_tp collect_post
	expr {[lsearch -exact $::seen x-api-key] >= 0 && [lsearch -exact $::seen SEKRET] >= 0}
} -result 1

# anthropic-beta is OPTIONAL: omitted unless config sets it (the API path sends
# none; a beta header is only added when a face asks for one).
test claude-beta-omitted {no anthropic-beta header when config doesn't set one} -body {
	set ::seen {}
	proc capture_tp {req on_chunk on_done} { set ::seen [dict get $req headers] ; {*}$on_done 200 "" }
	rio::claude::infer $::conf {{role user text hi}} {} {x-api-key K} capture_tp collect_post
	dict exists $::seen anthropic-beta
} -result 0

test claude-beta-included {anthropic-beta is sent when config sets it} -body {
	set ::seen {}
	proc capture_tp {req on_chunk on_done} { set ::seen [dict get $req headers] ; {*}$on_done 200 "" }
	set c [dict merge $::conf {anthropic_beta some-beta-2025}]
	rio::claude::infer $c {{role user text hi}} {} {x-api-key K} capture_tp collect_post
	dict get $::seen anthropic-beta
} -result some-beta-2025

# --- tool_use streaming (D26 slice 4) ----------------------------------------

# A stream where the model emits a tool_use block (id + name, with its input
# arriving as input_json_delta fragments) and ends with stop_reason "tool_use".
set ::tsse ""
append ::tsse "data: {\"type\":\"message_start\"}\n\n"
append ::tsse "data: {\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"tool_use\",\"id\":\"toolu_9\",\"name\":\"fs_list\"}}\n\n"
append ::tsse "data: {\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"path\\\":\"}}\n\n"
append ::tsse "data: {\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\"src\\\"}\"}}\n\n"
append ::tsse "data: {\"type\":\"content_block_stop\",\"index\":0}\n\n"
append ::tsse "data: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\"}}\n\n"
append ::tsse "data: {\"type\":\"message_stop\"}\n\n"

test claude-stream-tool-use {a tool_use block surfaces as a tool post with parsed + raw input} -body {
	run_infer [list $::tsse] 200
	set tool [lindex [posts_of tool] 0]
	# {id name input raw}
	list [lindex $tool 0] [lindex $tool 1] [dict get [lindex $tool 2] path] [lindex $tool 3] \
		[terminal]
} -result {toolu_9 fs_list src {{"path":"src"}} {done tool_use}}

test claude-stream-tool-then-text {a text preamble before the tool both stream, in order} -body {
	set s "data: {\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"let me look\"}}\n\n"
	append s $::tsse
	run_infer [list $s] 200
	list [deltas] [llength [posts_of tool]] [terminal]
} -result {{let me look} 1 {done tool_use}}

cleanupTests
