# Tests for the claude-api face (rio::claude::api, AGENTS.md D26): API-key auth,
# the x-api-key header (no oauth beta, no forced system prompt), key storage, and
# end-to-end streaming through the real agent loop. Network stays a seam (a fake
# SSE transport), so the whole flow runs offline.
package require tcltest
namespace import ::tcltest::*
package require json

source [file join [file dirname [info script]] .. .. .. rio-core core.tcl]
source [file join [file dirname [info script]] .. .. .. plugins lib json.tcl]
source [file join [file dirname [info script]] .. .. .. plugins lib transport.tcl]
source [file join [file dirname [info script]] .. inference.tcl]
source [file join [file dirname [info script]] .. api-face.tcl]

# Keep secrets in a throwaway dir.
set rio::secret::override_dir [file join [::tcltest::temporaryDirectory] rioapi-[clock clicks]]

proc collect_post {args} { lappend ::posts $args }
proc collect_ev {ev} {
	lappend ::evs $ev
	switch -- [dict get $ev event] { agent.message - agent.error { set ::fin done } }
}

# --- key storage + the not-configured guard ----------------------------------

test claude-api-not-configured {with no key the provider posts not_configured} -setup {
	rio::claude::api::clear_key
} -body {
	set ::posts {}
	rio::claude::api::provider {{role user text hi}} {} {} collect_post
	lindex [lindex $::posts 0] 1
} -result not_configured

test claude-api-set-clear {set_key stores the key; clear_key forgets it} -setup {
	rio::claude::api::clear_key
} -body {
	set a [rio::claude::api::configured]
	rio::claude::api::set_key sk-ant-XYZ
	set b [rio::claude::api::configured]
	rio::claude::api::clear_key
	list $a $b [rio::claude::api::configured]
} -result {0 1 0}

# --- registration with the agent's provider registry (D30) -------------------
# Loading the face self-registers it by name so a frontend can pick it over the
# channel (agent.provider.set claude), and routes the agent.key.* ops to its store.

test claude-api-registered {sourcing the face registers `claude` in the agent registry} -body {
	expr {"claude" in [rio::agent::provider_names]}
} -result 1

test claude-api-selectable {agent.provider.set claude makes this face the live provider} -setup {
	rio::agent::use_provider echo
} -body {
	rio::agent::use_provider claude
	list [rio::agent::provider_name] [expr {[set rio::agent::provider] eq "rio::claude::api::provider"}]
} -cleanup { rio::agent::use_provider echo } -result {claude 1}

test claude-api-key-ops-route {agent.key.set/clear/status reach this face's 0600 store} -setup {
	rio::claude::api::clear_key
} -body {
	# Target the claude provider by name (the key ops address a provider by name;
	# the GUI always names it). Independent of which provider is currently active.
	set a [rio::agent::key_status claude]
	rio::agent::key_set sk-ant-route claude
	set b [rio::agent::key_status claude]
	set stored [rio::claude::api::configured]
	rio::agent::key_clear claude
	list $a $b $stored [rio::agent::key_status claude]
} -result {0 1 1 0}

# --- the request: x-api-key, and none of the OAuth baggage -------------------

test claude-api-request {the request carries x-api-key and no oauth beta / no forced system} -setup {
	rio::claude::api::set_key sk-ant-XYZ
	set ::seen ""
	proc capture_tp {req on_chunk on_done} { set ::seen $req ; {*}$on_done 200 "" }
	set ::rio::claude::api::transport capture_tp
} -body {
	rio::claude::api::provider {{role user text hi}} {} {} collect_post
	set hdrs [dict get $::seen headers]
	set body [json::json2dict [dict get $::seen body]]
	list [dict get $hdrs x-api-key] \
		[dict exists $hdrs anthropic-beta] \
		[dict exists $body system]
} -cleanup {
	set ::rio::claude::api::transport rio::llm::http::stream
	rio::claude::api::clear_key
} -result {sk-ant-XYZ 0 0}

# --- end to end: a configured provider streams through the real agent loop ----

set ::api_sse ""
append ::api_sse "data: {\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"Hi there\"}}\n\n"
append ::api_sse "data: {\"type\":\"message_stop\"}\n\n"

proc fake_sse {sse status req on_chunk on_done} { {*}$on_chunk $sse ; {*}$on_done $status "" }

test claude-api-provider-streams {a configured provider streams a Claude reply via agent.send} -setup {
	rio::claude::api::set_key sk-ant-XYZ
	set ::rio::claude::api::transport [list fake_sse $::api_sse 200]
	rio::agent::set_provider rio::claude::api::provider
	rio::core::call agent.reset {}
} -body {
	set ::evs {} ; set ::fin {}
	rio::core::call_stream agent.send {text {say hi}} collect_ev
	set t [after 3000 {set ::fin timeout}] ; vwait ::fin ; after cancel $t
	set reply ""
	foreach ev $::evs { if {[dict get $ev event] eq "agent.message"} { set reply [dict get $ev params text] } }
	list $::fin $reply
} -cleanup {
	rio::agent::set_provider ::rio::agent::echo_provider
	set ::rio::claude::api::transport rio::llm::http::stream
	rio::claude::api::clear_key
} -result {done {Hi there}}

# --- the options: model and effort (D106) ------------------------------------
#
# The face declares them, the core only routes. Settings go to a throwaway dir so a
# test never writes into the real ~/.config.

set ::optdir [file join [::tcltest::temporaryDirectory] rioopt-[clock clicks]]
rio::agent::settings::override_dir $::optdir

proc reset_claude_opts {} {
	file delete -force $::optdir
	rio::claude::api::configure model claude-sonnet-5
	rio::claude::api::configure effort default
	set ::rio::claude::api::models {
		{value claude-opus-5 label "Opus 5"} {value claude-sonnet-5 label "Sonnet 5"}
	}
}
# The refresh's callback is the core's own announcer, so what a test sees is the
# `agent.options` EVENT — with the provider's message (if any) in its `error` field.
proc announce {ev} { set ::announced $ev }
proc announced_error {} {
	if {$::announced eq ""} { return "(nothing announced)" }
	return [dict get $::announced params error]
}

test claude-options-declared {the face declares model (free, refreshable) and effort (closed)} -setup {
	reset_claude_opts
} -body {
	set os [rio::agent::options claude]
	set m [lindex $os 0] ; set e [lindex $os 1]
	list [llength $os] [dict get $m name] [dict get $m free] [dict get $m refresh] \
		[dict get $e name] [dict get $e free] [dict get $e refresh]
} -result {2 model 1 1 effort 0 0}

test claude-options-value {each option reports the live config value} -setup {
	reset_claude_opts
} -body {
	rio::claude::api::configure model claude-opus-5
	rio::agent::options_summary claude
} -result {model claude-opus-5 effort default}

test claude-option-set-model {choosing a model applies it and remembers it} -setup {
	reset_claude_opts
} -body {
	rio::agent::option_set model claude-opus-5 claude
	list [rio::claude::api::cget model] [rio::agent::settings::get claude model]
} -result {claude-opus-5 claude-opus-5}

test claude-option-set-model-free {a model id this build never heard of is accepted} -setup {
	reset_claude_opts
} -body {
	rio::agent::option_set model claude-something-7 claude
	rio::claude::api::cget model
} -result {claude-something-7}

test claude-option-set-model-empty {an empty model is refused} -setup {
	reset_claude_opts
} -body {
	catch {rio::agent::option_set model "  " claude} e
	list $e [rio::claude::api::cget model]
} -match glob -result {{*must not be empty*} claude-sonnet-5}

test claude-option-set-effort-unknown {an effort outside the declared set is refused} -setup {
	reset_claude_opts
} -body {
	catch {rio::agent::option_set effort ludicrous claude} e
	list $e [rio::claude::api::cget effort]
} -match glob -result {{*must be one of*} default}

test claude-adopts-stored {a choice in the provider's conf file is adopted at load} -setup {
	reset_claude_opts
} -body {
	rio::agent::settings::store claude model claude-from-the-file
	rio::claude::api::_adopt_settings
	rio::claude::api::cget model
} -cleanup { reset_claude_opts } -result {claude-from-the-file}

# --- effort on the wire ------------------------------------------------------

proc claude_body {} {
	set ::seen ""
	proc capture_tp {req on_chunk on_done} { set ::seen $req ; {*}$on_done 200 "" }
	set ::rio::claude::api::transport capture_tp
	rio::claude::api::provider {{role user text hi}} {} {} collect_post
	set ::rio::claude::api::transport rio::llm::http::stream
	return [dict get $::seen body]
}

test claude-effort-default-sends-nothing {the default request is the one rio always sent} -setup {
	reset_claude_opts
	rio::claude::api::set_key sk-ant-XYZ
} -body {
	dict exists [json::json2dict [claude_body]] output_config
} -cleanup { rio::claude::api::clear_key } -result 0

test claude-effort-reaches-the-request {a chosen effort is spelled into the body} -setup {
	reset_claude_opts
	rio::claude::api::set_key sk-ant-XYZ
} -body {
	rio::agent::option_set effort high claude
	dict get [json::json2dict [claude_body]] output_config effort
} -cleanup { reset_claude_opts ; rio::claude::api::clear_key } -result {high}

test claude-model-reaches-the-request {the chosen model is the model asked for} -setup {
	reset_claude_opts
	rio::claude::api::set_key sk-ant-XYZ
} -body {
	rio::agent::option_set model claude-opus-5 claude
	dict get [json::json2dict [claude_body]] model
} -cleanup { reset_claude_opts ; rio::claude::api::clear_key } -result {claude-opus-5}

# --- refreshing the model list ----------------------------------------------

test claude-refresh-replaces-choices {a models listing becomes the picker's choices} -setup {
	reset_claude_opts
	rio::claude::api::set_key sk-ant-XYZ
	set ::announced {}
	set body {{"data":[{"id":"claude-a","display_name":"Claude A"},{"id":"claude-b"}]}}
	set ::rio::claude::api::fetcher [list apply {{body req done} {{*}$done 200 "" $body}} $body]
} -body {
	rio::agent::options_refresh model announce claude
	set cs [dict get [lindex [rio::agent::options claude] 0] choices]
	list [announced_error] $cs
} -cleanup {
	set ::rio::claude::api::fetcher rio::llm::http::get
	rio::claude::api::clear_key ; reset_claude_opts
} -result {{} {{value claude-a label {Claude A}} {value claude-b label claude-b}}}

test claude-refresh-sends-the-key {the listing request carries this face's auth} -setup {
	reset_claude_opts
	rio::claude::api::set_key sk-ant-LIST
	set ::rio::claude::api::fetcher [list apply {{req done} {set ::seen $req ; {*}$done 200 "" {{"data":[]}}}}]
} -body {
	rio::agent::options_refresh model announce claude
	list [dict get $::seen url] [dict get [dict get $::seen headers] x-api-key]
} -cleanup {
	set ::rio::claude::api::fetcher rio::llm::http::get
	rio::claude::api::clear_key
} -result {https://api.anthropic.com/v1/models sk-ant-LIST}

test claude-refresh-no-key {with no key the refresh says so instead of calling out} -setup {
	reset_claude_opts
	rio::claude::api::clear_key
	set ::announced {}
} -body {
	rio::agent::options_refresh model announce claude
	announced_error
} -match glob -result {*No Claude API key*}

test claude-refresh-network-failure {a failed fetch keeps the old choices and says why} -setup {
	reset_claude_opts
	rio::claude::api::set_key sk-ant-XYZ
	set ::announced {}
	set ::rio::claude::api::fetcher [list apply {{req done} {{*}$done 0 "connection refused" ""}}]
} -body {
	rio::agent::options_refresh model announce claude
	list [announced_error] [llength [dict get [lindex [rio::agent::options claude] 0] choices]]
} -cleanup {
	set ::rio::claude::api::fetcher rio::llm::http::get
	rio::claude::api::clear_key
} -match glob -result {{*connection refused*} 2}

test claude-refresh-garbage {an unreadable listing keeps the old choices} -setup {
	reset_claude_opts
	rio::claude::api::set_key sk-ant-XYZ
	set ::announced {}
	set ::rio::claude::api::fetcher [list apply {{req done} {{*}$done 200 "" "<html>nope</html>"}}]
} -body {
	rio::agent::options_refresh model announce claude
	list [announced_error] [llength [dict get [lindex [rio::agent::options claude] 0] choices]]
} -cleanup {
	set ::rio::claude::api::fetcher rio::llm::http::get
	rio::claude::api::clear_key
} -match glob -result {{*Couldn't read the model list*} 2}

file delete -force $rio::secret::override_dir $::optdir
cleanupTests
