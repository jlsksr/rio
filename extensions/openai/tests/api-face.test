# Tests for the OpenAI-compatible face (rio::openai::api, AGENTS.md D8/D26): Bearer
# auth, config-as-data (endpoint/model/token param), key storage, registration with
# the agent registry (with label + signup), and end-to-end streaming through the
# real agent loop. Network stays a seam (a fake SSE transport), so it runs offline.
package require tcltest
namespace import ::tcltest::*
package require json

source [file join [file dirname [info script]] .. .. .. rio-core core.tcl]
source [file join [file dirname [info script]] .. .. .. plugins lib json.tcl]
source [file join [file dirname [info script]] .. .. .. plugins lib transport.tcl]
source [file join [file dirname [info script]] .. inference.tcl]
source [file join [file dirname [info script]] .. api-face.tcl]

# Keep secrets in a throwaway dir.
set rio::secret::override_dir [file join [::tcltest::temporaryDirectory] rioopenai-[clock clicks]]

proc collect_post {args} { lappend ::posts $args }
proc collect_ev {ev} {
	lappend ::evs $ev
	switch -- [dict get $ev event] { agent.message - agent.error { set ::fin done } }
}

# --- key storage + the not-configured guard ----------------------------------

test openai-api-not-configured {with no key the provider posts not_configured} -setup {
	rio::openai::api::clear_key
} -body {
	set ::posts {}
	rio::openai::api::provider {{role user text hi}} {} {} collect_post
	lindex [lindex $::posts 0] 1
} -result not_configured

test openai-api-set-clear {set_key stores the key; clear_key forgets it} -setup {
	rio::openai::api::clear_key
} -body {
	set a [rio::openai::api::configured]
	rio::openai::api::set_key sk-oai-XYZ
	set b [rio::openai::api::configured]
	rio::openai::api::clear_key
	list $a $b [rio::openai::api::configured]
} -result {0 1 0}

# --- registration with the agent's provider registry (D30) -------------------

test openai-api-registered {sourcing the face registers `openai` with label + signup} -body {
	set ps {}
	foreach p [rio::agent::providers_info] { dict set ps [dict get $p name] $p }
	set o [dict get $ps openai]
	list [dict get $o name] [dict get $o label] [dict get $o keyed] [dict get $o signup]
} -result {openai ChatGPT 1 platform.openai.com/api-keys}

test openai-api-selectable {agent.provider.set openai makes this face the live provider} -setup {
	rio::agent::use_provider echo
} -body {
	rio::agent::use_provider openai
	list [rio::agent::provider_name] [expr {[set rio::agent::provider] eq "rio::openai::api::provider"}]
} -cleanup { rio::agent::use_provider echo } -result {openai 1}

test openai-api-key-ops-route {agent.key.set/clear/status reach this face's 0600 store, by name} -setup {
	rio::openai::api::clear_key
} -body {
	set a [rio::agent::key_status openai]
	rio::agent::key_set sk-oai-route openai
	set b [rio::agent::key_status openai]
	set stored [rio::openai::api::configured]
	rio::agent::key_clear openai
	list $a $b $stored [rio::agent::key_status openai]
} -result {0 1 1 0}

# --- the request: Authorization: Bearer, endpoint from config -----------------

test openai-api-request {the request carries the Bearer header and hits the configured endpoint} -setup {
	rio::openai::api::set_key sk-oai-XYZ
	set ::seen ""
	proc capture_tp {req on_chunk on_done} { set ::seen $req ; {*}$on_done 200 "" }
	set ::rio::openai::api::transport capture_tp
} -body {
	rio::openai::api::provider {{role user text hi}} {} {} collect_post
	set hdrs [dict get $::seen headers]
	list [dict get $hdrs Authorization] [dict get $::seen url]
} -cleanup {
	set ::rio::openai::api::transport rio::llm::http::stream
	rio::openai::api::clear_key
} -result {{Bearer sk-oai-XYZ} https://api.openai.com/v1/chat/completions}

test openai-api-endpoint-configurable {configure points the face at a local server} -setup {
	rio::openai::api::set_key placeholder
	set ::seen ""
	proc capture_tp {req on_chunk on_done} { set ::seen $req ; {*}$on_done 200 "" }
	set ::rio::openai::api::transport capture_tp
	set ::saved_url [rio::openai::api::cget messages_url]
	rio::openai::api::configure messages_url http://localhost:11434/v1/chat/completions
} -body {
	rio::openai::api::provider {{role user text hi}} {} {} collect_post
	dict get $::seen url
} -cleanup {
	rio::openai::api::configure messages_url $::saved_url
	set ::rio::openai::api::transport rio::llm::http::stream
	rio::openai::api::clear_key
} -result http://localhost:11434/v1/chat/completions

# --- end to end: a configured provider streams through the real agent loop ----

set ::api_sse ""
append ::api_sse "data: {\"choices\":\[{\"delta\":{\"content\":\"Hi there\"},\"finish_reason\":null}\]}\n\n"
append ::api_sse "data: {\"choices\":\[{\"delta\":{},\"finish_reason\":\"stop\"}\]}\n\n"
append ::api_sse "data: \[DONE\]\n\n"

proc fake_sse {sse status req on_chunk on_done} { {*}$on_chunk $sse ; {*}$on_done $status "" }

test openai-api-provider-streams {a configured provider streams a reply via agent.send} -setup {
	rio::openai::api::set_key sk-oai-XYZ
	set ::rio::openai::api::transport [list fake_sse $::api_sse 200]
	rio::agent::set_provider rio::openai::api::provider
	rio::core::call agent.reset {}
} -body {
	set ::evs {} ; set ::fin {}
	rio::core::call_stream agent.send {text {say hi}} collect_ev
	set t [after 3000 {set ::fin timeout}] ; vwait ::fin ; after cancel $t
	set reply ""
	foreach ev $::evs { if {[dict get $ev event] eq "agent.message"} { set reply [dict get $ev params text] } }
	list $::fin $reply
} -cleanup {
	rio::agent::set_provider ::rio::agent::echo_provider
	set ::rio::openai::api::transport rio::llm::http::stream
	rio::openai::api::clear_key
} -result {done {Hi there}}

# --- the options: model and effort (D106) ------------------------------------

set ::optdir [file join [::tcltest::temporaryDirectory] rioopt-[clock clicks]]
rio::agent::settings::override_dir $::optdir

proc reset_openai_opts {} {
	file delete -force $::optdir
	rio::openai::api::configure model gpt-4o
	rio::openai::api::configure effort default
	rio::openai::api::configure messages_url https://api.openai.com/v1/chat/completions
	rio::openai::api::configure models_url ""
	set ::rio::openai::api::models {{value gpt-4o label "GPT-4o"} {value gpt-4o-mini label "GPT-4o mini"}}
}
# The refresh callback is the core's announcer, so a test sees the agent.options EVENT.
proc announce {ev} { set ::announced $ev }
proc announced_error {} {
	if {$::announced eq ""} { return "(nothing announced)" }
	return [dict get $::announced params error]
}

test openai-options-declared {the face declares model (free, refreshable) and effort (closed)} -setup {
	reset_openai_opts
} -body {
	set os [rio::agent::options openai]
	list [llength $os] [dict get [lindex $os 0] name] [dict get [lindex $os 0] free] \
		[dict get [lindex $os 1] name] [dict get [lindex $os 1] free]
} -result {2 model 1 effort 0}

test openai-option-set-model {choosing a model applies it and remembers it} -setup {
	reset_openai_opts
} -body {
	rio::agent::option_set model llama3.2:3b openai
	list [rio::openai::api::cget model] [rio::agent::settings::get openai model]
} -cleanup { reset_openai_opts } -result {llama3.2:3b llama3.2:3b}

test openai-option-set-effort-unknown {an effort outside the declared set is refused} -setup {
	reset_openai_opts
} -body {
	catch {rio::agent::option_set effort ludicrous openai} e
	list $e [rio::openai::api::cget effort]
} -match glob -result {{*must be one of*} default}

test openai-adopts-stored {a choice in the provider's conf file is adopted at load} -setup {
	reset_openai_opts
} -body {
	rio::agent::settings::store openai model from-the-file
	rio::openai::api::_adopt_settings
	rio::openai::api::cget model
} -cleanup { reset_openai_opts } -result {from-the-file}

# --- effort on the wire ------------------------------------------------------

proc openai_body {{tools {}} {system ""}} {
	set ::seen ""
	proc capture_tp {req on_chunk on_done} { set ::seen $req ; {*}$on_done 200 "" }
	set ::rio::openai::api::transport capture_tp
	rio::openai::api::provider {{role user text hi}} $tools $system collect_post
	set ::rio::openai::api::transport rio::llm::http::stream
	return [dict get $::seen body]
}

# A tool spec shaped like the core's, with a non-ASCII character INSIDE its schema —
# where jstr never reaches, because the schema is already JSON and is spliced whole.
# rio's own present_plan carries exactly this (an em-dash in a description).
proc tool_with_dash {} {
	return [list [dict create name present_plan description "Present your plan" \
		input_schema {{"type":"object","properties":{"title":{"type":"string","description":"A short name — one line."}}}}]]
}

test openai-body-with-tools-is-ascii {a tool schema's non-ASCII never reaches the HTTP layer raw} -setup {
	reset_openai_opts
	rio::openai::api::set_key sk-XYZ
} -body {
	# The live failure this test exists for (2026-09-12): every turn against
	# api.openai.com returned HTTP 400 "We could not parse the JSON body of your
	# request". Tcl's http counts Content-Length in characters and writes the body to
	# a binary channel, so the em-dash in present_plan's schema went out as the byte
	# 0x14 — a raw control character inside a JSON string. Both lengths must agree.
	set b [openai_body [tool_with_dash]]
	list [string is ascii $b] \
		[expr {[string length $b] == [string length [encoding convertto utf-8 $b]]}] \
		[expr {[catch {json::json2dict $b}] ? "unparseable" : "parses"}]
} -cleanup { rio::openai::api::clear_key } -result {1 1 parses}

test openai-body-with-tools-keeps-its-meaning {escaping the body does not change what it says} -setup {
	reset_openai_opts
	rio::openai::api::set_key sk-XYZ
} -body {
	set d [json::json2dict [openai_body [tool_with_dash]]]
	set f [dict get [lindex [dict get $d tools] 0] function]
	dict get [dict get [dict get [dict get $f parameters] properties] title] description
} -cleanup { rio::openai::api::clear_key } -result {A short name — one line.}

test openai-body-system-non-ascii {a system message's non-ASCII survives as itself} -setup {
	reset_openai_opts
	rio::openai::api::set_key sk-XYZ
} -body {
	set d [json::json2dict [openai_body {} "rio — the editor"]]
	dict get [lindex [dict get $d messages] 0] content
} -cleanup { rio::openai::api::clear_key } -result {rio — the editor}

test openai-effort-default-sends-nothing {the default request is the one rio always sent} -setup {
	reset_openai_opts
	rio::openai::api::set_key sk-XYZ
} -body {
	# gpt-4o and most local servers REJECT reasoning_effort — the shipped request
	# must stay byte-identical until the user asks for effort.
	dict exists [json::json2dict [openai_body]] reasoning_effort
} -cleanup { rio::openai::api::clear_key } -result 0

test openai-effort-reaches-the-request {a chosen effort is spelled into the body} -setup {
	reset_openai_opts
	rio::openai::api::set_key sk-XYZ
} -body {
	rio::agent::option_set effort low openai
	dict get [json::json2dict [openai_body]] reasoning_effort
} -cleanup { reset_openai_opts ; rio::openai::api::clear_key } -result {low}

test openai-model-reaches-the-request {the chosen model is the model asked for} -setup {
	reset_openai_opts
	rio::openai::api::set_key sk-XYZ
} -body {
	rio::agent::option_set model o4-mini openai
	dict get [json::json2dict [openai_body]] model
} -cleanup { reset_openai_opts ; rio::openai::api::clear_key } -result {o4-mini}

# --- refreshing the model list ----------------------------------------------

test openai-models-url-derived {the listing URL follows the configured endpoint} -setup {
	reset_openai_opts
} -body {
	set hosted [rio::openai::api::_models_url]
	rio::openai::api::configure messages_url http://localhost:11434/v1/chat/completions
	set local [rio::openai::api::_models_url]
	rio::openai::api::configure models_url http://elsewhere/models
	list $hosted $local [rio::openai::api::_models_url]
} -cleanup { reset_openai_opts } -result {https://api.openai.com/v1/models http://localhost:11434/v1/models http://elsewhere/models}

test openai-refresh-replaces-choices {a server's listing becomes the picker's choices} -setup {
	reset_openai_opts
	rio::openai::api::set_key sk-XYZ
	set ::announced {}
	set body {{"data":[{"id":"qwen2.5-coder"},{"id":"llama3.2"}]}}
	set ::rio::openai::api::fetcher [list apply {{body req done} {{*}$done 200 "" $body}} $body]
} -body {
	rio::agent::options_refresh model announce openai
	list [announced_error] [dict get [lindex [rio::agent::options openai] 0] choices]
} -cleanup {
	set ::rio::openai::api::fetcher rio::llm::http::get
	rio::openai::api::clear_key ; reset_openai_opts
} -result {{} {{value llama3.2 label llama3.2} {value qwen2.5-coder label qwen2.5-coder}}}

test openai-refresh-keyless {a local server is asked without an Authorization header} -setup {
	reset_openai_opts
	rio::openai::api::clear_key
	set ::rio::openai::api::fetcher [list apply {{req done} {set ::seen $req ; {*}$done 200 "" {{"data":[]}}}}]
} -body {
	rio::agent::options_refresh model announce openai
	dict get $::seen headers
} -cleanup { set ::rio::openai::api::fetcher rio::llm::http::get } -result {}

test openai-refresh-network-failure {a failed fetch keeps the old choices and says why} -setup {
	reset_openai_opts
	set ::announced {}
	set ::rio::openai::api::fetcher [list apply {{req done} {{*}$done 0 "connection refused" ""}}]
} -body {
	rio::agent::options_refresh model announce openai
	list [announced_error] [llength [dict get [lindex [rio::agent::options openai] 0] choices]]
} -cleanup { set ::rio::openai::api::fetcher rio::llm::http::get } -match glob -result {{*connection refused*} 2}

file delete -force $rio::secret::override_dir $::optdir
cleanupTests
