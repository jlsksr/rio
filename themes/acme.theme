# Plan 9 Acme — a rio theme (AGENTS.md D24).
# Data only: PARSED, never executed. Rob Pike's acme palette: a pale-yellow body,
# pale-blue tag/chrome bars, the olive border, and acme's muted-yellow selection.
# Colours only — fonts inherit the default (acme's Lucida isn't portable).

[colors]
# The body window: acme's #FFFFEA paper-yellow, black ink, the #EEEE9E selection.
editor.bg        = #ffffea
editor.fg        = #000000
editor.cursor    = #000000
editor.selection = #eeee9e
editor.findmatch = #e6e67a

# Chrome (status, dock, panes) is the tag surface: acme's pale blue, black text.
ui.bg            = #eaffff
ui.fg            = #000000

# Tabs as tags: the focused one bright blue, the rest muted, on the olive bar.
tab.bar.bg       = #99994c
tab.active.bg    = #eaffff
tab.inactive.bg  = #cce8e8
tab.fg           = #000000

gutter.fg        = #99994c

# The chat pane is just another body window — same paper-yellow.
chat.bg          = #ffffea
chat.fg          = #000000

# Acme's dark navy, for executable/plumbed text — here the accent on labels.
accent           = #00007f

# Syntax highlighting (D32): acme doesn't traditionally highlight, so keep it
# restrained — the navy/olive/maroon of acme's own chrome on the paper-yellow body.
syntax.comment   = #6a6a3a
syntax.string    = #005500
syntax.number    = #7f3f00
syntax.keyword   = #00007f
syntax.tag       = #00007f
syntax.attribute = #5c3f00
syntax.entity    = #7f0000
syntax.meta      = #6a6a3a
syntax.operator  = #00007f
syntax.function  = #00007f
syntax.variable  = #5c3f00
syntax.type      = #00007f
syntax.constant  = #7f3f00
