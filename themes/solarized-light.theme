# Solarized Light — example rio theme (AGENTS.md D24).
# Data only: PARSED, never executed. The Solarized light palette.

[colors]
editor.bg        = #fdf6e3
editor.fg        = #657b83
editor.cursor    = #586e75
editor.selection = #eee8d5
editor.findmatch = #f2de9c
ui.bg            = #eee8d5
ui.fg            = #586e75
tab.bar.bg       = #d8d2c0
tab.active.bg    = #fdf6e3
tab.inactive.bg  = #eee8d5
tab.fg           = #586e75
gutter.fg        = #93a1a1
chat.bg          = #fdf6e3
chat.fg          = #657b83
accent           = #268bd2

# Error text and diff/compare bands: Solarized's red and green over pale tints of
# the cream base, so the pair harmonises with the dark theme's Solarized accents.
error            = #dc322f
diff.added       = #859900
diff.removed     = #dc322f
diff.added.bg    = #e6ecd0
diff.removed.bg  = #f6ddd4

# Syntax highlighting (D32): the same Solarized accents on the light base tone.
syntax.comment   = #93a1a1
syntax.string    = #2aa198
syntax.number    = #d33682
syntax.keyword   = #859900
syntax.tag       = #268bd2
syntax.attribute = #657b83
syntax.entity    = #cb4b16
syntax.meta      = #6c71c4
syntax.operator  = #859900
syntax.function  = #268bd2
syntax.variable  = #b58900
syntax.type      = #b58900
syntax.constant  = #d33682
