# Tests for the C++ highlighter (AGENTS.md D32). Pure Tcl — the module is Tk-free, so
# this runs under a bare tclsh with no display.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

set here [file dirname [info script]]
source [file join $here .. registry.tcl]
source [file join $here .. cpp.tcl]

proc hl {text} { rio::syntax::tokenize rio::syntax::cpp::scan $text }
proc has {spans i0 i1 type} {
	foreach {a b t} $spans { if {$a eq $i0 && $b eq $i1 && $t eq $type} { return 1 } }
	return 0
}

# --- registry wiring -----------------------------------------------------------

test for_path-cpp {.cpp/.hpp resolve to the cpp scanner} -body {
	list [rio::syntax::for_path a.cpp] [rio::syntax::for_path a.hpp]
} -result {rio::syntax::cpp::scan rio::syntax::cpp::scan}

test lang_for_path-cpp {.cpp resolves to the C++ language name} -body {
	rio::syntax::lang_for_path /x/main.cpp
} -result {C++}

# --- preprocessor --------------------------------------------------------------

test include {#include is meta and the <header> is a string} -body {
	set s [hl {#include <vector>}]
	list [has $s 1.0 1.8 meta] [has $s 1.9 1.17 string]
} -result {1 1}

# --- keywords, types, constants, functions -------------------------------------

test class-tag {class is a keyword; the tag name is a type} -body {
	set s [hl {class Widget {};}]
	list [has $s 1.0 1.5 keyword] [has $s 1.6 1.12 type]
} -result {1 1}

test cpp-keywords {C++-specific keywords and nullptr} -body {
	set s [hl {auto p = nullptr; namespace ns {}}]
	list [has $s 1.0 1.4 keyword] [has $s 1.9 1.16 constant] [has $s 1.18 1.27 keyword]
} -result {1 1 1}

test types-and-func {a built-in type and a called name} -body {
	set s [hl {int main() { return 0; }}]
	list [has $s 1.0 1.3 type] [has $s 1.4 1.8 function]
} -result {1 1}

# --- strings, raw strings, numbers ---------------------------------------------

test string-and-char {"…" strings and 'c' char literals} -body {
	set s [hl {char c = 'a'; auto s = "hi";}]
	list [has $s 1.9 1.12 string] [has $s 1.23 1.27 string]
} -result {1 1}

test raw-string-multiline {a raw string R"d(…)d" carries across lines} -body {
	set s [hl "auto s = R\"x(one\ntwo)x\";"]
	list [has $s 1.9 1.16 string] [has $s 2.0 2.6 string]
} -result {1 1}

test numbers-separators {hex, ' digit separators, and suffixes} -body {
	set s [hl {a = 0xFF; b = 1'000UL; c = 3.14f;}]
	list [has $s 1.4 1.8 number] [has $s 1.14 1.21 number] [has $s 1.27 1.32 number]
} -result {1 1 1}

# --- comments ------------------------------------------------------------------

test line-comment {a // comment runs to end of line} -body {
	set s [hl {x = 1; // note}]
	has $s 1.7 1.14 comment
} -result 1

test block-comment-multiline {a /* */ comment carries across lines} -body {
	set s [hl "a; /* one\ntwo */ b;"]
	list [has $s 1.3 1.9 comment] [has $s 2.0 2.6 comment]
} -result {1 1}

test empty {empty input yields no spans} -body {
	hl ""
} -result {}

cleanupTests
