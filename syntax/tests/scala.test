# Tests for the Scala highlighter (AGENTS.md D32). Pure Tcl — the module is Tk-free, so
# this runs under a bare tclsh with no display.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

set here [file dirname [info script]]
source [file join $here .. registry.tcl]
source [file join $here .. scala.tcl]

proc hl {text} { rio::syntax::tokenize rio::syntax::scala::scan $text }
proc has {spans i0 i1 type} {
	foreach {a b t} $spans { if {$a eq $i0 && $b eq $i1 && $t eq $type} { return 1 } }
	return 0
}

# --- registry wiring -----------------------------------------------------------

test for_path-scala {.scala resolves to the scala scanner} -body {
	rio::syntax::for_path App.scala
} -result rio::syntax::scala::scan

test lang_for_path-scala {.scala resolves to the Scala language name} -body {
	rio::syntax::lang_for_path /s/Main.scala
} -result Scala

# --- keywords, types, constants ------------------------------------------------

test def-and-name {def is a keyword and the method name a function} -body {
	set s [hl {def add()}]
	list [has $s 1.0 1.3 keyword] [has $s 1.4 1.7 function]
} -result {1 1}

test val-and-type {val is a keyword; a Capitalised type name is a type} -body {
	set s [hl {val x: Int}]
	list [has $s 1.0 1.3 keyword] [has $s 1.7 1.10 type]
} -result {1 1}

test object-and-name {object is a keyword and the name a type} -body {
	set s [hl {object Main}]
	list [has $s 1.0 1.6 keyword] [has $s 1.7 1.11 type]
} -result {1 1}

test constant-null {null is a constant} -body {
	has [hl {val x = null}] 1.8 1.12 constant
} -result 1

# --- annotations, numbers, calls -----------------------------------------------

test annotation {a @tailrec annotation is meta} -body {
	has [hl {@tailrec}] 1.0 1.8 meta
} -result 1

test number {a numeric literal is a number} -body {
	has [hl {x = 42}] 1.4 1.6 number
} -result 1

test call {a name directly before "(" is a function} -body {
	has [hl {foo(x)}] 1.0 1.3 function
} -result 1

# --- strings and chars ---------------------------------------------------------

test string {a "…" string is a string} -body {
	has [hl {val s = "hi"}] 1.8 1.12 string
} -result 1

test interpolator {an s"…" interpolator colours the quoted part; the prefix stays plain} -body {
	set s [hl {s"hi"}]
	list [has $s 1.1 1.5 string] [has $s 1.0 1.1 string]
} -result {1 0}

test char-literal {a 'c' char literal is a string} -body {
	has [hl {'a'}] 1.0 1.3 string
} -result 1

test char-escape {an escaped '\n' char literal is a string} -body {
	has [hl {'\n'}] 1.0 1.4 string
} -result 1

test multiline-string {a """…""" string carries across lines} -body {
	set s [hl "\"\"\"\ntext\n\"\"\""]
	list [has $s 1.0 1.3 string] [has $s 2.0 2.4 string] [has $s 3.0 3.3 string]
} -result {1 1 1}

# --- comments (with nesting) ---------------------------------------------------

test line-comment {a // comment runs to end of line} -body {
	has [hl {// hi}] 1.0 1.5 comment
} -result 1

test nested-block-comment {a nested /* /* */ */ closes only at the outer */} -body {
	has [hl {/* a /* b */ c */ x}] 1.0 1.17 comment
} -result 1

test empty {empty input yields no spans} -body {
	hl ""
} -result {}

cleanupTests
