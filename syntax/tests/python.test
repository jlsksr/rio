# Tests for the Python highlighter (AGENTS.md D32). Pure Tcl — the module is Tk-free,
# so this runs under a bare tclsh with no display.
package require tcltest
namespace import ::tcltest::*

set here [file dirname [info script]]
source [file join $here .. registry.tcl]
source [file join $here .. python.tcl]

proc hl {text} { rio::syntax::tokenize rio::syntax::python::scan $text }
proc has {spans i0 i1 type} {
	foreach {a b t} $spans { if {$a eq $i0 && $b eq $i1 && $t eq $type} { return 1 } }
	return 0
}
proc anytype {spans type} {
	foreach {a b t} $spans { if {$t eq $type} { return 1 } }
	return 0
}

# --- registry wiring -----------------------------------------------------------

test for_path-py {.py/.pyw resolve to the python scanner} -body {
	list [rio::syntax::for_path a.py] [rio::syntax::for_path a.pyw]
} -result {rio::syntax::python::scan rio::syntax::python::scan}

test lang_for_path-py {.py resolves to the Python language name} -body {
	rio::syntax::lang_for_path /x/app.py
} -result Python

# --- def/class, keywords, constants --------------------------------------------

test def-and-call {def names a function; a call is a function too} -body {
	set s [hl {def greet(name): return foo(name)}]
	list [has $s 1.0 1.3 keyword] [has $s 1.4 1.9 function] [has $s 1.17 1.23 keyword] [has $s 1.24 1.27 function]
} -result {1 1 1 1}

test class-type {class names a type} -body {
	set s [hl {class Dog(Animal): pass}]
	list [has $s 1.0 1.5 keyword] [has $s 1.6 1.9 type] [has $s 1.19 1.23 keyword]
} -result {1 1 1}

test constants {True/False/None are constants; is/and are keywords} -body {
	set s [hl {if x is None and True: pass}]
	list [has $s 1.0 1.2 keyword] [has $s 1.5 1.7 keyword] [has $s 1.8 1.12 constant] \
		[has $s 1.13 1.16 keyword] [has $s 1.17 1.21 constant]
} -result {1 1 1 1 1}

# --- strings, prefixes, triple-quoted ------------------------------------------

test strings-with-prefixes {f/r prefixed and plain strings all colour} -body {
	set s [hl {s = f"hi {x}" + r'\n' + 'a'}]
	list [has $s 1.4 1.13 string] [has $s 1.16 1.21 string] [has $s 1.24 1.27 string]
} -result {1 1 1}

test triple-multiline {a triple-quoted string carries across lines} -body {
	set s [hl "x = '''one\ntwo''' + 1"]
	list [has $s 1.4 1.10 string] [has $s 2.0 2.6 string]
} -result {1 1}

# --- comments, numbers, decorators ---------------------------------------------

test comment {a # comment runs to end of line} -body {
	set s [hl {x = 1  # a note}]
	has $s 1.7 1.15 comment
} -result 1

test numbers {hex, float, underscore int, complex} -body {
	set s [hl {n = 0xFF + 3.14 + 1_000 + 2j}]
	list [has $s 1.4 1.8 number] [has $s 1.11 1.15 number] [has $s 1.18 1.23 number] [has $s 1.26 1.28 number]
} -result {1 1 1 1}

test decorator {a @decorator at line start is a function} -body {
	set s [hl {@app.route('/x')}]
	list [has $s 1.0 1.10 function] [has $s 1.11 1.15 string]
} -result {1 1}

test matmul-not-decorator {a mid-line @ (matrix multiply) is not a decorator} -body {
	# `z = a @ b` — the @ is an operator, not a decorator; nothing gets `function`.
	anytype [hl {z = a @ b}] function
} -result 0

test empty {empty input yields no spans} -body {
	hl ""
} -result {}

cleanupTests
