# Tests for the JavaScript highlighter (AGENTS.md D32). Pure Tcl — the module is
# Tk-free, so this runs under a bare tclsh with no display.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

set here [file dirname [info script]]
source [file join $here .. registry.tcl]
source [file join $here .. js.tcl]

proc hl {text} { rio::syntax::tokenize rio::syntax::js::scan $text }
proc has {spans i0 i1 type} {
	foreach {a b t} $spans {
		if {$a eq $i0 && $b eq $i1 && $t eq $type} { return 1 }
	}
	return 0
}

# --- the registry wiring -------------------------------------------------------

test for_path-js {.js resolves to the js scanner} -body {
	rio::syntax::for_path /x/app.js
} -result rio::syntax::js::scan

test for_path-alts {mjs/cjs/jsx are JavaScript too} -body {
	list [rio::syntax::for_path a.mjs] [rio::syntax::for_path a.cjs] [rio::syntax::for_path a.JSX]
} -result {rio::syntax::js::scan rio::syntax::js::scan rio::syntax::js::scan}

test lang_for_path-js {.js resolves to the JavaScript language name} -body {
	rio::syntax::lang_for_path /x/app.js
} -result JavaScript

# --- keywords, constants, functions --------------------------------------------

test keyword {a reserved word is a keyword} -body {
	set s [hl {const x = 1}]
	has $s 1.0 1.5 keyword
} -result 1

test constant {true/false/null/undefined are constants} -body {
	set s [hl {return true}]
	list [has $s 1.0 1.6 keyword] [has $s 1.7 1.11 constant]
} -result {1 1}

test function-call {an identifier before ( is a function} -body {
	set s [hl {foo(1)}]
	has $s 1.0 1.3 function
} -result 1

test function-def {a function definition names the function too} -body {
	set s [hl {function greet() {}}]
	list [has $s 1.0 1.8 keyword] [has $s 1.9 1.14 function]
} -result {1 1}

test bare-identifier {a plain identifier is left un-coloured} -body {
	hl {let value = other}
} -result {1.0 1.3 keyword}   ;# only `let`; `value` and `other` stay plain

# --- numbers -------------------------------------------------------------------

test numbers {decimal, hex, float, exponent, bigint} -body {
	set s [hl {a = 42; b = 0xFF; c = 3.14; d = 1e9; e = 10n}]
	list [has $s 1.4 1.6 number] [has $s 1.12 1.16 number] \
		[has $s 1.22 1.26 number] [has $s 1.32 1.35 number] [has $s 1.41 1.44 number]
} -result {1 1 1 1 1}

# --- strings, templates, comments ----------------------------------------------

test strings {single and double quoted strings} -body {
	set s [hl {a = "hi"; b = 'yo'}]
	list [has $s 1.4 1.8 string] [has $s 1.14 1.18 string]
} -result {1 1}

test string-escape {an escaped quote does not end the string} -body {
	hl {"a\"b"}
} -result {1.0 1.6 string}

test line-comment {a // comment runs to end of line} -body {
	set s [hl {x = 1; // trailing}]
	has $s 1.7 1.18 comment
} -result 1

test block-comment-inline {a /* */ block comment closing on the same line} -body {
	hl {a /* c */ b}
} -result {1.2 1.9 comment}

test block-comment-multiline {a block comment carries state across lines} -body {
	set s [hl "a /* one\ntwo\nthree */ b"]
	list [has $s 1.2 1.8 comment] [has $s 2.0 2.3 comment] [has $s 3.0 3.8 comment]
} -result {1 1 1}

test template-multiline {a backtick template literal spans lines} -body {
	set s [hl "x = \`one\ntwo\`;"]
	list [has $s 1.4 1.8 string] [has $s 2.0 2.4 string]
} -result {1 1}

test div-not-comment {a lone slash (division) is not a comment} -body {
	hl {a = b / c}
} -result {}   ;# no comment span; identifiers/operator all plain

test empty {empty input yields no spans} -body {
	hl ""
} -result {}

cleanupTests
