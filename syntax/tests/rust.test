# Tests for the Rust highlighter (AGENTS.md D32). Pure Tcl — the module is Tk-free, so
# this runs under a bare tclsh with no display.

# The D54 source guard: Tcl 8.6 decodes this file with the SYSTEM encoding, and tcltest
# runs it as a script of its own, so it re-reads itself as UTF-8. See AGENTS.md D54.
if {[encoding system] ne "utf-8"} {
	encoding system utf-8
	source -encoding utf-8 [info script]
	return
}
package require tcltest
namespace import ::tcltest::*

set here [file dirname [info script]]
source [file join $here .. registry.tcl]
source [file join $here .. rust.tcl]

proc hl {text} { rio::syntax::tokenize rio::syntax::rust::scan $text }
proc has {spans i0 i1 type} {
	foreach {a b t} $spans { if {$a eq $i0 && $b eq $i1 && $t eq $type} { return 1 } }
	return 0
}
proc anytype {spans i0 i1} {
	foreach {a b t} $spans { if {$a eq $i0 && $b eq $i1} { return 1 } }
	return 0
}

# --- registry wiring -----------------------------------------------------------

test for_path-rust {.rs resolves to the rust scanner} -body {
	rio::syntax::for_path a.rs
} -result rio::syntax::rust::scan

test lang_for_path-rust {.rs resolves to the Rust language name} -body {
	rio::syntax::lang_for_path /x/main.rs
} -result Rust

# --- keywords, functions, types ------------------------------------------------

test fn-decl {fn keyword, the defined name, a primitive param type} -body {
	set s [hl {fn add(a: i32) -> i32 { 0 }}]
	list [has $s 1.0 1.2 keyword] [has $s 1.3 1.6 function] [has $s 1.10 1.13 type] [has $s 1.18 1.21 type]
} -result {1 1 1 1}

test struct-and-camelcase {struct NAME is a type, and any UpperCamelCase word is a type} -body {
	set s [hl {struct Point { x: Vec }}]
	list [has $s 1.0 1.6 keyword] [has $s 1.7 1.12 type] [has $s 1.18 1.21 type]
} -result {1 1 1}

test constants {true/false are constants} -body {
	set s [hl {let ok = true;}]
	list [has $s 1.0 1.3 keyword] [has $s 1.9 1.13 constant]
} -result {1 1}

test macro {a macro! invocation names a function} -body {
	set s [hl {println!("hi")}]
	has $s 1.0 1.7 function
} -result 1

test attribute {a #[…] attribute is meta} -body {
	set s [hl {#[derive(Debug)]}]
	has $s 1.0 1.16 meta
} -result 1

# --- strings, chars, lifetimes -------------------------------------------------

test string-multiline {a "…" string carries across lines} -body {
	set s [hl "let s = \"one\ntwo\";"]
	list [has $s 1.8 1.12 string] [has $s 2.0 2.4 string]
} -result {1 1}

test raw-string {a raw string r#"…"# is a string} -body {
	set s [hl {let s = r#"a "b" c"#;}]
	has $s 1.8 1.20 string
} -result 1

test char-vs-lifetime {a 'c' char is a string; a 'a lifetime stays plain} -body {
	set s [hl {let c = 'x'; fn f<'a>() {}}]
	list [has $s 1.8 1.11 string] [anytype $s 1.16 1.18]
} -result {1 0}

test numbers {hex, underscores, and typed suffixes} -body {
	set s [hl {let a = 0xFF; let b = 1_000u32;}]
	list [has $s 1.8 1.12 number] [has $s 1.22 1.30 number]
} -result {1 1}

# --- comments ------------------------------------------------------------------

test line-comment {a // comment runs to end of line} -body {
	set s [hl {let x = 1; // note}]
	has $s 1.11 1.18 comment
} -result 1

test block-comment-multiline {a /* */ comment carries across lines} -body {
	set s [hl "a; /* one\ntwo */ b"]
	list [has $s 1.3 1.9 comment] [has $s 2.0 2.6 comment]
} -result {1 1}

test empty {empty input yields no spans} -body {
	hl ""
} -result {}

cleanupTests
